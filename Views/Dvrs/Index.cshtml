@model List<BuildingManagementMvc.Data.Entities.DvrEntity>
@{
    ViewData["Title"] = Loc.T("DVRs");
    var building = ViewBag.Building as BuildingManagementMvc.Models.Building;
    var buildingId = ViewBag.BuildingId as string;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">
                <i class="bi bi-hdd-network"></i>
                @Loc.T("DVRs")
            </h3>
            <p class="text-muted mb-0">
                @building?.Name — @building?.BuildingNumber
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-buildingId="@buildingId"
               class="btn btn-success">
                <i class="bi bi-plus-circle"></i>
                @Loc.T("Add_DVR")
            </a>
            <a asp-controller="Cameras" asp-action="Live"
               asp-route-buildingId="@buildingId"
               class="btn btn-outline-danger">
                <i class="bi bi-camera-video"></i>
                @Loc.T("Nav_Cameras")
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            @Loc.T("No_DVRs_Yet")
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var dvr in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header @(dvr.IsActive ? "bg-success" : "bg-secondary") text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-hdd-network"></i>
                                    <strong>@dvr.Name</strong>
                                </div>
                                <span class="badge bg-light text-dark">
                                    @if (dvr.IsActive)
                                    {
                                        <i class="bi bi-circle-fill text-success"></i>
                                        <text>@Loc.T("Active")</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-circle-fill text-secondary"></i>
                                        <text>@Loc.T("Inactive")</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0 small">
                                <dt class="col-5">@Loc.T("IP_Address")</dt>
                                <dd class="col-7" dir="ltr">@dvr.IpAddress</dd>

                                <dt class="col-5">@Loc.T("Port")</dt>
                                <dd class="col-7">@dvr.Port</dd>

                                <dt class="col-5">@Loc.T("Brand")</dt>
                                <dd class="col-7">@(string.IsNullOrEmpty(dvr.Brand) ? "—" : dvr.Brand)</dd>

                                <dt class="col-5">@Loc.T("Cameras_Count")</dt>
                                <dd class="col-7">
                                    <span class="badge bg-info">@dvr.Cameras.Count</span>
                                </dd>
                            </dl>
                        </div>
                        <div class="card-footer bg-light d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@dvr.Id"
                               class="btn btn-sm btn-primary flex-fill">
                                <i class="bi bi-eye"></i> @Loc.T("Details")
                            </a>
                            <a asp-action="Edit" asp-route-id="@dvr.Id"
                               class="btn btn-sm btn-warning flex-fill">
                                <i class="bi bi-pencil"></i> @Loc.T("Edit")
                            </a>
                            <form asp-action="Delete" asp-route-id="@dvr.Id" method="post"
                                  onsubmit="return confirm('@Loc.Js("Delete_DVR_Confirm")');"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>