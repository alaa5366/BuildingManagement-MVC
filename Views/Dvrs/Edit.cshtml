@model BuildingManagementMvc.Data.Entities.DvrEntity
@{
    ViewData["Title"] = Loc.T("Edit_DVR");
    var building = ViewBag.Building as BuildingManagementMvc.Models.Building;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">
                <i class="bi bi-pencil-square"></i>
                @Loc.T("Edit_DVR")
            </h3>
            <p class="text-muted mb-0">
                @Model.Name — @building?.Name
            </p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right"></i> @Loc.T("Common_Back")
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                @* ===== البيانات الأساسية ===== *@
                <h5 class="mb-3">
                    <i class="bi bi-info-circle text-primary"></i>
                    @Loc.T("Basic_Info")
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">
                            @Loc.T("DVR_Name") <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="name" class="form-control"
                               required maxlength="100"
                               value="@Model.Name" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            @Loc.T("Brand") <span class="text-danger">*</span>
                        </label>
                        <select name="brand" class="form-select" required>
                            <option value="">@Loc.T("Choose")</option>
                            <option value="Hikvision" selected="@(Model.Brand == "Hikvision")">Hikvision</option>
                            <option value="Dahua" selected="@(Model.Brand == "Dahua")">Dahua</option>
                            <option value="ONVIF" selected="@(Model.Brand == "ONVIF")">ONVIF</option>
                            <option value="Other" selected="@(Model.Brand == "Other")">@Loc.T("Other")</option>
                        </select>
                    </div>
                </div>

                @* ===== الاتصال ===== *@
                <h5 class="mb-3 mt-4">
                    <i class="bi bi-wifi text-success"></i>
                    @Loc.T("Connection_Data")
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label class="form-label">
                            @Loc.T("IP_Address") <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="ip" class="form-control"
                               required dir="ltr"
                               value="@Model.IpAddress"
                               pattern="^(\d{1,3}\.){3}\d{1,3}$" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            @Loc.T("Port") <span class="text-danger">*</span>
                        </label>
                        <input type="number" name="port" class="form-control"
                               required value="@Model.Port"
                               min="1" max="65535" />
                    </div>
                </div>

                @* ===== التسجيل ===== *@
                <h5 class="mb-3 mt-4">
                    <i class="bi bi-shield-lock text-warning"></i>
                    @Loc.T("Login_Data")
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">@Loc.T("Username")</label>
                        <input type="text" name="username" class="form-control"
                               dir="ltr" autocomplete="off"
                               value="@Model.Username" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            @Loc.T("Password_New_Optional")
                        </label>
                        <div class="input-group">
                            <input type="password" name="newPassword" id="passwordInput"
                                   class="form-control" dir="ltr"
                                   autocomplete="new-password"
                                   placeholder="••••••••" />
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="togglePassword('passwordInput')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="form-text">
                            <i class="bi bi-shield-check text-success"></i>
                            @Loc.T("Password_Keep_Note")
                        </div>
                    </div>
                </div>

                @* ===== الحالة ===== *@
                <h5 class="mb-3 mt-4">
                    <i class="bi bi-toggle-on text-info"></i>
                    @Loc.T("Status")
                </h5>

                <div class="form-check form-switch mb-4">
                    <input type="checkbox" name="isActive" value="true"
                           class="form-check-input" id="isActive"
                    @(Model.IsActive ? "checked" : "") />
                    <label class="form-check-label" for="isActive">
                        <strong>@Loc.T("DVR_Is_Active")</strong>
                        <div class="form-text">
                            @Loc.T("DVR_Active_Warning")
                        </div>
                    </label>
                </div>

                @* ===== الأزرار ===== *@
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-check-circle"></i> @Loc.T("Save_Changes")
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id"
                       class="btn btn-secondary btn-lg">@Loc.T("Common_Cancel")</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            const btn = event.currentTarget;
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = '<i class="bi bi-eye-slash"></i>';
            } else {
                input.type = 'password';
                btn.innerHTML = '<i class="bi bi-eye"></i>';
            }
        }
    </script>
}