@model Apartment
@{ ViewData["Title"] = "لوحة الساكن"; }
@{ var building = ViewBag.Building as Building; }

@if (Model == null || building == null)
{
    <div class="alert alert-warning">لا يمكن تحديد بيانات شقتك.</div>
}
else
{
    <h3>مرحبًا 👋 — شقة @Model.Number، @building.Name</h3>
    <p class="text-muted">الرسم الشهري: @Model.MonthlyFee ج.م</p>
    <div class="mb-3 d-flex gap-2">
        <a asp-controller="ResidentWallet" asp-action="Index" class="btn btn-brand">💼 محفظتي</a>
        <a asp-controller="Invoice" asp-action="Download" class="btn btn-outline-secondary">🧾 تنزيل فاتورتي (PDF)</a>
    </div>
}
