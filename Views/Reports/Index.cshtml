@model ReportsVm
@{
    ViewData["Title"] = Loc.T("Reports_3");
    string RangeBtn(string key, string label) =>
        $"<a href='?range={key}' class='btn btn-sm {(Model.Range == key ? "btn-brand" : "btn-outline-secondary")} me-1'>{label}</a>";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3>@Loc.T("Reports_Of_N", Model.Building.Name)</h3>
    <div>
        @Html.Raw(RangeBtn("6m", Loc.T("6_Months")))
        @Html.Raw(RangeBtn("12m", Loc.T("12_Months")))
        @Html.Raw(RangeBtn("year", Loc.T("Current_Year")))
        @Html.Raw(RangeBtn("all", Loc.T("All_2")))
        <a href="@Url.Action("ExportCsv", new { range = Model.Range })" class="btn btn-sm btn-outline-success">@Loc.T("Export_CSV")</a>
    </div>
</div>

<div class="row mb-3 text-center g-2">
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Total_Collected")</div><div class="fw-bold">@Model.TotalCollected.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Total_Revenues")</div><div class="fw-bold text-success">@Model.TotalRevenues.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Total_Expenses")</div><div class="fw-bold text-danger">@Model.TotalExpenses.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Net_Balance")</div><div class="fw-bold @(Model.NetBalance >= 0 ? "text-success" : "text-danger")">@Model.NetBalance.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Monthly_Average")</div><div class="fw-bold @(Model.AvgMonthly >= 0 ? "text-success" : "text-danger")">@Model.AvgMonthly.ToString("0.##")</div></div></div>
</div>

<div class="bg-white rounded shadow-sm p-3 mb-3">
    <h5>@Loc.T("Collected_Vs_Expenses_By_Month")</h5>
    <div style="height:320px"><canvas id="chartMonthly"></canvas></div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="bg-white rounded shadow-sm p-3">
            <h5>@Loc.T("Expenses_By_Item")</h5>
            @if (Model.Categories.Count == 0)
            {
                <div class="text-muted text-center py-4">@Loc.T("No_Data")</div>
            }
            else
            {
                <div style="height:280px"><canvas id="chartCategories"></canvas></div>
            }
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="bg-white rounded shadow-sm p-3">
            <h5>@Loc.T("Wallet_Distribution_Current_Month")</h5>
            @if (Model.Wallet.Count == 0)
            {
                <div class="text-muted text-center py-4">@Loc.T("No_Data")</div>
            }
            else
            {
                <div style="height:280px"><canvas id="chartWallet"></canvas></div>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="bg-white rounded shadow-sm p-3">
            <h5>@Loc.T("Most_Indebted_Apartments")</h5>
            @if (Model.Debtors.Count == 0)
            {
                <div class="text-muted small py-2">@Loc.T("No_Data")</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <tbody>
                    @foreach (var d in Model.Debtors)
                    {
                        <tr><td>@Loc.T("Apartment_N_N_2", d.Apt.Number, string.IsNullOrEmpty(d.Apt.Owner) ? "" : "— " + d.Apt.Owner)</td><td class="text-danger fw-bold text-end">@d.Balance.ToString("0.##")</td></tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="bg-white rounded shadow-sm p-3">
            <h5>@Loc.T("Apartments_With_The_Highest_Balance")</h5>
            @if (Model.Creditors.Count == 0)
            {
                <div class="text-muted small py-2">@Loc.T("No_Data")</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <tbody>
                    @foreach (var cr in Model.Creditors)
                    {
                        <tr><td>@Loc.T("Apartment_N_N_2", cr.Apt.Number, string.IsNullOrEmpty(cr.Apt.Owner) ? "" : "— " + cr.Apt.Owner)</td><td class="text-success fw-bold text-end">@cr.Balance.ToString("0.##")</td></tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
const monthly = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Monthly));
const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));
const wallet = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Wallet));

new Chart(document.getElementById('chartMonthly'), {
    type: 'bar',
    data: {
        labels: monthly.map(m => m.label),
        datasets: [
            { label: '@Html.Raw(Loc.Js("Collected"))', data: monthly.map(m => m.collected), backgroundColor: '#1C5A50' },
            { label: '@Html.Raw(Loc.Js("Revenues"))', data: monthly.map(m => m.revenues), backgroundColor: '#2E7D5B' },
            { label: '@Html.Raw(Loc.Js("Expenses_3"))', data: monthly.map(m => m.expenses), backgroundColor: '#A0432A' }
        ]
    },
    options: { responsive: true, maintainAspectRatio: false }
});

if (categories.length > 0) {
    new Chart(document.getElementById('chartCategories'), {
        type: 'doughnut',
        data: {
            labels: categories.map(c => c.name),
            datasets: [{ data: categories.map(c => c.total), backgroundColor: categories.map(c => c.color) }]
        },
        options: { responsive: true, maintainAspectRatio: false }
    });
}

if (wallet.length > 0) {
    new Chart(document.getElementById('chartWallet'), {
        type: 'bar',
        data: {
            labels: wallet.map(w => w.label),
            datasets: [{
                label: '@Html.Raw(Loc.Js("Balance"))',
                data: wallet.map(w => w.balance),
                backgroundColor: wallet.map(w => w.balance >= 0 ? '#2E7D5B' : '#A0432A')
            }]
        },
        options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
}
</script>
