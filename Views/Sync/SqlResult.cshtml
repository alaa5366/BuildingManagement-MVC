@using BuildingManagementMvc.Data
@{
    ViewData["Title"] = Loc.T("Sql_Sync_Result");
    var report = ViewBag.Report as SyncReport;
    var provider = ViewBag.Provider as string ?? "—";
    var mirrorEnabled = ViewBag.MirrorEnabled as bool? ?? false;
    var error = ViewBag.Error as string;
}

<div class="container">
    <h2>@Loc.T("Sql_Sync_Result")</h2>

    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-1">@Loc.T("Current_Mode"): <strong>@provider</strong></p>
            <p class="mb-1">
                @Loc.T("Mirror"):
                @if (mirrorEnabled)
                {
                    <span class="text-success">@Loc.T("Enabled") ✅</span>
                }
                else
                {
                    <span class="text-warning">@Loc.T("Disabled") ⚠️</span>
                }
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (report != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4"><strong>@Loc.T("Buildings"):</strong> @report.Buildings</div>
                    <div class="col-md-4"><strong>@Loc.T("Users"):</strong> @report.Users</div>
                    <div class="col-md-4"><strong>@Loc.T("Time"):</strong> @report.Elapsed.TotalSeconds.ToString("0.00") @Loc.T("Seconds")</div>
                </div>
            </div>
        </div>

        @if (report.Errors.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header bg-danger text-white">@Loc.T("Errors") (@report.Errors.Count)</div>
                <div class="card-body">
                    <ul class="mb-0">
                        @foreach (var e in report.Errors.Take(100))
                        {
                            <li>@e</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (report.Warnings.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header bg-warning">@Loc.T("Warnings_Skipped_Rows") (@report.Warnings.Count)</div>
                <div class="card-body">
                    <ul class="mb-0 small">
                        @foreach (var w in report.Warnings.Take(200))
                        {
                            <li>@w</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (report.Errors.Count == 0 && report.Warnings.Count == 0)
        {
            <div class="alert alert-success">✅ @Loc.T("Sync_Completed_Without_Errors")</div>
        }
    }

    <a asp-action="Index" class="btn btn-secondary">@Loc.T("Back")</a>
</div>