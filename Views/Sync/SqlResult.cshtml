@using BuildingManagementMvc.Data
@{
    ViewData["Title"] = "نتيجة مزامنة SQL";
    var report = ViewBag.Report as SyncReport;
    var provider = ViewBag.Provider as string ?? "—";
    var mirrorEnabled = ViewBag.MirrorEnabled as bool? ?? false;
    var error = ViewBag.Error as string;
}

<div class="container">
    <h2>نتيجة مزامنة SQL Server</h2>

    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-1">الوضع الحالي: <strong>@provider</strong></p>
            <p class="mb-1">
                المرآة:
                @if (mirrorEnabled)
                {
                    <span class="text-success">مفعّلة ✅</span>
                }
                else
                {
                    <span class="text-warning">غير مفعّلة ⚠️</span>
                }
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (report != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4"><strong>العمارات:</strong> @report.Buildings</div>
                    <div class="col-md-4"><strong>المستخدمين:</strong> @report.Users</div>
                    <div class="col-md-4"><strong>الوقت:</strong> @report.Elapsed.TotalSeconds.ToString("0.00") ثانية</div>
                </div>
            </div>
        </div>

        @if (report.Errors.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header bg-danger text-white">أخطاء (@report.Errors.Count)</div>
                <div class="card-body">
                    <ul class="mb-0">
                        @foreach (var e in report.Errors.Take(100))
                        {
                            <li>@e</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (report.Warnings.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header bg-warning">تحذيرات: صفوف اتخطّت (@report.Warnings.Count)</div>
                <div class="card-body">
                    <ul class="mb-0 small">
                        @foreach (var w in report.Warnings.Take(200))
                        {
                            <li>@w</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (report.Errors.Count == 0 && report.Warnings.Count == 0)
        {
            <div class="alert alert-success">✅ تمت المزامنة بدون أخطاء أو تحذيرات.</div>
        }
    }

    <a asp-action="Index" class="btn btn-secondary">رجوع</a>
</div>