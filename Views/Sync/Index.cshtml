@{
    ViewData["Title"] = Loc.T("Database_Sync");
    var currentMode = ViewBag.CurrentMode as string ?? "Dual";
}

<div class="container">
    <h2>@Loc.T("Database_Sync_2")</h2>
    <p class="text-muted">@Loc.T("Check_And_Fix_Differences_Between_Firebase")</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ✅ المزامنة الشاملة -->
    <div class="card mb-4 border-primary shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">⚡ @Loc.T("Full_Sync_Everything")</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                @Loc.T("Full_Sync_Everything_Desc")
            </p>
            <form method="post" asp-action="SyncEverything"
                  onsubmit="return confirm('@Loc.T("Confirm_Full_Sync")');">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary btn-lg w-100">
                    ⚡ @Loc.T("Run_Full_Sync")
                </button>
            </form>
        </div>
    </div>

    <h5 class="mb-3">@Loc.T("Individual_Syncs")</h5>

    <div class="row g-3">
        <div class="col-md-4">
            <form method="post" asp-action="SyncAdmins" class="card h-100">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <h5>@Loc.T("Sync_Admins")</h5>
                    <p class="text-muted">@Loc.T("Check_Emails_Firebase_Auth")</p>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="autoFix" value="true" class="form-check-input" />
                        <label class="form-check-label">@Loc.T("Auto_Fix")</label>
                    </div>
                    <button class="btn btn-primary w-100">@Loc.T("Run")</button>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <form method="post" asp-action="SyncResidents" class="card h-100">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <h5>@Loc.T("Sync_Residents")</h5>
                    <p class="text-muted">@Loc.T("Check_Firebase_Auth_For_Residents")</p>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="autoFix" value="true" class="form-check-input" />
                        <label class="form-check-label">@Loc.T("Auto_Fix")</label>
                    </div>
                    <button class="btn btn-primary w-100">@Loc.T("Run")</button>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <form method="post" asp-action="SyncPasswords" class="card h-100">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <h5>@Loc.T("Sync_Passwords")</h5>
                    <p class="text-muted">@Loc.T("Update_Firebase_Auth_With_The_Correct")</p>
                    <button class="btn btn-warning w-100">@Loc.T("Run")</button>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <form method="post" asp-action="SyncSql" class="card h-100">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <h5>@Loc.T("Sync_Sql_Server")</h5>
                    <p class="text-muted">@Loc.T("Copy_All_Buildings_From_Firestore_To_Sql")</p>
                    <button class="btn btn-success w-100">@Loc.T("Run")</button>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <form method="post" asp-action="ReverseSync" class="card h-100">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <h5>@Loc.T("Reverse_Sync_Sql_To_Firebase")</h5>
                    <p class="text-muted">@Loc.T("Transfer_Changes_From_Sql_To_Firebase")</p>
                    <button class="btn btn-info w-100">@Loc.T("Run")</button>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <form method="post" asp-action="SeedUsersToSql" class="card h-100">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <h5>@Loc.T("Copy_Users_To_Sql")</h5>
                    <p class="text-muted">@Loc.T("Copy_All_Users_From_Firestore_To_Sql")</p>
                    <button class="btn btn-dark w-100">@Loc.T("Run")</button>
                </div>
            </form>
        </div>

        <!-- ✅ جديد: DVRs + Cameras -->
        <div class="col-md-4">
            <form method="post" asp-action="SyncDvrs" class="card h-100">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <h5>📹 @Loc.T("Sync_Dvrs_Cameras")</h5>
                    <p class="text-muted">@Loc.T("Copy_All_Dvrs_Cameras_From_Firestore_To_Sql")</p>
                    <button class="btn btn-info w-100">@Loc.T("Run")</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ✅ وضع التخزين -->
    <div class="card mt-4">
        <div class="card-body">
            <h5>@Loc.T("Current_Storage_Mode") <span class="badge bg-primary">@currentMode</span></h5>
            <p class="text-muted">
                @Loc.T("Choose_Read_Write_Source_Apply_Immediately")
            </p>

            <div class="d-flex gap-2 flex-wrap">
                <form method="post" asp-action="SetStorageMode" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mode" value="Firestore" />
                    <button class="btn btn-outline-danger"
                            onclick="return confirm('@Loc.T("Confirm_Switch_To_Firestore")')">
                        🔥 @Loc.T("Firestore_Only")
                    </button>
                </form>

                <form method="post" asp-action="SetStorageMode" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mode" value="Dual" />
                    <button class="btn btn-outline-primary"
                            onclick="return confirm('@Loc.T("Confirm_Switch_To_Dual")')">
                        🔄 @Loc.T("Dual_Firestore_Sql")
                    </button>
                </form>

                <form method="post" asp-action="SetStorageMode" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mode" value="Sql" />
                    <button class="btn btn-outline-success"
                            onclick="return confirm('@Loc.T("Confirm_Switch_To_Sql")')">
                        🗄️ @Loc.T("Sql_Server_Only")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>