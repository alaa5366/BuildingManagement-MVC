@{
    ViewData["Title"] = Loc.T("DB_Maintenance_2");
    var buildings = ViewBag.Buildings as List<BuildingManagementMvc.Models.Building> ?? new();
    var result = ViewBag.Result as BuildingManagementMvc.Models.MaintenanceResult;
    var selectedTool = ViewBag.SelectedTool as string;
    var fix = ViewBag.Fix as bool? ?? false;
}

<div class="container">
    <h2>@Loc.T("Database_Maintenance")</h2>

    <div class="row g-3 mb-4">
        <!-- أداة 1: كشف تكرار المستخدمين -->
        <div class="col-md-6">
            <form method="post" asp-action="RunMaintenance" class="card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tool" value="duplicate-users" />
                <div class="card-body">
                    <h5>@Loc.T("Detect_Duplicate_Users")</h5>
                    <p class="text-muted">@Loc.T("Users_With_The_Same_Mobile_Number")</p>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="fix" value="true" class="form-check-input" />
                        <label class="form-check-label">@Loc.T("Auto_Fix_Delete_Duplicates")</label>
                    </div>
                    <button class="btn btn-warning btn-sm">@Loc.T("Scan")</button>
                </div>
            </form>
        </div>

        <!-- أداة 2: دفعات معلقة قديمة -->
        <div class="col-md-6">
            <form method="post" asp-action="RunMaintenance" class="card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tool" value="stale-deposits" />
                <div class="card-body">
                    <h5>@Loc.T("Old_Pending_Payments")</h5>
                    <div class="mb-2">
                        <label>@Loc.T("Older_Than_Days")</label>
                        <input name="olderThanDays" type="number" value="90" class="form-control form-control-sm" />
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="fix" value="true" class="form-check-input" />
                        <label class="form-check-label">@Loc.T("Auto_Cancel")</label>
                    </div>
                    <button class="btn btn-warning btn-sm">@Loc.T("Scan")</button>
                </div>
            </form>
        </div>

        <!-- أداة 3: إعادة حساب الأرصدة -->
        <div class="col-md-6">
            <form method="post" asp-action="RunMaintenance" class="card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tool" value="recalc-balances" />
                <div class="card-body">
                    <h5>@Loc.T("Recalculate_Balances")</h5>
                    <select name="buildingId" class="form-select form-select-sm mb-2" required>
                        <option value="">@Loc.T("Select_A_Building")</option>
                        @foreach (var b in buildings)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                    <button class="btn btn-warning btn-sm">@Loc.T("Run")</button>
                </div>
            </form>
        </div>

        <!-- أداة 4: كشف اليتامى -->
        <div class="col-md-6">
            <form method="post" asp-action="RunMaintenance" class="card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tool" value="orphaned-deposits" />
                <div class="card-body">
                    <h5>@Loc.T("Detect_Orphan_References")</h5>
                    <p class="text-muted">@Loc.T("Payments_Linked_To_Apartments_That_Don")</p>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="fix" value="true" class="form-check-input" />
                        <label class="form-check-label">@Loc.T("Auto_Cancel")</label>
                    </div>
                    <button class="btn btn-warning btn-sm">@Loc.T("Scan")</button>
                </div>
            </form>
        </div>
    </div>

    @if (result != null)
    {
        <div class="card">
            <div class="card-header bg-info">
                @Loc.T("Result_N", result.ToolName)
            </div>
            <div class="card-body">
                <p><strong>@Loc.T("Number_Of_Items")</strong> @result.ItemsFound</p>
                <p><strong>@Loc.T("Fixed_3")</strong> @result.ItemsFixed</p>

                @if (result.Details.Count > 0)
                {
                    <details>
                        <summary>@Loc.T("Details_3")</summary>
                        <pre style="font-size:11px;max-height:300px;overflow:auto;">@string.Join("\n", result.Details.Take(100))</pre>
                    </details>
                }
            </div>
        </div>
    }
</div>