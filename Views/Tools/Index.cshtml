@{
    ViewData["Title"] = "الأدوات المتقدمة";
}

<div class="container">
    <h2 class="mb-4">🧰 الأدوات المتقدمة</h2>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>🔄 Migration</h5>
                    <p class="text-muted">تحويل سجل العمارة القديم (building.AuditLog) إلى auditLogs collection</p>
                    <a asp-action="Migration" class="btn btn-primary w-100">فتح الأداة</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>🔧 صيانة DB</h5>
                    <p class="text-muted">كشف التكرار، تنظيف المعلق، إعادة حساب الأرصدة، كشف اليتامى</p>
                    <a asp-action="Maintenance" class="btn btn-warning w-100">فتح الأداة</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>📦 تصدير شامل</h5>
                    <p class="text-muted">تصدير كل البيانات (buildings + users) كملف ZIP</p>
                    <a asp-action="Export" class="btn btn-success w-100">فتح الأداة</a>
                </div>
            </div>
        </div>
    </div>
</div>