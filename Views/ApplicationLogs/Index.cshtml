@model BuildingManagementMvc.ViewModels.ApplicationLogsViewModel
@{
    ViewData["Title"] = Loc.T("Application_Logs");
    var result = Model.Results;
    var query = Model.Query;
    var fromValue = query.FromUtc?.ToString("yyyy-MM-dd") ?? "";
    var toValue = query.ToUtc?.ToString("yyyy-MM-dd") ?? "";
    var levels = new[] { "Verbose", "Debug", "Information", "Warning", "Error", "Fatal" };
    var visibleItems = result.Items;
    var exceptionCount = visibleItems.Count(x => x.HasException);
    var sourceCount = visibleItems.Select(x => x.SourceContext)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase).Count();
    var errorCount = visibleItems.Count(x => x.Level is "Error" or "Fatal");
    var warningCount = visibleItems.Count(x => x.Level == "Warning");
    var informationCount = visibleItems.Count(x => x.Level == "Information");
}
@section Styles {
    <link rel="stylesheet" href="~/css/application-logs.css" asp-append-version="true" />
}

<div class="container-fluid log-center">
    <header class="log-hero">
        <div class="log-hero-copy">
            <div class="log-eyebrow"><i class="bi bi-activity"></i> @Loc.T("Log_Center_Eyebrow")</div>
            <h1>@Loc.T("Application_Logs")</h1>
            <p>@Loc.T("Log_Center_Subtitle")</p>
            <div class="log-hero-note">
                <i class="bi bi-shield-check"></i>
                <span>@Loc.T("Log_Dates_Are_UTC_And_Redacted")</span>
            </div>
        </div>
        <div class="log-hero-art" aria-hidden="true">
            <div class="log-orbit log-orbit-one"></div>
            <div class="log-orbit log-orbit-two"></div>
            <div class="log-hero-icon"><i class="bi bi-terminal"></i></div>
            <span class="log-art-dot log-art-dot-one"></span>
            <span class="log-art-dot log-art-dot-two"></span>
        </div>
        <div class="log-hero-total">
            <span>@Loc.T("Log_Total_Matching")</span>
            <strong>@result.TotalItems.ToString("N0")</strong>
            <small>@Loc.T("Events")</small>
        </div>
    </header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning log-validation" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Loc.T("Invalid_Date_Range")
        </div>
    }

    <section class="log-metrics" aria-label="@Loc.T("Log_Overview")">
        <article class="log-metric-card metric-blue">
            <div class="log-metric-top">
                <span class="log-metric-icon"><i class="bi bi-list-ul"></i></span>
                <span class="log-metric-caption">@Loc.T("Log_Visible_On_Page")</span>
            </div>
            <strong>@visibleItems.Count.ToString("N0")</strong>
            <small>@Loc.T("Log_Current_Page")</small>
        </article>
        <article class="log-metric-card metric-red">
            <div class="log-metric-top">
                <span class="log-metric-icon"><i class="bi bi-exclamation-octagon"></i></span>
                <span class="log-metric-caption">@Loc.T("Log_Errors_On_Page")</span>
            </div>
            <strong>@errorCount.ToString("N0")</strong>
            <small>@Loc.T("Log_Error_Fatal")</small>
        </article>
        <article class="log-metric-card metric-amber">
            <div class="log-metric-top">
                <span class="log-metric-icon"><i class="bi bi-exclamation-triangle"></i></span>
                <span class="log-metric-caption">@Loc.T("Log_Exceptions_On_Page")</span>
            </div>
            <strong>@exceptionCount.ToString("N0")</strong>
            <small>@Loc.T("Log_With_Exception")</small>
        </article>
        <article class="log-metric-card metric-teal">
            <div class="log-metric-top">
                <span class="log-metric-icon"><i class="bi bi-diagram-3"></i></span>
                <span class="log-metric-caption">@Loc.T("Log_Sources_On_Page")</span>
            </div>
            <strong>@sourceCount.ToString("N0")</strong>
            <small>@Loc.T("Log_Distinct_Sources")</small>
        </article>
    </section>

    <section class="log-filter-panel">
        <div class="log-section-heading">
            <div>
                <span class="log-section-kicker">@Loc.T("Log_Explore")</span>
                <h2><i class="bi bi-funnel"></i> @Loc.T("Search")</h2>
            </div>
            <a asp-controller="ApplicationLogs" asp-action="Index" class="log-reset-link">
                <i class="bi bi-arrow-counterclockwise"></i> @Loc.T("Reset")
            </a>
        </div>

        <form method="get" asp-controller="ApplicationLogs" asp-action="Index" class="log-filter-form">
            <div class="log-filter-main">
                <div class="log-field log-search-field">
                    <label for="search">@Loc.T("Log_Search_Anything")</label>
                    <div class="log-input-wrap">
                        <i class="bi bi-search"></i>
                        <input class="form-control" id="search" name="search" value="@query.Search"
                               maxlength="200" placeholder="@Loc.T("Log_Search_Placeholder")" />
                    </div>
                </div>
                <div class="log-field">
                    <label for="level">@Loc.T("Level")</label>
                    <select class="form-select" id="level" name="level">
                        <option value="">@Loc.T("All_Levels")</option>
                        @foreach (var item in levels)
                        {
                            <option value="@item" selected="@(string.Equals(query.Level, item, StringComparison.OrdinalIgnoreCase))">@item</option>
                        }
                    </select>
                </div>
                <div class="log-field">
                    <label for="from">@Loc.T("From_Date_UTC")</label>
                    <input class="form-control" type="date" id="from" name="from" value="@fromValue" />
                </div>
                <div class="log-field">
                    <label for="to">@Loc.T("To_Date_UTC")</label>
                    <input class="form-control" type="date" id="to" name="to" value="@toValue" />
                </div>
                <input type="hidden" name="pageSize" value="@result.PageSize" />
                <div class="log-filter-actions">
                    <button type="submit" class="btn log-search-button">
                        <i class="bi bi-search"></i> @Loc.T("Search")
                    </button>
                </div>
            </div>

            <details class="log-advanced-filters" open="@( !string.IsNullOrWhiteSpace(query.Source) || !string.IsNullOrWhiteSpace(query.CorrelationId) || query.HasException.HasValue )">
                <summary><i class="bi bi-sliders"></i> @Loc.T("Log_Advanced_Filters")</summary>
                <div class="log-advanced-grid">
                    <div class="log-field">
                        <label for="source">@Loc.T("Source_Context")</label>
                        <input class="form-control" id="source" name="source" value="@query.Source" maxlength="200"
                               placeholder="@Loc.T("Log_Source_Placeholder")" />
                    </div>
                    <div class="log-field">
                        <label for="correlationId">@Loc.T("Correlation_ID")</label>
                        <input class="form-control font-monospace" id="correlationId" name="correlationId"
                               value="@query.CorrelationId" maxlength="100" placeholder="Correlation ID" />
                    </div>
                    <div class="log-field">
                        <label for="hasException">@Loc.T("Exception")</label>
                        <select class="form-select" id="hasException" name="hasException">
                            <option value="">@Loc.T("All_Events")</option>
                            <option value="true" selected="@(query.HasException == true)">@Loc.T("With_Exception")</option>
                            <option value="false" selected="@(query.HasException == false)">@Loc.T("Without_Exception")</option>
                        </select>
                    </div>
                </div>
            </details>
        </form>
    </section>

    <section class="log-results-panel">
        <div class="log-results-heading">
            <div>
                <span class="log-section-kicker">@Loc.T("Log_Activity")</span>
                <h2><i class="bi bi-card-list"></i> @Loc.T("Log_Results")</h2>
                <p>@Loc.T("Log_Results_Description")</p>
            </div>
            <div class="log-result-count">
                <strong>@result.FirstItemIndex–@result.LastItemIndex</strong>
                <span>/ @result.TotalItems.ToString("N0")</span>
            </div>
        </div>

        <div class="log-level-summary">
            <span class="level-summary-item"><i class="level-dot dot-error"></i>@Loc.T("Log_Error_Fatal") <strong>@errorCount</strong></span>
            <span class="level-summary-item"><i class="level-dot dot-warning"></i>@Loc.T("Log_Warnings") <strong>@warningCount</strong></span>
            <span class="level-summary-item"><i class="level-dot dot-info"></i>@Loc.T("Log_Information") <strong>@informationCount</strong></span>
            <span class="level-summary-note">@Loc.T("Log_Current_Page_Only")</span>
        </div>

        <div class="table-responsive log-table-wrap">
            <table class="table log-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="log-time-column">@Loc.T("Log_UTC_Time")</th>
                        <th>@Loc.T("Level")</th>
                        <th class="log-message-column">@Loc.T("Message")</th>
                        <th>@Loc.T("Source_Context")</th>
                        <th>@Loc.T("Correlation_ID")</th>
                        <th>@Loc.T("Details")</th>
                    </tr>
                </thead>
                <tbody>
                @if (visibleItems.Count == 0)
                {
                    <tr>
                        <td colspan="6">
                            <div class="log-empty-state">
                                <span class="log-empty-icon"><i class="bi bi-search"></i></span>
                                <strong>@Loc.T("Log_Empty_Title")</strong>
                                <p>@Loc.T("No_Log_Events_Found")</p>
                                <a asp-controller="ApplicationLogs" asp-action="Index" class="btn btn-sm btn-outline-primary">@Loc.T("Log_Clear_Filters")</a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in visibleItems)
                    {
                        var levelClass = item.Level switch
                        {
                            "Fatal" => "log-level-fatal",
                            "Error" => "log-level-error",
                            "Warning" => "log-level-warning",
                            "Information" => "log-level-information",
                            "Debug" => "log-level-debug",
                            _ => "log-level-muted"
                        };
                        var levelIcon = item.Level switch
                        {
                            "Fatal" or "Error" => "bi-exclamation-octagon-fill",
                            "Warning" => "bi-exclamation-triangle-fill",
                            "Information" => "bi-info-circle-fill",
                            "Debug" => "bi-bug-fill",
                            _ => "bi-circle-fill"
                        };
                        <tr>
                            <td class="log-time-cell">
                                <span>@item.Timestamp.UtcDateTime.ToString("yyyy-MM-dd")</span>
                                <strong>@item.Timestamp.UtcDateTime.ToString("HH:mm:ss.fff")</strong>
                                <small>UTC</small>
                            </td>
                            <td><span class="log-level-badge @levelClass"><i class="bi @levelIcon"></i>@item.Level</span></td>
                            <td class="log-message-cell">
                                <div>@item.Message</div>
                                @if (item.HasException)
                                {
                                    <span class="log-exception-hint"><i class="bi bi-exclamation-circle"></i> @Loc.T("Exception")</span>
                                }
                            </td>
                            <td class="log-source-cell">
                                <span title="@item.SourceContext">@item.SourceContext</span>
                            </td>
                            <td class="log-correlation-cell">
                                @if (!string.IsNullOrWhiteSpace(item.CorrelationId))
                                {
                                    <a asp-action="Index" asp-route-correlationId="@item.CorrelationId"
                                       class="log-correlation-link" title="@Loc.T("Log_Filter_By_Correlation")">
                                        @item.CorrelationId <i class="bi bi-arrow-up-left"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="log-details-cell">
                                @if (item.HasException || !string.IsNullOrWhiteSpace(item.Details))
                                {
                                    <details class="log-event-details">
                                        <summary><i class="bi bi-braces"></i> @Loc.T("Log_Inspect")</summary>
                                        @if (!string.IsNullOrWhiteSpace(item.Details))
                                        {
                                            <div class="log-detail-block">
                                                <span>@Loc.T("Details")</span>
                                                <pre>@item.Details</pre>
                                            </div>
                                        }
                                        @if (item.HasException)
                                        {
                                            <div class="log-detail-block log-exception-block">
                                                <span>@Loc.T("Exception")</span>
                                                <pre>@item.Exception</pre>
                                            </div>
                                        }
                                    </details>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <footer class="log-pagination">
            <span class="log-pagination-caption">@result.FirstItemIndex–@result.LastItemIndex @Loc.T("Log_Of") @result.TotalItems.ToString("N0")</span>
            <nav aria-label="Log pages">
                <ul class="pagination mb-0">
                    <li class="page-item @(!result.HasPrevious ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-from="@fromValue" asp-route-to="@toValue"
                           asp-route-level="@query.Level" asp-route-search="@query.Search"
                           asp-route-correlationId="@query.CorrelationId" asp-route-source="@query.Source"
                           asp-route-hasException="@query.HasException" asp-route-page="@(result.CurrentPage - 1)"
                           asp-route-pageSize="@result.PageSize"><i class="bi bi-chevron-right"></i> @Loc.T("Previous")</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@result.CurrentPage / @Math.Max(1, result.TotalPages)</span></li>
                    <li class="page-item @(!result.HasNext || result.CurrentPage >= 100 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-from="@fromValue" asp-route-to="@toValue"
                           asp-route-level="@query.Level" asp-route-search="@query.Search"
                           asp-route-correlationId="@query.CorrelationId" asp-route-source="@query.Source"
                           asp-route-hasException="@query.HasException" asp-route-page="@(result.CurrentPage + 1)"
                           asp-route-pageSize="@result.PageSize">@Loc.T("Next") <i class="bi bi-chevron-left"></i></a>
                    </li>
                </ul>
            </nav>
        </footer>
    </section>
</div>
