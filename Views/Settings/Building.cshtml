@model BuildingManagementMvc.Models.BuildingSettings
@{
    ViewData["Title"] = "إعدادات العمارة";
    var building = ViewBag.Building as BuildingManagementMvc.Models.Building;
    var buildingId = ViewBag.BuildingId as string;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🏢 إعدادات @building?.Name</h2>
        @if (User.IsInRole("superadmin"))
        {
            <a asp-action="Building" class="btn btn-outline-secondary">← كل العمارات</a>
        }
    </div>

    <form method="post" asp-action="Building">
        @Html.AntiForgeryToken()
        <input type="hidden" name="buildingId" value="@buildingId" />

        @* بيانات العمارة *@
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <strong>📋 بيانات العمارة</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">الاسم الظاهر</label>
                        <input name="DisplayName" value="@Model.DisplayName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">رقم واتساب العمارة</label>
                        <input name="WhatsappNumber" value="@Model.WhatsappNumber" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">العنوان</label>
                        <input name="Address" value="@Model.Address" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        @* سياسة الفواتير *@
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <strong>🧾 سياسة الفواتير</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">يوم إصدار الفاتورة من الشهر</label>
                        <input type="number" name="InvoiceDayOfMonth" min="1" max="28"
                               value="@Model.InvoiceDayOfMonth" class="form-control" />
                        <div class="form-text">1-28 (لتجنب مشاكل الشهور القصيرة)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">العملة</label>
                        <select name="Currency" class="form-select">
                            <option value="EGP" selected="@(Model.Currency == "EGP")">ج.م (EGP)</option>
                            <option value="SAR" selected="@(Model.Currency == "SAR")">ر.س (SAR)</option>
                            <option value="AED" selected="@(Model.Currency == "AED")">د.إ (AED)</option>
                            <option value="USD" selected="@(Model.Currency == "USD")">$ (USD)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @* توزيع المصروفات *@
        <div class="card mb-3">
            <div class="card-header bg-info text-dark">
                <strong>⚖️ توزيع المصروفات</strong>
            </div>
            <div class="card-body">
                <div class="form-check mb-2">
                    <input type="radio" name="ExpenseDistribution" value="equal" class="form-check-input"
                           id="dist-equal" @(Model.ExpenseDistribution == "equal" ? "checked" : "") />
                    <label class="form-check-label" for="dist-equal">
                        <strong>بالتساوي</strong> — على كل الشقق المفتوحة بالتساوي
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input type="radio" name="ExpenseDistribution" value="by_area" class="form-check-input"
                           id="dist-area" @(Model.ExpenseDistribution == "by_area" ? "checked" : "") />
                    <label class="form-check-label" for="dist-area">
                        <strong>حسب المساحة</strong> — نسبة لكل شقة حسب المساحة
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input type="radio" name="ExpenseDistribution" value="by_residents" class="form-check-input"
                           id="dist-res" @(Model.ExpenseDistribution == "by_residents" ? "checked" : "") />
                    <label class="form-check-label" for="dist-res">
                        <strong>حسب عدد السكان</strong> — نسبة حسب عدد أفراد الشقة
                    </label>
                </div>
                <div class="form-check">
                    <input type="radio" name="ExpenseDistribution" value="by_opened" class="form-check-input"
                           id="dist-open" @(Model.ExpenseDistribution == "by_opened" ? "checked" : "") />
                    <label class="form-check-label" for="dist-open">
                        <strong>على الشقق المفتوحة والمعطّلة فقط</strong> — المقفولة مستثناة
                    </label>
                </div>
            </div>
        </div>

        @* التصويتات *@
        <div class="card mb-3">
            <div class="card-header bg-warning">
                <strong>🗳️ التصويتات</strong>
            </div>
            <div class="card-body">
                <label class="form-label">نصاب التصويت (%)</label>
                <input type="number" name="VotingQuorumPercent" min="1" max="100"
                       value="@Model.VotingQuorumPercent" class="form-control" />
                <div class="form-text">النسبة المطلوبة من السكان لاعتبار التصويت صحيحًا</div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">💾 حفظ الإعدادات</button>
    </form>
</div>