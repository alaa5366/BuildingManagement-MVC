@{
    ViewData["Title"] = Loc.T("Select_Building");
    var buildings = ViewBag.Buildings as List<BuildingManagementMvc.Models.Building> ?? new();
}

<div class="container">
    <h2>@Loc.T("Select_The_Building_For_Its_Settings")</h2>

    @if (buildings.Count == 0)
    {
        <div class="alert alert-info">@Loc.T("No_Buildings_Found")</div>
    }
    else
    {
        <div class="list-group mt-3">
            @foreach (var b in buildings)
            {
                <a asp-action="Building" asp-route-id="@b.Id" class="list-group-item list-group-item-action">
                    <strong>@b.Name</strong>
                    <small class="text-muted">— @b.BuildingNumber</small>
                </a>
            }
        </div>
    }
</div>