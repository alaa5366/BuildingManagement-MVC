@model BuildingManagementMvc.Models.OwnSettings
@{
    ViewData["Title"] = Loc.T("My_Settings");
    var isResident = ViewBag.IsResident as bool? ?? false;
    var ownerName = ViewBag.OwnerName as string ?? "";
    var aptLabel = ViewBag.AptLabel as string ?? "";
    var currentPhone = ViewBag.CurrentPhone as string ?? "";
    var currentWhatsapp = ViewBag.CurrentWhatsapp as string ?? currentPhone;
    var aptNumber = ViewBag.AptNumber as int? ?? 0;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var roleLabel = role switch
    {
        "superadmin" => Loc.T("Super_Admin"),
        "admin" => Loc.T("Admin"),
        "resident" => Loc.T("Resident_2"),
        _ => role
    };

    var initials = string.IsNullOrWhiteSpace(ownerName)
        ? "?"
        : string.Join("", ownerName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2).Select(w => w[0]));
}

<div class="container" style="max-width: 1000px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">@Loc.T("My_Settings_2")</h2>
        <span class="badge bg-secondary fs-6">@roleLabel</span>
    </div>

    <form method="post" asp-action="Own" id="ownSettingsForm" novalidate>
        @Html.AntiForgeryToken()

        @* ============================================================ *@
        @* 👤 بياناتي الشخصية                                          *@
        @* ============================================================ *@
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size: 22px;">👤</span>
                    <div>
                        <strong class="fs-5">@Loc.T("My_Personal_Details")</strong>
                        <div class="small text-white-50">@Loc.T("Your_Name_And_Contact_Number_As")</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">

                @* ===== Avatar + Info ===== *@
                <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom flex-wrap">
                    <div class="rounded-circle bg-primary bg-gradient d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0"
                         style="width: 72px; height: 72px; font-size: 26px;">
                        @initials
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold fs-5">
                            @(string.IsNullOrWhiteSpace(ownerName) ? "—" : ownerName)
                        </div>
                        <div class="text-muted small">
                            @roleLabel
                            @if (isResident && aptNumber > 0)
                            {
                                <text> @Loc.T("Apartment_N_3", aptNumber)</text>
                            }
                        </div>
                    </div>
                </div>

                @* ===== الحقول ===== *@
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Html.Raw(Loc.T("Name_2"))</label>
                        <input name="OwnerName" value="@ownerName" required
                               maxlength="100" class="form-control form-control-lg"
                               placeholder="@Loc.T("Enter_Your_Name_Here")" />
                        <div class="form-text">@Loc.T("The_Name_Shown_On_Invoices_And")</div>
                    </div>

                    @if (isResident)
                    {
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Html.Raw(Loc.T("Apartment_Name_Optional"))</label>
                            <input name="AptLabel" value="@aptLabel" maxlength="60"
                                   class="form-control form-control-lg"
                                   placeholder="@Loc.T("Example_Alaa_S_Apartment")" />
                            <div class="form-text">@Loc.T("A_Short_Name_To_Identify_The")</div>
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Html.Raw(Loc.T("Mobile_Number_Affects_Login"))</label>
                        <input name="NewPhone" value="@currentPhone"
                               class="form-control form-control-lg" dir="ltr"
                               placeholder="+201xxxxxxxxx" />
                        <div class="form-text text-warning small">
                            @Loc.T("Changing_It_Automatically_Updates_The_Firebase")
                        </div>
                    </div>

                    @if (!isResident)
                    {
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Html.Raw(Loc.T("WhatsApp_Number_Separate"))</label>
                            <input name="NewWhatsapp" value="@currentWhatsapp"
                                   class="form-control form-control-lg" dir="ltr"
                                   placeholder="+201xxxxxxxxx" />
                            <div class="form-text">@Loc.T("Can_Be_Different_From_The_Mobile")</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ============================================================ *@
        @* 🔐 الأمان — PIN                                              *@
        @* ============================================================ *@
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size: 22px;">🔐</span>
                    <div>
                        <strong class="fs-5">@Loc.T("Security_Change_PIN")</strong>
                        <div class="small text-white-50">@Loc.T("Leave_Empty_If_You_Don_T")</div>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">@Loc.T("Current_PIN")</label>
                        <div class="input-group">
                            <input name="CurrentPin" id="currentPin" type="password"
                                   maxlength="4" inputmode="numeric" pattern="\d*"
                                   class="form-control form-control-lg" placeholder="••••" />
                            <button type="button" class="btn btn-outline-secondary toggle-pin"
                                    data-target="currentPin" tabindex="-1">👁</button>
                        </div>
                        <div class="form-text">@Loc.T("Required_Only_To_Change_The_Mobile")</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">@Loc.T("New_PIN_2")</label>
                        <div class="input-group">
                            <input name="NewPin" id="newPin" type="password"
                                   maxlength="4" inputmode="numeric" pattern="\d*"
                                   class="form-control form-control-lg" placeholder="••••" />
                            <button type="button" class="btn btn-outline-secondary toggle-pin"
                                    data-target="newPin" tabindex="-1">👁</button>
                        </div>
                        <div class="progress mt-1" style="height: 4px;">
                            <div id="pinStrength" class="progress-bar" style="width: 0%;"></div>
                        </div>
                        <div class="form-text">@Loc.T("Exactly_4_Digits")</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">@Loc.T("Confirm_New_PIN")</label>
                        <div class="input-group">
                            <input name="ConfirmNewPin" id="confirmPin" type="password"
                                   maxlength="4" inputmode="numeric" pattern="\d*"
                                   class="form-control form-control-lg" placeholder="••••" />
                            <button type="button" class="btn btn-outline-secondary toggle-pin"
                                    data-target="confirmPin" tabindex="-1">👁</button>
                        </div>
                        <div class="form-text" id="pinMatchMsg"></div>
                    </div>
                </div>
            </div>
        </div>

        @* ============================================================ *@
        @* ⚙️ التفضيلات                                                  *@
        @* ============================================================ *@
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size: 22px;">⚙️</span>
                    <div>
                        <strong class="fs-5">@Loc.T("Preferences")</strong>
                        <div class="small text-white-50">@Loc.T("Language_Notifications_Payment_Method")</div>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Loc.T("Language")</label>
                        <select name="Language" class="form-select form-select-lg">
                            <option value="ar" selected="@(Model.Language == "ar")">@Loc.T("Text_26b1b2")</option>
                            <option value="en" selected="@(Model.Language == "en")">English</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Loc.T("Preferred_Payment_Method")</label>
                        <select name="PreferredPaymentMethod" class="form-select form-select-lg">
                            <option value="instapay" selected="@(Model.PreferredPaymentMethod == "instapay")">InstaPay</option>
                            <option value="cash" selected="@(Model.PreferredPaymentMethod == "cash")">@Loc.T("Cash")</option>
                            <option value="bank" selected="@(Model.PreferredPaymentMethod == "bank")">@Loc.T("Bank_Transfer")</option>
                            <option value="vodafone" selected="@(Model.PreferredPaymentMethod == "vodafone")">@Loc.T("Vodafone_Cash")</option>
                        </select>
                    </div>
                </div>

                <label class="form-label fw-semibold">@Loc.T("Notification_Preferences")</label>
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="form-check form-switch p-3 border rounded">
                            <input asp-for="NotificationPreferences.WhatsApp" class="form-check-input" />
                            <label asp-for="NotificationPreferences.WhatsApp" class="form-check-label">
                                @Loc.T("WhatsApp_2")
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch p-3 border rounded">
                            <input asp-for="NotificationPreferences.Email" class="form-check-input" />
                            <label asp-for="NotificationPreferences.Email" class="form-check-label">
                                @Loc.T("Email_3")
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch p-3 border rounded">
                            <input asp-for="NotificationPreferences.InApp" class="form-check-input" />
                            <label asp-for="NotificationPreferences.InApp" class="form-check-label">
                                @Loc.T("In_App")
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ===== أزرار ===== *@
        <div class="d-flex gap-2 justify-content-end mb-5">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg">@Loc.T("Cancel_3")</a>
            <button type="submit" class="btn btn-primary btn-lg px-4">
                @Loc.T("Save_Changes")
            </button>
        </div>

    </form>
</div>

@section Scripts {
<script>
    // 👁 إظهار/إخفاء PIN
    document.querySelectorAll('.toggle-pin').forEach(btn => {
        btn.addEventListener('click', () => {
            const input = document.getElementById(btn.dataset.target);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            btn.textContent = input.type === 'password' ? '👁' : '🙈';
        });
    });

    // 🔢 امنع غير الأرقام في حقول PIN
    ['currentPin', 'newPin', 'confirmPin'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', () => {
            el.value = el.value.replace(/\D/g, '').slice(0, 4);
            if (id === 'newPin') updatePinStrength(el.value);
            if (id === 'newPin' || id === 'confirmPin') checkPinMatch();
        });
    });

    // 📊 مؤشر قوة PIN
    function updatePinStrength(pin) {
        const bar = document.getElementById('pinStrength');
        if (!bar) return;
        const len = pin.length;
        let pct = 0, color = 'bg-danger';
        if (len === 4) {
            const unique = new Set(pin).size;
            if (unique === 1) { pct = 40; color = 'bg-danger'; }
            else if (unique === 2) { pct = 60; color = 'bg-warning'; }
            else if (unique === 3) { pct = 80; color = 'bg-info'; }
            else { pct = 100; color = 'bg-success'; }
        } else if (len > 0) {
            pct = len * 15;
            color = 'bg-danger';
        }
        bar.style.width = pct + '%';
        bar.className = 'progress-bar ' + color;
    }

    // ✅ تحقق فوري من تطابق PIN
    function checkPinMatch() {
        const np = document.getElementById('newPin')?.value || '';
        const cp = document.getElementById('confirmPin')?.value || '';
        const msg = document.getElementById('pinMatchMsg');
        const cpEl = document.getElementById('confirmPin');
        if (!msg || !cpEl) return;

        if (cp.length === 0) {
            msg.textContent = '';
            cpEl.classList.remove('is-valid', 'is-invalid');
        } else if (cp === np) {
            msg.textContent = '✅ @Html.Raw(Loc.Js("Matching"))';
            msg.className = 'form-text text-success';
            cpEl.classList.remove('is-invalid');
            cpEl.classList.add('is-valid');
        } else {
            msg.textContent = '❌ @Html.Raw(Loc.Js("Not_Matching"))';
            msg.className = 'form-text text-danger';
            cpEl.classList.remove('is-valid');
            cpEl.classList.add('is-invalid');
        }
    }

    // 🛡 تأكيد قبل الحفظ لو فيه تغيير PIN
    document.getElementById('ownSettingsForm')?.addEventListener('submit', (e) => {
        const np = document.getElementById('newPin')?.value || '';
        const cp = document.getElementById('confirmPin')?.value || '';
        const cur = document.getElementById('currentPin')?.value || '';

        if (np.length > 0 || cp.length > 0) {
            if (np.length !== 4) {
                e.preventDefault();
                alert('⚠️ PIN @Html.Raw(Loc.Js("The_New_One_Must_Be_4"))');
                return;
            }
            if (np !== cp) {
                e.preventDefault();
                alert('⚠️ PIN @Html.Raw(Loc.Js("The_New_PIN_And_Its_Confirmation"))');
                return;
            }
            if (cur.length !== 4) {
                e.preventDefault();
                alert('⚠️ @Html.Raw(Loc.Js("You_Must_Enter_The_Current_PIN"))');
                return;
            }
        }
    });
</script>
}