@model BuildingManagementMvc.Models.OwnSettings
@{
    ViewData["Title"] = Loc.T("My_Settings");
    var isResident = ViewBag.IsResident as bool? ?? false;
    var canManageTwoFactor = ViewBag.CanManageTwoFactor as bool? ?? false;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var roleLabel = role switch
    {
        "superadmin" => Loc.T("Super_Admin"),
        "admin" => Loc.T("Admin"),
        "resident" => Loc.T("Resident_2"),
        _ => role
    };
    var initials = string.Join("", (Model.DisplayName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(part => part[0]));
    var statusLabel = Model.AccountStatus switch
    {
        0 => "Pending",
        1 => "Active",
        2 => "Suspended",
        3 => "Closed",
        _ => $"Unknown ({Model.AccountStatus})"
    };
}

<div class="container py-3" style="max-width: 1080px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">@Loc.T("My_Settings_2")</h2>
            <p class="text-muted mb-0">Manage your identity, account security and personal preferences</p>
        </div>
        <span class="badge rounded-pill text-bg-secondary px-3 py-2">@roleLabel</span>
    </div>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (TempData["Message"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <form method="post" asp-action="Own" id="ownSettingsForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 flex-wrap mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                    {
                        <img src="@Model.PhotoUrl" alt="Profile photo" class="rounded-circle border"
                             style="width:76px;height:76px;object-fit:cover" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                             style="width:76px;height:76px;font-size:1.5rem">
                            @(string.IsNullOrWhiteSpace(initials) ? "?" : initials)
                        </div>
                    }
                    <div class="flex-grow-1">
                        <h4 class="mb-1">@Model.DisplayName</h4>
                        <div class="text-muted">@roleLabel
                            @if (isResident && Model.ApartmentNumber.HasValue)
                            {
                                <span> · @Loc.T("Apartment_N_3", Model.ApartmentNumber.Value)</span>
                            }
                        </div>
                    </div>
                    @if (Model.MustChangePin)
                    {
                        <span class="badge text-bg-warning">PIN change required</span>
                    }
                </div>

                <h5 class="mb-3">Personal identity</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DisplayName" class="form-label fw-semibold">Display name</label>
                        <input asp-for="DisplayName" class="form-control" maxlength="160" required autocomplete="name" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LegalName" class="form-label fw-semibold">Legal name</label>
                        <input asp-for="LegalName" class="form-control" maxlength="200" autocomplete="off" />
                        <span asp-validation-for="LegalName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrimaryEmail" class="form-label fw-semibold">Contact email</label>
                        <input asp-for="PrimaryEmail" type="email" class="form-control" maxlength="254" autocomplete="email" />
                        <span asp-validation-for="PrimaryEmail" class="text-danger small"></span>
                        <div class="form-text">This contact address is separate from your sign-in identifier.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrimaryPhone" class="form-label fw-semibold">Mobile number</label>
                        <input asp-for="PrimaryPhone" type="tel" class="form-control" maxlength="32" dir="ltr" autocomplete="tel" />
                        <span asp-validation-for="PrimaryPhone" class="text-danger small"></span>
                        <div class="form-text">Changing the mobile number requires your current PIN; SuperAdmin contact changes require recent MFA verification.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Whatsapp" class="form-label fw-semibold">WhatsApp number</label>
                        <input asp-for="Whatsapp" type="tel" class="form-control" maxlength="32" dir="ltr" autocomplete="tel" />
                        <span asp-validation-for="Whatsapp" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhotoUrl" class="form-label fw-semibold">Profile photo URL</label>
                        <input asp-for="PhotoUrl" type="url" class="form-control" maxlength="2048" dir="ltr" placeholder="https://..." />
                        <span asp-validation-for="PhotoUrl" class="text-danger small"></span>
                    </div>
                    @if (isResident)
                    {
                        <div class="col-md-6">
                            <label asp-for="ApartmentLabel" class="form-label fw-semibold">Apartment display label</label>
                            <input asp-for="ApartmentLabel" class="form-control" maxlength="60" />
                            <span asp-validation-for="ApartmentLabel" class="text-danger small"></span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="mb-3">Account and security information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="small text-muted">Account status</div>
                        <div class="fw-semibold">@statusLabel (@Model.AccountStatus)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Sign-in identifier</div>
                        <div class="fw-semibold text-break">@(string.IsNullOrWhiteSpace(Model.LoginEmail) ? "Not configured" : Model.LoginEmail)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">External sign-in provider</div>
                        <div class="fw-semibold">@(Model.ExternalProvider ?? "Not linked")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">PIN update required</div>
                        <div class="fw-semibold">@(Model.MustChangePin ? "Yes" : "No")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Account created (UTC)</div>
                        <div class="fw-semibold">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Last sign-in (UTC)</div>
                        <div class="fw-semibold">@(Model.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "No sign-in recorded")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">@Loc.T("Mfa_Status_Label")</div>
                        <div class="fw-semibold">@(Model.TwoFactorEnabled ? Loc.T("Mfa_Status_Enabled") : Loc.T("Mfa_Status_Disabled"))</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">@Loc.T("Mfa_Unused_Recovery_Codes")</div>
                        <div class="fw-semibold">@Model.UnusedRecoveryCodes</div>
                    </div>
                    @if (Model.TwoFactorEnabled)
                    {
                        <div class="col-md-6">
                            <div class="small text-muted">@Loc.T("Mfa_Enrolled_At_Utc")</div>
                            <div class="fw-semibold">@(Model.TwoFactorEnrolledAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">@Loc.T("Mfa_Last_Verified_At_Utc")</div>
                            <div class="fw-semibold">@(Model.TwoFactorLastVerifiedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                        </div>
                    }
                </div>
                @if (canManageTwoFactor)
                {
                    <hr class="my-4" />
                    @if (Model.TwoFactorEnabled)
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <div class="fw-semibold text-success">@Loc.T("Mfa_Administrator_Protected_Title")</div>
                                <div class="small text-muted">@Loc.T("Mfa_Administrator_Protected_Description")</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <div class="fw-semibold text-danger">@Loc.T("Mfa_Admin_Not_Enrolled_Title")</div>
                                <div class="small text-muted">@Loc.T("Mfa_Admin_Enroll_Before_Access")</div>
                            </div>
                            <button type="submit" class="btn btn-primary"
                                    formaction="@Url.Action("BeginTwoFactorSetup", "Account")" formmethod="post">@Loc.T("Mfa_Setup_Authenticator_Button")</button>
                        </div>
                    }
                }
            </div>
        </section>

        @if (role is "resident" or "admin")
        {
            <section class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-1">Change PIN</h5>
                    <p class="text-muted small mb-3">Leave all three fields empty if you do not want to change your PIN.</p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="CurrentPin" class="form-label">Current PIN</label>
                            <div class="input-group">
                                <input asp-for="CurrentPin" type="password" inputmode="numeric" minlength="4" maxlength="12"
                                       pattern="[0-9]{4,12}" class="form-control pin-field" autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary toggle-pin" data-target="CurrentPin">Show</button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewPin" class="form-label">New PIN</label>
                            <div class="input-group">
                                <input asp-for="NewPin" type="password" inputmode="numeric" minlength="4" maxlength="12"
                                       pattern="[0-9]{4,12}" class="form-control pin-field" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary toggle-pin" data-target="NewPin">Show</button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ConfirmNewPin" class="form-label">Confirm new PIN</label>
                            <div class="input-group">
                                <input asp-for="ConfirmNewPin" type="password" inputmode="numeric" minlength="4" maxlength="12"
                                       pattern="[0-9]{4,12}" class="form-control pin-field" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary toggle-pin" data-target="ConfirmNewPin">Show</button>
                            </div>
                            <div id="pinMatchMessage" class="form-text" aria-live="polite"></div>
                        </div>
                    </div>
                </div>
            </section>
        }

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="mb-3">Personal preferences</h5>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Language" class="form-label fw-semibold">Language</label>
                        <select asp-for="Language" class="form-select">
                            <option value="ar">العربية</option>
                            <option value="en">English</option>
                            <option value="fr">Français</option>
                            <option value="de">Deutsch</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PreferredPaymentMethod" class="form-label fw-semibold">Preferred payment method</label>
                        <select asp-for="PreferredPaymentMethod" class="form-select">
                            <option value="instapay">InstaPay</option>
                            <option value="cash">@Loc.T("Cash")</option>
                            <option value="bank">@Loc.T("Bank_Transfer")</option>
                            <option value="vodafone">@Loc.T("Vodafone_Cash")</option>
                        </select>
                    </div>
                </div>
                <label class="form-label fw-semibold">Notification channels</label>
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="form-check form-switch border rounded p-3">
                            <input asp-for="NotificationPreferences.WhatsApp" class="form-check-input" />
                            <label asp-for="NotificationPreferences.WhatsApp" class="form-check-label">WhatsApp</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch border rounded p-3">
                            <input asp-for="NotificationPreferences.Email" class="form-check-input" />
                            <label asp-for="NotificationPreferences.Email" class="form-check-label">Email</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch border rounded p-3">
                            <input asp-for="NotificationPreferences.InApp" class="form-check-input" />
                            <label asp-for="NotificationPreferences.InApp" class="form-check-label">In-app</label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="d-flex flex-wrap justify-content-end gap-2 mb-5">
            <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Save changes</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
(() => {
    const form = document.getElementById('ownSettingsForm');
    if (!form) return;

    document.querySelectorAll('.toggle-pin').forEach(button => {
        button.addEventListener('click', () => {
            const input = document.getElementById(button.dataset.target);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            button.textContent = input.type === 'password' ? 'Show' : 'Hide';
        });
    });

    document.querySelectorAll('.pin-field').forEach(input => {
        input.addEventListener('input', () => {
            input.value = input.value.replace(/\D/g, '').slice(0, 12);
            updatePinMatch();
        });
    });

    function updatePinMatch() {
        const next = document.getElementById('NewPin');
        const confirm = document.getElementById('ConfirmNewPin');
        const message = document.getElementById('pinMatchMessage');
        if (!next || !confirm || !message) return;
        if (!confirm.value) {
            message.textContent = '';
            confirm.classList.remove('is-valid', 'is-invalid');
        } else if (next.value === confirm.value) {
            message.textContent = 'PINs match';
            message.className = 'form-text text-success';
            confirm.classList.add('is-valid');
            confirm.classList.remove('is-invalid');
        } else {
            message.textContent = 'PINs do not match';
            message.className = 'form-text text-danger';
            confirm.classList.add('is-invalid');
            confirm.classList.remove('is-valid');
        }
    }

    form.addEventListener('submit', event => {
        const next = document.getElementById('NewPin');
        const confirm = document.getElementById('ConfirmNewPin');
        const current = document.getElementById('CurrentPin');
        if (!next || !confirm || !current) return;
        if (!next.value && !confirm.value && !current.value) return;
        if (!/^\d{4,12}$/.test(next.value) || next.value !== confirm.value || !/^\d{4,12}$/.test(current.value)) {
            event.preventDefault();
            window.alert('Enter the current PIN and matching new PIN values (4–12 digits).');
        }
    });
})();
</script>
}
