.table-card{border:1px solid var(--id-border);border-radius:15px;background:var(--bs-body-bg);overflow:hidden;margin-bottom:15px}.table-card-heading{display:flex;align-items:center;justify-content:space-between;padding:15px 18px;border-bottom:1px solid var(--id-border)}.table-card-heading h3{font-size:14px;font-weight:800;margin:0 0 4px}.table-card-heading p{font-size:10px;color:var(--id-muted);margin:0}.table-card-heading>span{font-size:10px;color:var(--id-muted);background:var(--bs-tertiary-bg);padding:6px 9px;border-radius:20px;white-space:nowrap}
.identity-table{width:100%;margin:0;font-size:11px;vertical-align:middle}.identity-table thead th{padding:12px;background:var(--bs-tertiary-bg);color:var(--id-muted);font-size:10px;font-weight:800;white-space:nowrap;border-bottom:1px solid var(--id-border)}.identity-table tbody td{padding:11px 12px;border-bottom:1px solid var(--id-border);max-width:260px}.identity-table tbody tr:last-child td{border-bottom:0}.identity-table td strong,.identity-table td small{display:block}.identity-table td strong{font-size:11px}.identity-table td small{font-size:9px;color:var(--id-muted);margin-top:4px;overflow-wrap:anywhere}
.state-pill,.role-pill,.number-pill{display:inline-flex;align-items:center;justify-content:center;padding:4px 8px;border-radius:30px;font-size:10px;font-weight:750;white-space:nowrap}.state-pill.success{background:rgba(25,135,84,.11);color:#198754}.state-pill.warning{background:rgba(217,119,6,.12);color:#b7791f}.state-pill.muted{background:var(--bs-tertiary-bg);color:var(--id-muted)}.role-pill{background:rgba(13,110,253,.09);color:#0d6efd}.number-pill{min-width:25px;background:var(--bs-tertiary-bg)}
.row-actions{margin-top:7px}.row-actions>summary{font-size:10px;color:#176b55;font-weight:750;cursor:pointer}.row-edit-form{display:grid;gap:8px;min-width:210px;padding:10px;margin-top:8px;border:1px solid var(--id-border);border-radius:9px}.inline-action{margin-top:7px}.danger-link,.success-link{border:0;background:transparent;padding:3px 0;font-size:10px;font-weight:750;color:#dc3545}.success-link{color:#198754}
.table-pager{display:flex;align-items:center;justify-content:flex-end;gap:5px;padding:10px 13px;border-top:1px solid var(--id-border);font-size:10px;color:var(--id-muted)}.table-pager button{border:1px solid var(--id-border);border-radius:7px;background:var(--bs-body-bg);color:var(--bs-body-color);padding:5px 9px}.table-pager button:disabled{opacity:.35}.table-pager .page-current{background:var(--bs-tertiary-bg);font-weight:800}
.end-occupancy-form,.revoke-role-form{display:flex;align-items:center;gap:6px;min-width:160px}.end-occupancy-form input,.revoke-role-form input{font-size:10px;padding:6px}.security-footnote{padding:13px 16px;border-top:1px solid var(--id-border);font-size:10px;color:var(--id-muted)}.security-footnote i{color:#198754;margin-left:6px}
