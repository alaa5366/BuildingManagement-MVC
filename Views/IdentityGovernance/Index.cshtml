@model BuildingManagementMvc.Models.IdentityGovernancePage
@{
    ViewData["Title"] = "مركز الهوية والصلاحيات";
    var activePeople = Model.Persons.Count(x => !x.IsArchived);
    var pendingAccounts = Model.Accounts.Count(x => x.Status == 0);
}
<div class="identity-console" dir="rtl">
    <header class="identity-hero">
        <div><div class="identity-eyebrow"><i class="bi bi-shield-check"></i> IDENTITY GOVERNANCE</div><h1>مركز الهوية والصلاحيات</h1><p>إدارة الأشخاص والحسابات والإشغالات والأدوار، مع رقابة أمنية وسجل مرجعي.</p></div>
        <a asp-controller="AccountManagement" asp-action="Index" class="identity-primary-link"><i class="bi bi-key"></i> إدارة الحسابات وPIN</a>
    </header>
    <section class="identity-metrics">
        <article class="metric-card"><span class="metric-icon blue"><i class="bi bi-people"></i></span><div><small>إجمالي الهويات</small><strong>@Model.PersonCount.ToString("N0")</strong><span>@activePeople هوية نشطة ضمن النتائج</span></div></article>
        <article class="metric-card"><span class="metric-icon violet"><i class="bi bi-person-badge"></i></span><div><small>حسابات الدخول</small><strong>@Model.AccountCount.ToString("N0")</strong><span>@pendingAccounts حساب انتظار ضمن النتائج</span></div></article>
        <article class="metric-card"><span class="metric-icon teal"><i class="bi bi-house-check"></i></span><div><small>الإشغالات النشطة</small><strong>@Model.ActiveOccupancyCount.ToString("N0")</strong><span>ارتباطات سكن سارية</span></div></article>
        <article class="metric-card"><span class="metric-icon amber"><i class="bi bi-shield-lock"></i></span><div><small>إسنادات الصلاحيات</small><strong>@Model.ActiveRoleAssignmentCount.ToString("N0")</strong><span>@Model.PendingPhoneChangeCount طلب هاتف معلق</span></div></article>
    </section>
    <section class="identity-toolbar">
        <form asp-action="Index" method="get" class="identity-search"><i class="bi bi-search"></i><input type="search" name="q" value="@Model.SearchTerm" placeholder="ابحث بالاسم أو الهاتف أو البريد أو العمارة أو الشقة أو الدور..." aria-label="بحث شامل" /><button type="submit">بحث</button>@if(!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Index">مسح</a>}</form>
        <div class="identity-search-hint">البحث يشمل الأشخاص والحسابات والإشغالات والأدوار. يمكن تضييق النتائج حسب الحالة.</div>
    </section>
    <nav class="identity-tabs" role="tablist" aria-label="أقسام إدارة الهوية">
        <button type="button" class="identity-tab active" role="tab" aria-selected="true" data-tab="overview"><i class="bi bi-grid-1x2"></i> نظرة عامة</button>
        <button type="button" class="identity-tab" role="tab" aria-selected="false" data-tab="people"><i class="bi bi-people"></i> الأشخاص والهويات <b>@Model.Persons.Count</b></button>
        <button type="button" class="identity-tab" role="tab" aria-selected="false" data-tab="occupancies"><i class="bi bi-houses"></i> الإشغالات والشقق <b>@Model.Occupancies.Count</b></button>
        <button type="button" class="identity-tab" role="tab" aria-selected="false" data-tab="roles"><i class="bi bi-shield-check"></i> الأدوار والصلاحيات <b>@Model.RoleAssignments.Count</b></button>
        <button type="button" class="identity-tab" role="tab" aria-selected="false" data-tab="accounts"><i class="bi bi-person-lock"></i> الحسابات والأمان <b>@Model.Accounts.Count</b></button>
        <button type="button" class="identity-tab" role="tab" aria-selected="false" data-tab="governance"><i class="bi bi-journal-text"></i> السجلات الرقابية</button>
    </nav>
    <main>
        <section class="identity-panel active" id="panel-overview" role="tabpanel">
            <div class="panel-heading"><div><span class="panel-kicker">WORKSPACE</span><h2>ملخص إدارة الهوية</h2><p>كل نوع بيانات له مساحة مستقلة وإجراءات واضحة.</p></div></div>
            <div class="overview-grid">
                <button type="button" class="overview-card" data-open-tab="people"><i class="bi bi-person-vcard blue"></i><strong>الأشخاص والهويات</strong><small>بيانات الأشخاص ووسائل الاتصال والأرشفة</small><b>@Model.PersonCount هوية</b></button>
                <button type="button" class="overview-card" data-open-tab="occupancies"><i class="bi bi-house-check teal"></i><strong>الإشغالات والشقق</strong><small>الشخص والشقة وفترة الإشغال</small><b>@Model.ActiveOccupancyCount إشغال نشط</b></button>
                <button type="button" class="overview-card" data-open-tab="roles"><i class="bi bi-shield-check amber"></i><strong>الأدوار والصلاحيات</strong><small>Resident وBuildingAdmin ونطاق كل صلاحية</small><b>@Model.ActiveRoleAssignmentCount إسناد نشط</b></button>
                <button type="button" class="overview-card" data-open-tab="accounts"><i class="bi bi-person-lock violet"></i><strong>الحسابات والأمان</strong><small>حالة الدخول وPIN و2FA ومؤشرات الحماية</small><b>@Model.AccountCount حساب</b></button>
                <button type="button" class="overview-card" data-open-tab="governance"><i class="bi bi-journal-check slate"></i><strong>السجلات الرقابية</strong><small>الكتالوجات والسجلات التاريخية والتدقيق</small><b>عرض رقابي</b></button>
            </div>
            <div class="identity-note"><i class="bi bi-info-circle"></i><div><strong>العلاقة بين سجلات الهوية</strong><p><b>Person</b> هوية الشخص، <b>UserAccount</b> حساب الدخول، <b>Occupancy</b> علاقة سكن بشقة وفترة، و<b>Role Assignment</b> صلاحية مستقلة بنطاق عمارة أو شقة. يمكن للحساب الواحد الجمع بين عدة أدوار وشقق دون إنشاء هوية ثانية.</p></div></div>
        </section>
        <section class="identity-panel" id="panel-people" role="tabpanel" hidden>
            <div class="panel-heading"><div><span class="panel-kicker">IDENTITY DIRECTORY</span><h2>الأشخاص والهويات</h2><p>إدارة سجل الشخص وبيانات الاتصال، دون خلطه بحساب الدخول.</p></div><button type="button" class="identity-action" data-toggle-details="create-person"><i class="bi bi-plus-lg"></i> إضافة هوية</button></div>
            <details class="identity-create" id="create-person"><summary><i class="bi bi-person-plus"></i> إنشاء سجل شخص جديد</summary>
                <form asp-action="CreatePerson" method="post" class="identity-form">@Html.AntiForgeryToken()
                    <label>اسم العرض<input name="displayName" maxlength="160" required /></label><label>الاسم القانوني<input name="legalName" maxlength="200" /></label><label>رقم الهاتف<input name="phone" maxlength="32" /></label><label>البريد الإلكتروني<input name="email" type="email" maxlength="254" /></label><button type="submit" class="identity-submit">إنشاء الهوية</button><p class="form-hint">إنشاء Person لا ينشئ حساب دخول أو PIN تلقائيًا.</p>
                </form>
            </details>
            <div class="table-card"><div class="table-card-heading"><div><h3>دليل الأشخاص</h3><p>حتى 200 نتيجة مطابقة للبحث</p></div><span>@Model.Persons.Count نتيجة</span></div>
                <div class="table-responsive"><table class="table identity-table" data-identity-table data-server-filtered="true"><thead><tr><th>الشخص</th><th>بيانات الاتصال</th><th>الحساب</th><th>الإشغال</th><th>الأدوار</th><th>الحالة والإجراءات</th></tr></thead><tbody>
                @foreach(var p in Model.Persons)
                {
                    <tr data-state="@(p.IsArchived?"archived":"active")">
                        <td><strong>@p.DisplayName</strong><small>@p.LegalName</small><small>Person: @p.PersonId</small></td>
                        <td>@(p.Phone??"—")<small>@(p.Email??"—")</small></td>
                        <td>@(p.AccountId?.ToString("N")??"لا يوجد")<small>الحالة: @(p.AccountStatus?.ToString()??"—")</small></td>
                        <td><span class="number-pill">@p.ActiveOccupancies</span></td><td><span class="number-pill">@p.ActiveRoles</span></td>
                        <td><span class="state-pill @(p.IsArchived?"muted":"success")">@(p.IsArchived?"مؤرشفة":"نشطة")</span>
                            <details class="row-actions"><summary>إجراءات</summary>
                                <form asp-action="UpdatePerson" method="post" class="row-edit-form">@Html.AntiForgeryToken()<input type="hidden" name="personId" value="@p.PersonId" />
                                    <label>اسم العرض<input name="displayName" value="@p.DisplayName" maxlength="160" required /></label><label>الاسم القانوني<input name="legalName" value="@p.LegalName" maxlength="200" /></label><label>الهاتف<input name="phone" value="@p.Phone" maxlength="32" /></label><label>البريد<input name="email" value="@p.Email" maxlength="254" /></label><button type="submit" class="identity-submit">حفظ التعديلات</button>
                                </form>
                                <form asp-action="SetPersonArchived" method="post" class="inline-action">@Html.AntiForgeryToken()<input type="hidden" name="personId" value="@p.PersonId" /><input type="hidden" name="archived" value="@(!p.IsArchived)" /><button type="submit" class="danger-link" onclick="return confirm('تأكيد تغيير حالة أرشفة الهوية؟')">@(p.IsArchived?"استعادة الهوية":"أرشفة الهوية")</button></form>
                                @if(p.AccountId==null&&p.ActiveOccupancies>0&&!p.IsArchived){<form asp-action="CreatePendingAccount" method="post" class="inline-action">@Html.AntiForgeryToken()<input type="hidden" name="personId" value="@p.PersonId" /><button type="submit" class="success-link" onclick="return confirm('إنشاء حساب انتظار دون PIN؟')">إنشاء حساب انتظار</button></form>}
                            </details>
                        </td>
                    </tr>
                }
                </tbody></table></div><div class="table-pager" data-pager></div>
            </div>
        </section>
        <section class="identity-panel" id="panel-occupancies" role="tabpanel" hidden>
            <div class="panel-heading"><div><span class="panel-kicker">RESIDENTIAL RECORDS</span><h2>الإشغالات والشقق</h2><p>كل إشغال يربط شخصًا بشقة محددة داخل عمارة ولفترة زمنية.</p></div></div>
            <details class="identity-create"><summary><i class="bi bi-house-add"></i> تسجيل إشغال جديد</summary>
                <form asp-action="CreateOccupancy" method="post" class="identity-form">@Html.AntiForgeryToken()
                    <label>الشخص<select name="personId" required><option value="">اختر الشخص</option>@foreach(var p in Model.Persons.Where(x=>!x.IsArchived)){<option value="@p.PersonId">@p.DisplayName — @p.Phone</option>}</select></label>
                    <label>العمارة<select name="buildingId" id="identityGovernanceBuildingId" required><option value="">اختر العمارة</option>@foreach(var b in Model.Buildings){<option value="@b.Key">@b.Title — @b.Detail</option>}</select></label>
                    <label>الشقة<select name="apartmentId" id="identityGovernanceApartmentId" required><option value="">اختر الشقة</option>@foreach(var a in Model.Apartments){var parts=a.Key.Split('|',2);if(parts.Length==2){<option value="@parts[1]" data-building-id="@parts[0]">@a.Title</option>}}</select></label>
                    <label>نوع الإشغال<select name="occupancyType"><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label><label>بداية الإشغال<input name="validFromUtc" type="datetime-local" required /></label><label class="check-label"><input type="checkbox" name="isPrimary" value="true" /> إشغال أساسي</label><label class="wide-field">ملاحظات أو مرجع المستند<input name="notes" maxlength="1000" /></label><button type="submit" class="identity-submit">حفظ الإشغال</button>
                </form>
            </details>
            <div class="table-card"><div class="table-card-heading"><div><h3>سجل الإشغالات</h3><p>الحالي والتاريخي — حتى 300 نتيجة</p></div><span>@Model.Occupancies.Count نتيجة</span></div>
                <div class="table-responsive"><table class="table identity-table" data-identity-table data-server-filtered="true"><thead><tr><th>الشخص</th><th>العمارة</th><th>الشقة</th><th>النوع</th><th>الفترة</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody>
                @foreach(var o in Model.Occupancies){<tr data-state="@(o.IsCurrent?"active":"historical")"><td><strong>@o.PersonName</strong><small>@o.PersonId</small></td><td><strong>@o.BuildingName</strong><small>@o.BuildingId</small></td><td><strong>شقة @o.ApartmentNumber</strong><small>@o.ApartmentId</small> @(o.IsPrimary?" · أساسي":"")</td><td>@o.OccupancyType</td><td>@o.ValidFromUtc.ToString("yyyy-MM-dd")<small>إلى @(o.ValidToUtc?.ToString("yyyy-MM-dd")??"مفتوح")</small></td><td><span class="state-pill @(o.IsCurrent?"success":"muted")">@(o.IsCurrent?"نشط":"تاريخي")</span></td><td>@if(o.ValidToUtc==null){<form asp-action="EndOccupancy" method="post" class="end-occupancy-form">@Html.AntiForgeryToken()<input type="hidden" name="occupancyId" value="@o.OccupancyId" /><input name="validToUtc" type="datetime-local" required aria-label="تاريخ انتهاء الإشغال" /><button type="submit" class="danger-link">إنهاء</button></form>}</td></tr>}
                </tbody></table></div><div class="table-pager" data-pager></div>
            </div>
        </section>
        <section class="identity-panel" id="panel-roles" role="tabpanel" hidden>
            <div class="panel-heading"><div><span class="panel-kicker">ACCESS CONTROL</span><h2>الأدوار والصلاحيات</h2><p>الإسناد يحدد الدور والنطاق؛ الحساب الواحد يمكنه امتلاك أكثر من دور ونطاق.</p></div></div>
            <details class="identity-create"><summary><i class="bi bi-shield-plus"></i> منح صلاحية جديدة</summary>
                <form asp-action="GrantRole" method="post" class="identity-form">@Html.AntiForgeryToken()
                    <label>الحساب<select name="accountId" required><option value="">اختر الحساب</option>@foreach(var a in Model.Accounts){<option value="@a.AccountId">@a.PersonName — @a.Status</option>}</select></label>
                    <label>الدور<select name="roleKey" required><option value="">اختر الدور</option>@foreach(var r in Model.RoleCatalog.Where(x=>x.Status=="Active"&&x.Key!="superadmin")){<option value="@r.Key">@r.Title (@r.Key)</option>}</select></label>
                    <label>نطاق الصلاحية<select name="scopeType" id="identityScopeType"><option value="1">عمارة</option><option value="2">شقة</option><option value="3">شخصي</option></select></label>
                    <label>العمارة<select name="buildingId" id="identityRoleBuilding"><option value="">اختر العمارة</option>@foreach(var b in Model.Buildings){<option value="@b.Key">@b.Detail — @b.Title</option>}</select></label>
                    <label>الشقة<select name="apartmentId" id="identityRoleApartment"><option value="">اختر الشقة</option>@foreach(var a in Model.Apartments){var parts=a.Key.Split('|',2);if(parts.Length==2){<option value="@parts[1]" data-building-id="@parts[0]">@a.Title</option>}}</select></label>
                    <label>بداية الصلاحية<input name="validFromUtc" type="datetime-local" required /></label><label class="wide-field">سبب المنح<input name="reason" maxlength="500" required /></label><button type="submit" class="identity-submit">منح الصلاحية</button><p class="form-hint">لا يمكن منح SuperAdmin من هنا. صلاحية Resident تتطلب إشغالًا نشطًا مطابقًا للشقة.</p>
                </form>
            </details>
            <div class="table-card"><div class="table-card-heading"><div><h3>سجل إسنادات الأدوار</h3><p>كل إسناد مع نطاقه وفترة سريانه</p></div><span>@Model.RoleAssignments.Count نتيجة</span></div>
                <div class="table-responsive"><table class="table identity-table" data-identity-table data-server-filtered="true"><thead><tr><th>الشخص</th><th>الدور</th><th>النطاق</th><th>الفترة</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody>
                @foreach(var r in Model.RoleAssignments){<tr data-state="@(r.RevokedAtUtc==null&&(r.ValidToUtc==null||r.ValidToUtc>DateTime.UtcNow)?"active":"inactive")"><td><strong>@r.PersonName</strong><small>@r.AccountId</small></td><td><span class="role-pill">@r.RoleKey</span></td><td>@(r.ScopeType==1?"عمارة":r.ScopeType==2?"شقة":r.ScopeType==3?"شخصي":"نظام")<strong>@r.BuildingName</strong><small>@(r.ApartmentNumber==null?"—":"شقة "+r.ApartmentNumber)</small></td><td>@r.ValidFromUtc.ToString("yyyy-MM-dd")<small>إلى @(r.ValidToUtc?.ToString("yyyy-MM-dd")??"مفتوح")</small></td><td><span class="state-pill @(r.RevokedAtUtc==null?"success":"muted")">@(r.RevokedAtUtc==null?"غير ملغى":"ملغى")</span></td><td>@if(r.RevokedAtUtc==null&&r.RoleKey!="superadmin"){<form asp-action="RevokeRole" method="post" class="revoke-role-form">@Html.AntiForgeryToken()<input type="hidden" name="assignmentId" value="@r.AssignmentId" /><input name="reason" maxlength="500" placeholder="سبب الإلغاء" required /><button type="submit" class="danger-link">إلغاء</button></form>}</td></tr>}
                </tbody></table></div><div class="table-pager" data-pager></div>
            </div>
        </section>
        <section class="identity-panel" id="panel-accounts" role="tabpanel" hidden>
            <div class="panel-heading"><div><span class="panel-kicker">ACCOUNT SECURITY</span><h2>الحسابات والأمان</h2><p>حالة الحساب ووسائل الدخول ومؤشرات الحماية دون عرض أي أسرار.</p></div><a asp-controller="AccountManagement" asp-action="Index" class="identity-action"><i class="bi bi-key"></i> فتح مركز PIN</a></div>
            <div class="table-card"><div class="table-card-heading"><div><h3>حسابات المستخدمين</h3><p>بيانات الاعتماد وحالة المصادقة</p></div><span>@Model.Accounts.Count حساب</span></div>
                <div class="table-responsive"><table class="table identity-table" data-identity-table data-server-filtered="true"><thead><tr><th>صاحب الحساب</th><th>الحالة</th><th>PIN</th><th>آخر دخول</th><th>اعتمادات نشطة</th><th>2FA</th><th>Recovery</th><th>تفضيلات</th></tr></thead><tbody>
                @foreach(var a in Model.Accounts){<tr data-state="@(a.Status==1?"active":"pending")"><td><strong>@a.PersonName</strong><small>@a.PersonId</small><small>@a.AccountId</small></td><td><span class="state-pill @(a.Status==1?"success":"warning")">@(a.Status==1?"نشط":a.Status==0?"انتظار":"موقوف")</span></td><td>@(a.MustChangePin?"يتطلب تغييرًا":"مهيأ")</td><td>@(a.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm")??"لم يسجل")</td><td>@a.ActiveCredentials</td><td><span class="state-pill @(a.TwoFactorEnabled?"success":"muted")">@(a.TwoFactorEnabled?"مفعل":"غير مفعل")</span></td><td>@a.UnusedRecoveryCodes غير مستخدم</td><td>@a.PreferenceCount</td></tr>}
                </tbody></table></div><div class="table-pager" data-pager></div><div class="security-footnote"><i class="bi bi-shield-lock"></i> لا يتم عرض PIN hashes أو أسرار 2FA أو قيم Recovery Codes. إدارة PIN من مركز الحسابات.</div>
            </div>
        </section>
        <section class="identity-panel" id="panel-governance" role="tabpanel" hidden>
            <div class="panel-heading"><div><span class="panel-kicker">AUDIT & REFERENCE</span><h2>السجلات الرقابية والمرجعية</h2><p>بيانات قراءة ومراجعة؛ سجلات التدقيق والأسرار غير قابلة للتحرير من هنا.</p></div></div>
            <div class="reference-grid">
                <article class="reference-card"><header><div><h3>تعريفات الأدوار</h3><p>RoleDefinitions · كتالوج النظام</p></div><span>@Model.RoleCatalog.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><thead><tr><th>الدور</th><th>النوع</th><th>الحالة</th></tr></thead><tbody>@foreach(var x in Model.RoleCatalog){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Key</small></td><td>@x.Detail</td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>صلاحيات الأدوار</h3><p>RolePermissions · Allow / Deny</p></div><span>@Model.PermissionCatalog.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><thead><tr><th>الدور والصلاحية</th><th>التأثير</th></tr></thead><tbody>@foreach(var x in Model.PermissionCatalog){<tr data-state="@x.Status.ToLowerInvariant()"><td>@x.Key</td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>استثناءات الصلاحيات</h3><p>AccountPermissionOverrides</p></div><span>@Model.PermissionOverrides.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><tbody>@foreach(var x in Model.PermissionOverrides){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Detail</small></td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>منح الوصول للشقق</h3><p>ApartmentAccessGrants</p></div><span>@Model.ApartmentAccessGrants.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><tbody>@foreach(var x in Model.ApartmentAccessGrants){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Detail</small></td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>ملكية الشقق</h3><p>ApartmentOwnerships</p></div><span>@Model.OwnershipRecords.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><tbody>@foreach(var x in Model.OwnershipRecords){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Detail</small></td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>الربط التاريخي</h3><p>LegacyIdentityMap</p></div><span>@Model.LegacyMappings.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><tbody>@foreach(var x in Model.LegacyMappings){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Detail</small></td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>جلسات الحضور</h3><p>PresenceSessions · قراءة فقط</p></div><span>@Model.PresenceSessions.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><tbody>@foreach(var x in Model.PresenceSessions){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Detail</small></td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>سجل التدقيق</h3><p>AuditEvents · Append-only</p></div><span>@Model.AuditEvents.Count</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><tbody>@foreach(var x in Model.AuditEvents){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Detail</small></td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
                <article class="reference-card"><header><div><h3>طلبات تصحيح الهاتف</h3><p>PersonPhoneChangeRequests</p></div><span>@Model.PendingPhoneChangeCount معلق</span></header><div class="table-responsive"><table class="table identity-table compact-table" data-identity-table><tbody>@foreach(var x in Model.PhoneChangeRequests){<tr data-state="@x.Status.ToLowerInvariant()"><td><strong>@x.Title</strong><small>@x.Detail</small></td><td>@x.Status</td></tr>}</tbody></table></div><div class="table-pager" data-pager></div></article>
            </div>
        </section>
    </main>
    <footer class="identity-footer"><span>Identity Governance Center</span><span>المعلومات الحساسة محمية · السجلات الرقابية للقراءة فقط</span></footer>
</div>
