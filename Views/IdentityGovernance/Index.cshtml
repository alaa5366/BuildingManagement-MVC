<script>
(() => {
    const tabs=[...document.querySelectorAll('.identity-tab')], panels=[...document.querySelectorAll('.identity-panel')];
    const activate=name=>{
        tabs.forEach(tab=>{const on=tab.dataset.tab===name;tab.classList.toggle('active',on);tab.setAttribute('aria-selected',on?'true':'false');});
        panels.forEach(panel=>{const on=panel.id==='panel-'+name;panel.classList.toggle('active',on);panel.hidden=!on;});
    };
    tabs.forEach(tab=>tab.addEventListener('click',()=>activate(tab.dataset.tab)));
    document.querySelectorAll('[data-open-tab]').forEach(button=>button.addEventListener('click',()=>activate(button.dataset.openTab)));
    document.querySelectorAll('[data-toggle-details]').forEach(button=>button.addEventListener('click',()=>{const target=document.getElementById(button.dataset.toggleDetails);if(target){target.open=true;target.scrollIntoView({behavior:'smooth',block:'center'});}}));
    const search=document.querySelector('.identity-search input[name="q"]'), filter=document.createElement('select');
    filter.className='identity-state-filter';filter.setAttribute('aria-label','تصفية حسب الحالة');
    filter.innerHTML='<option value="">كل الحالات</option><option value="active">نشط</option><option value="archived">مؤرشف</option><option value="inactive">غير نشط</option><option value="pending">انتظار</option><option value="historical">تاريخي</option>';
    document.querySelector('.identity-search').appendChild(filter);
    const tables=[...document.querySelectorAll('[data-identity-table]')], size=10;
    const submittedTerm=(search?.value||'').trim().toLocaleLowerCase();
    const refresh=()=>{
        const rawTerm=(search?.value||'').trim().toLocaleLowerCase();
        const state=filter.value;
        tables.forEach(table=>{
            const term=rawTerm===submittedTerm&&table.dataset.serverFiltered==='true'?'':rawTerm;
            const digits=term.replace(/[^0-9]/g,'');
            const phoneDigits=digits.length>=7?(digits.startsWith('0')?'20'+digits.slice(1):digits):'';
            const rows=[...table.querySelectorAll('tbody tr')], matches=rows.filter(row=>{
                const rowText=row.innerText.toLocaleLowerCase(), rowDigits=rowText.replace(/\D/g,'');
                const textMatch=!term||rowText.includes(term)||(phoneDigits&&rowDigits.includes(phoneDigits));
                return (!state||(row.dataset.state||'').toLowerCase()===state)&&textMatch;
            });
            const pager=table.closest('.table-card,.reference-card')?.querySelector('[data-pager]'), pages=Math.max(1,Math.ceil(matches.length/size));
            const page=Math.min(Number(table.dataset.page||1),pages);table.dataset.page=String(page);rows.forEach(row=>row.hidden=true);matches.slice((page-1)*size,page*size).forEach(row=>row.hidden=false);
            if(pager){pager.replaceChildren();const label=document.createElement('span');label.textContent=matches.length?((page-1)*size+1)+'–'+Math.min(page*size,matches.length)+' من '+matches.length:'لا توجد نتائج';pager.append(label);
                if(pages>1){const prev=document.createElement('button');prev.type='button';prev.textContent='السابق';prev.disabled=page<=1;prev.onclick=()=>{table.dataset.page=String(page-1);refresh();};const next=document.createElement('button');next.type='button';next.textContent='التالي';next.disabled=page>=pages;next.onclick=()=>{table.dataset.page=String(page+1);refresh();};const current=document.createElement('span');current.className='page-current';current.textContent=page+' / '+pages;pager.append(prev,current,next);}
            }
        });
    };
    search?.addEventListener('input',()=>{tables.forEach(t=>t.dataset.page='1');refresh();});filter.addEventListener('change',()=>{tables.forEach(t=>t.dataset.page='1');refresh();});refresh();
    const filterApartments=(building,apartment)=>{
        if(!building||!apartment)return;const selected=building.value;
        [...apartment.options].forEach(option=>{if(!option.value)return;const ok=!selected||option.dataset.buildingId===selected;option.hidden=!ok;option.disabled=!ok;});
        const current=apartment.selectedOptions[0];if(current?.value&&current.dataset.buildingId!==selected)apartment.value='';
    };
    const b=document.getElementById('identityGovernanceBuildingId'),a=document.getElementById('identityGovernanceApartmentId');
    if(b&&a){b.addEventListener('change',()=>filterApartments(b,a));filterApartments(b,a);}
    const rb=document.getElementById('identityRoleBuilding'),ra=document.getElementById('identityRoleApartment'),scope=document.getElementById('identityScopeType');
    const sync=()=>{filterApartments(rb,ra);if(ra)ra.disabled=scope?.value!=='2';if(rb)rb.disabled=scope?.value==='3';};
    rb?.addEventListener('change',sync);scope?.addEventListener('change',sync);sync();
})();
</script>