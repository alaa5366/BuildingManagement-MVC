@@media(max-width:1050px){.identity-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.overview-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:650px){.identity-hero{align-items:flex-start;flex-direction:column;padding:20px}.identity-hero h1{font-size:21px}.identity-metrics{gap:8px}.metric-card{padding:11px;gap:8px;min-height:85px}.metric-icon{width:35px;height:35px;flex-basis:35px}.metric-card strong{font-size:20px}.overview-grid,.reference-grid{grid-template-columns:1fr}.panel-heading{align-items:flex-start;flex-direction:column}.identity-form{grid-template-columns:1fr}.identity-form .wide-field{grid-column:auto}.identity-search{flex-wrap:wrap}.identity-search input{flex-basis:calc(100% - 40px)}.identity-search button{margin-right:auto}.identity-footer{flex-direction:column}}
