@{
    ViewData["Title"] = "الخصوصية وحماية البيانات";
}

<div class="container py-5" style="max-width: 860px">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 mb-3">الخصوصية وحماية البيانات</h1>
            <p class="text-muted mb-4">معلومات عامة لمستخدمي نظام إدارة المباني.</p>
            <p>
                تُستخدم البيانات التي تدخلها في النظام لتشغيل خدمات إدارة المبنى، وإدارة الحسابات،
                ومتابعة الطلبات والمعاملات المرتبطة بالمبنى وفقًا للصلاحيات الممنوحة لكل دور.
            </p>
            <p>
                لا تشارك بيانات الدخول أو رموز التحقق مع أي شخص. إذا احتجت إلى معرفة تفاصيل
                الاحتفاظ بالبيانات أو طلب تصحيحها، يُرجى التواصل مع مسؤول النظام أو إدارة المبنى.
            </p>
            <a asp-controller="Account" asp-action="UnifiedLogin" class="btn btn-outline-primary mt-3">
                العودة إلى تسجيل الدخول
            </a>
        </div>
    </div>
</div>
