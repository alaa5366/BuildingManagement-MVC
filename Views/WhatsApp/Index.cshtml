@{
    ViewData["Title"] = Loc.T("WhatsApp_Messages");
    var building = (Building)ViewBag.Building;
    var templates = (Dictionary<string, (string Name, string Text)>)ViewBag.Templates;
}

<h3 class="mb-3">@Loc.T("WhatsApp_Messages_N", building.Name)</h3>

<div class="bg-white rounded shadow-sm p-3">
    <form method="post" asp-action="Generate">
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label small">@Loc.T("Apartment")</label>
                <select name="aptId" class="form-select" required>
                    @foreach (var apt in building.Apartments.OrderBy(a => a.Number))
                    {
                        <option value="@apt.Id">@Loc.T("Apartment_N_N_2", apt.Number, string.IsNullOrEmpty(apt.Owner) ? "" : "— " + apt.Owner)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small">@Loc.T("Template")</label>
                <select name="templateId" class="form-select" required>
                    @foreach (var kv in templates)
                    {
                        <option value="@kv.Key">@kv.Value.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small">@Loc.T("Amount_If_Needed")</label>
                <input name="amount" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">@Loc.T("Description_Note_If_Needed")</label>
                <input name="note" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">@Loc.T("Apartment_Share_If_Needed")</label>
                <input name="share" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">@Loc.T("General_Message_If_You_Chose_General")</label>
                <input name="message" class="form-control" />
            </div>
        </div>
        <button class="btn btn-brand mt-3">@Loc.T("Generate_Message")</button>
    </form>
</div>
