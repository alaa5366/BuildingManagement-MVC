@model BuildingManagementMvc.Models.WhatsAppResultViewModel
@{
    ViewData["Title"] = Loc.T("Message_Ready");
}

<h3 class="mb-3">@Loc.T("Message_For_Apartment_N", Model.ApartmentNumber)</h3>

<div class="bg-white rounded shadow-sm p-3 mb-3">
    <pre style="white-space:pre-wrap; font-family:inherit;">@Model.Message</pre>
</div>

<a href="@Model.Link" target="_blank" rel="noopener noreferrer" class="btn btn-brand">@Loc.T("Open_WhatsApp_And_Send")</a>
<a asp-action="Index" class="btn btn-link">@Loc.T("Back_3")</a>
