@model List<BuildingManagementMvc.Services.PhoneCorrectionQueueItem>
@{
    ViewData["Title"] = "طلبات تصحيح أرقام الهاتف";
}
<div class="container-fluid py-4">
    <h2>طلبات تصحيح أرقام الهاتف</h2>
    @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>الاسم</th><th>العمارة</th><th>الشقة</th><th>الرقم الحالي</th><th>الرقم الجديد</th><th>تاريخ الطلب</th><th>القرار</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PersonName</td><td>@item.BuildingId</td><td>@item.ApartmentId</td>
                    <td dir="ltr">@item.PreviousPhone</td><td dir="ltr">@item.RequestedPhone</td>
                    <td>@item.RequestedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>
                        <form method="post" asp-action="Review" class="d-flex gap-1 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@item.RequestId" />
                            <input type="hidden" name="buildingId" value="@item.BuildingId" />
                            <input name="reason" class="form-control form-control-sm" placeholder="سبب القرار (مطلوب)" maxlength="500" required />
                            <button class="btn btn-sm btn-success" name="approve" value="true">موافقة</button>
                            <button class="btn btn-sm btn-outline-danger" name="approve" value="false">رفض</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7">لا توجد طلبات معلقة.</td></tr> }
            </tbody>
        </table>
    </div>
</div>