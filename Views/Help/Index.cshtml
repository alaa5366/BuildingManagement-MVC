<style>
    .help-container {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }

    @@media (max-width: 900px) {
        .help-container {
            grid-template-columns: 1fr;
        }

        .help-toc {
            position: static !important;
        }
    }

    .help-toc {
        position: sticky;
        top: 20px;
        align-self: start;
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        max-height: calc(100vh - 40px);
        overflow-y: auto;
    }

        .help-toc h5 {
            color: #12433C;
            font-weight: 700;
            margin-bottom: 12px;
            border-bottom: 2px solid #12433C;
            padding-bottom: 8px;
        }

        .help-toc a {
            display: block;
            padding: 8px 12px;
            color: #555;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.2s;
            margin-bottom: 2px;
        }

            .help-toc a:hover {
                background: #F0F5F3;
                color: #12433C;
                padding-right: 18px;
            }

            .help-toc a.sub {
                padding-right: 28px;
                font-size: 13px;
                color: #777;
            }

    .help-content {
        background: white;
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        line-height: 1.9;
    }

        .help-content h1 {
            color: #12433C;
            font-weight: 700;
            margin-bottom: 30px;
            font-size: 32px;
        }

        .help-content h2 {
            color: #12433C;
            font-weight: 700;
            margin-top: 40px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #B9853B;
            font-size: 24px;
            scroll-margin-top: 20px;
        }

        .help-content h3 {
            color: #1a5a50;
            font-weight: 600;
            margin-top: 25px;
            margin-bottom: 10px;
            font-size: 18px;
            scroll-margin-top: 20px;
        }

        .help-content p {
            margin-bottom: 12px;
            color: #333;
        }

        .help-content ul, .help-content ol {
            margin-bottom: 15px;
            padding-right: 25px;
        }

        .help-content li {
            margin-bottom: 6px;
        }

        .help-content code {
            background: #F0F0F0;
            padding: 2px 8px;
            border-radius: 4px;
            font-family: Consolas, monospace;
            color: #A0432A;
            font-size: 13px;
        }

        .help-content .badge-step {
            display: inline-block;
            background: #12433C;
            color: white;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            text-align: center;
            line-height: 24px;
            font-size: 13px;
            font-weight: 700;
            margin-left: 6px;
        }

        .help-content .alert-help {
            background: #FFF3CD;
            border-right: 4px solid #D9B34A;
            padding: 15px 20px;
            border-radius: 8px;
            margin: 15px 0;
        }

        .help-content .alert-tip {
            background: #DCEAE5;
            border-right: 4px solid #2E7D5B;
            padding: 15px 20px;
            border-radius: 8px;
            margin: 15px 0;
        }

        .help-content .alert-warning {
            background: #FCE9E4;
            border-right: 4px solid #A0432A;
            padding: 15px 20px;
            border-radius: 8px;
            margin: 15px 0;
        }

        .help-content table {
            width: 100%;
            margin: 15px 0;
            border-collapse: collapse;
        }

            .help-content table th {
                background: #12433C;
                color: white;
                padding: 10px;
                text-align: right;
                font-weight: 600;
            }

            .help-content table td {
                padding: 10px;
                border-bottom: 1px solid #eee;
            }

            .help-content table tr:nth-child(even) {
                background: #F9F9F9;
            }

        .help-content .back-top {
            display: inline-block;
            margin-top: 20px;
            color: #12433C;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

            .help-content .back-top:hover {
                text-decoration: underline;
            }
</style>

