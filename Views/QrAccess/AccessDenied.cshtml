@{ ViewData["Title"] = Loc.T("Could_Not_Log_In"); }

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div style="font-size:48px;">🚫</div>
        <h3 class="mt-2">@Loc.T("Could_Not_Log_In")</h3>
        <p class="text-muted">@ViewBag.Error</p>
        <a asp-controller="Account" asp-action="LoginChoice" class="btn btn-brand">@Loc.T("Regular_Login_2")</a>
    </div>
</div>
