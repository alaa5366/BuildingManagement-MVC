@{
    ViewData["Title"] = Loc.T("Wallet_2");
    var building = (Building)ViewBag.Building;
    string month = ViewBag.Month;
    var balances = (BuildingManagementMvc.Models.PagedResult<(BuildingManagementMvc.Models.Apartment Apt, double Balance)>)ViewBag.Balances;
    var pending = (BuildingManagementMvc.Models.PagedResult<(BuildingManagementMvc.Models.Apartment Apt, BuildingManagementMvc.Models.Deposit Deposit)>)ViewBag.Pending;
    var totals = ((double Collected, double Expenses, double Revenues, int OpenCount, int ClosedCount, double Balance, double TotalWallet))ViewBag.Totals;
    var routeValues = ViewBag.RouteValues as Dictionary<string, string?> ?? new();
    var routeValuesStr = new Dictionary<string, string>();
    foreach (var kv in routeValues)
        if (!string.IsNullOrWhiteSpace(kv.Value))
            routeValuesStr[kv.Key] = kv.Value!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@Loc.T("Wallet_Of_N", building.Name)</h3>
    <form method="get" class="d-flex gap-2">
        <input type="hidden" name="pageSize" value="@balances.PageSize" />
        <input type="month" name="month" value="@month" class="form-control" onchange="this.form.submit()" />
    </form>
</div>

<div class="row mb-3 text-center">
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Collected")</div><div class="fw-bold">@totals.Collected.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Expenses_3")</div><div class="fw-bold">@totals.Expenses.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Revenues")</div><div class="fw-bold">@totals.Revenues.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">@Loc.T("Wallet_Total")</div><div class="fw-bold">@totals.TotalWallet.ToString("0.##")</div></div></div>
</div>

@* ============================================================ *@
@* ✅ دفعات في انتظار التأكيد                                  *@
@* ============================================================ *@
@if (pending.TotalItems > 0)
{
    <div class="bg-white rounded shadow-sm p-3 mb-3">
        <h5>@Loc.T("Payments_Awaiting_Confirmation_N", pending.TotalItems)</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Loc.T("Apartment")</th>
                    <th>@Loc.T("Payment_Number")</th>
                    <th>@Loc.T("Amount")</th>
                    <th>@Loc.T("Note")</th>
                    <th>@Loc.T("Receipt")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (apt, dep) in pending.Items)
                {
                    <tr>
                        <td>@Loc.T("Apartment_N", apt.Number)</td>
                        <td>@dep.Number</td>
                        <td>@dep.Amount.ToString("0.##")</td>
                        <td>
                            @dep.Note
                            @if (!string.IsNullOrWhiteSpace(dep.UpdateReason))
                            {
                                <div class="small text-warning mt-1">
                                    @Loc.T("Edited_N", dep.UpdateReason)
                                </div>
                            }
                        </td>
                        <td>
                            @if (dep.Receipt?.Success == true)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#receiptModal"
                                        data-receipt-url="@dep.Receipt.Url"
                                        data-receipt-name="@Loc.T("N_Apartment_N", dep.Number, apt.Number)"
                                        title="@Loc.T("View_Receipt")">
                                    @Loc.T("View_3")
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="d-flex gap-1">
                            <form method="post" asp-action="ConfirmDeposit">
                                <input type="hidden" name="month" value="@month" />
                                <input type="hidden" name="depositId" value="@dep.Id" />
                                <button class="btn btn-sm btn-success">@Loc.T("Confirm")</button>
                            </form>
                            <form method="post" asp-action="CancelDeposit" onsubmit="return confirm('@Loc.Js("Cancel_The_Payment")');">
                                <input type="hidden" name="month" value="@month" />
                                <input type="hidden" name="depositId" value="@dep.Id" />
                                <button class="btn btn-sm btn-outline-danger">@Loc.T("Cancel")</button>
                            </form>

                            @* ✅ Phase 21: زر تعديل الدفعة *@
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal" data-bs-target="#editDepositModal"
                                    data-deposit-id="@dep.Id"
                                    data-deposit-number="@dep.Number"
                                    data-deposit-amount="@dep.Amount.ToString("0.##")"
                                    data-deposit-note="@dep.Note"
                                    data-deposit-month="@month"
                                    data-deposit-apt="@Loc.T("Apartment_N", apt.Number)">
                                @Loc.T("Edit_2")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ============================================================ *@
@* ✅ أرصدة الشقق + Pagination                                  *@
@* ============================================================ *@
<div class="bg-white rounded shadow-sm p-3">
    <h5>@Loc.T("Apartment_Balances_N", balances.TotalItems)</h5>

    @* ✅ Pagination (فوق) *@
    @{
        ViewData["CurrentPage"] = balances.CurrentPage;
        ViewData["PageSize"] = balances.PageSize;
        ViewData["TotalItems"] = balances.TotalItems;
        ViewData["TotalPages"] = balances.TotalPages;
        ViewData["HasPrevious"] = balances.HasPrevious;
        ViewData["HasNext"] = balances.HasNext;
        ViewData["FirstItemIndex"] = balances.FirstItemIndex;
        ViewData["LastItemIndex"] = balances.LastItemIndex;
        ViewData["ActionName"] = "Index";
        ViewData["ControllerName"] = "Wallet";
        ViewData["RouteValues"] = routeValuesStr;
        ViewData["PageSizeOptions"] = new[] { 10, 25, 50, 100 };
    }
    @await Html.PartialAsync("_Pagination")

    @{
        var floorOrderMap = building.Floors.ToDictionary(f => f.Id, f => f.Order);
        var balancesByFloor = balances.Items
            .GroupBy(b => b.Apt.FloorId)
            .OrderBy(g => floorOrderMap.GetValueOrDefault(g.Key, int.MaxValue));
    }

    @foreach (var floorGroup in balancesByFloor)
    {
        var floor = building.Floors.FirstOrDefault(f => f.Id == floorGroup.Key);
        <h6 class="mt-3 mb-2 text-primary">
            🏢 @(floor?.Label ?? Loc.T("Unknown_Floor"))
        </h6>
        <table class="table table-sm">
            <thead>
                <tr><th>@Loc.T("Apartment")</th><th>@Loc.T("Balance")</th><th>@Loc.T("Manual_Adjustment")</th></tr>
            </thead>
            <tbody>
                @foreach (var (apt, balance) in floorGroup.OrderBy(b => b.Apt.Number))
                {
                    <tr>
                        <td>@Loc.T("Apartment_N_N_2", apt.Number, string.IsNullOrEmpty(apt.Label) ? "" : "— " + apt.Label)</td>
                        <td class="@(balance < 0 ? "text-danger" : "text-success") fw-bold">@balance.ToString("0.##")</td>
                        <td>
                            <form method="post" asp-action="AddAdjustment" class="d-flex gap-1">
                                <input type="hidden" name="month" value="@month" />
                                <input type="hidden" name="aptId" value="@apt.Id" />
                                <input name="amount" type="number" step="0.01" class="form-control form-control-sm" placeholder="@Loc.T("Amount_3")" style="width:110px" />
                                <input name="reason" class="form-control form-control-sm" placeholder="@Loc.T("Reason")" />
                                <button class="btn btn-sm btn-outline-secondary text-nowrap">@Loc.T("Adjustment_2")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ✅ Pagination (تحت) *@
    @await Html.PartialAsync("_Pagination")
</div>

<!-- ============================================================ -->
<!-- ✅ Modal لعرض الإيصال                                          -->
<!-- ============================================================ -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="receiptModalTitle">@Loc.T("Payment_Receipt")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc.T("Close")"></button>
            </div>
            <div class="modal-body text-center">
                <img id="receiptImage" src="" alt="@Loc.T("Receipt_2")" class="img-fluid rounded" style="max-height: 70vh;" />
            </div>
            <div class="modal-footer">
                <a id="receiptOpenLink" href="" target="_blank" class="btn btn-sm btn-outline-primary">
                    @Loc.T("Open_In_A_New_Tab")
                </a>
                <a id="receiptDownloadLink" href="" download class="btn btn-sm btn-outline-success">
                    @Loc.T("Download")
                </a>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@Loc.T("Close")</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- ✅ Phase 21: Modal لتعديل الدفعة المعلقة                       -->
<!-- ============================================================ -->
<div class="modal fade" id="editDepositModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form method="post" asp-action="UpdateDeposit" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="month" id="editMonth" />
            <input type="hidden" name="depositId" id="editDepositId" />

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@Loc.T("Edit_Payment")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-info small mb-3">
                    <strong id="editDepositNumber"></strong> — <span id="editDepositApt"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Loc.T("Amount_EGP")</label>
                        <input type="number" name="amount" id="editAmount"
                               class="form-control form-control-lg"
                               step="0.01" min="0.01" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Html.Raw(Loc.T("Reason_For_The_Edit"))</label>
                        <input type="text" name="reason" id="editReason"
                               class="form-control form-control-lg"
                               maxlength="200" required
                               placeholder="@Loc.T("Example_Correcting_The_Amount_Based_On")" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">@Loc.T("Note_2")</label>
                        <textarea name="note" id="editNote"
                                  class="form-control" rows="2"
                                  maxlength="500"
                                  placeholder="@Loc.T("Note_On_The_Payment_Optional")"></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                <button type="submit" class="btn btn-primary">@Loc.T("Save_Changes_2")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ============================================================
        // Modal الإيصال
        // ============================================================
        var receiptModal = document.getElementById('receiptModal');
        receiptModal.addEventListener('show.bs.modal', function(event) {
            var button = event.relatedTarget;
            var url = button.getAttribute('data-receipt-url');
            var name = button.getAttribute('data-receipt-name');

            document.getElementById('receiptModalTitle').innerText = '📎 @Html.Raw(Loc.Js("Receipt_2")) ' + name;
            document.getElementById('receiptImage').src = url;
            document.getElementById('receiptOpenLink').href = url;
            document.getElementById('receiptDownloadLink').href = url;
        });

        receiptModal.addEventListener('hidden.bs.modal', function() {
            document.getElementById('receiptImage').src = '';
        });

        // ============================================================
        // ✅ Phase 21 — Modal تعديل الدفعة
        // ============================================================
        var editModal = document.getElementById('editDepositModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function(event) {
                var btn = event.relatedTarget;

                document.getElementById('editDepositId').value = btn.getAttribute('data-deposit-id');
                document.getElementById('editMonth').value = btn.getAttribute('data-deposit-month');
                document.getElementById('editDepositNumber').innerText = btn.getAttribute('data-deposit-number');
                document.getElementById('editDepositApt').innerText = btn.getAttribute('data-deposit-apt');
                document.getElementById('editAmount').value = btn.getAttribute('data-deposit-amount');
                document.getElementById('editNote').value = btn.getAttribute('data-deposit-note') || '';
                document.getElementById('editReason').value = '';
            });
        }
    </script>
}