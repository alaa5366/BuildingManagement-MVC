@{
    ViewData["Title"] = "المحفظة";
    var building = (Building)ViewBag.Building;
    string month = ViewBag.Month;
    var balances = (List<(Apartment Apt, double Balance)>)ViewBag.Balances;
    var pending = (List<(Apartment Apt, Deposit Deposit)>)ViewBag.Pending;
    var totals = ((double Collected, double Expenses, double Revenues, int OpenCount, int ClosedCount, double Balance, double TotalWallet))ViewBag.Totals;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>💼 محفظة @building.Name</h3>
    <form method="get" class="d-flex gap-2">
        <input type="month" name="month" value="@month" class="form-control" onchange="this.form.submit()" />
    </form>
</div>

<div class="row mb-3 text-center">
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">محصّل</div><div class="fw-bold">@totals.Collected.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">مصروفات</div><div class="fw-bold">@totals.Expenses.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">إيرادات</div><div class="fw-bold">@totals.Revenues.ToString("0.##")</div></div></div>
    <div class="col"><div class="bg-white rounded shadow-sm p-3"><div class="text-muted small">إجمالي المحفظة</div><div class="fw-bold">@totals.TotalWallet.ToString("0.##")</div></div></div>
</div>

@if (pending.Count > 0)
{
    <div class="bg-white rounded shadow-sm p-3 mb-3">
        <h5>⏳ دفعات في انتظار التأكيد</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>الشقة</th>
                    <th>رقم الدفعة</th>
                    <th>المبلغ</th>
                    <th>ملاحظة</th>
                    <th>الإيصال</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (apt, dep) in pending)
                {
                    <tr>
                        <td>شقة @apt.Number</td>
                        <td>@dep.Number</td>
                        <td>@dep.Amount.ToString("0.##")</td>
                        <td>@dep.Note</td>
                        <td>
                            @if (dep.Receipt?.Success == true)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#receiptModal"
                                        data-receipt-url="@dep.Receipt.Url"
                                        data-receipt-name="@dep.Number — شقة @apt.Number"
                                        title="عرض الإيصال">
                                    📎 عرض
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="d-flex gap-1">
                            <form method="post" asp-action="ConfirmDeposit">
                                <input type="hidden" name="month" value="@month" />
                                <input type="hidden" name="depositId" value="@dep.Id" />
                                <button class="btn btn-sm btn-success">تأكيد</button>
                            </form>
                            <form method="post" asp-action="CancelDeposit" onsubmit="return confirm('إلغاء الدفعة؟');">
                                <input type="hidden" name="month" value="@month" />
                                <input type="hidden" name="depositId" value="@dep.Id" />
                                <button class="btn btn-sm btn-outline-danger">إلغاء</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="bg-white rounded shadow-sm p-3">
    <h5>أرصدة الشقق</h5>

    @{
        var floorOrderMap = building.Floors.ToDictionary(f => f.Id, f => f.Order);
        var balancesByFloor = balances
            .GroupBy(b => b.Apt.FloorId)
            .OrderBy(g => floorOrderMap.GetValueOrDefault(g.Key, int.MaxValue));
    }

    @foreach (var floorGroup in balancesByFloor)
    {
        var floor = building.Floors.FirstOrDefault(f => f.Id == floorGroup.Key);
        <h6 class="mt-3 mb-2 text-primary">
            🏢 @(floor?.Label ?? "دور غير معروف")
        </h6>
        <table class="table table-sm">
            <thead>
                <tr><th>الشقة</th><th>الرصيد</th><th>تسوية يدوية</th></tr>
            </thead>
            <tbody>
                @foreach (var (apt, balance) in floorGroup.OrderBy(b => b.Apt.Number))
                {
                    <tr>
                        <td>شقة @apt.Number @(string.IsNullOrEmpty(apt.Label) ? "" : "— " + apt.Label)</td>
                        <td class="@(balance < 0 ? "text-danger" : "text-success") fw-bold">@balance.ToString("0.##")</td>
                        <td>
                            <form method="post" asp-action="AddAdjustment" class="d-flex gap-1">
                                <input type="hidden" name="month" value="@month" />
                                <input type="hidden" name="aptId" value="@apt.Id" />
                                <input name="amount" type="number" step="0.01" class="form-control form-control-sm" placeholder="المبلغ (+/-)" style="width:110px" />
                                <input name="reason" class="form-control form-control-sm" placeholder="السبب" />
                                <button class="btn btn-sm btn-outline-secondary text-nowrap">تسوية</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ============================================================ -->
<!-- ✅ Modal لعرض الإيصال                                          -->
<!-- ============================================================ -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="receiptModalTitle">📎 إيصال الدفعة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body text-center">
                <img id="receiptImage" src="" alt="إيصال" class="img-fluid rounded" style="max-height: 70vh;" />
            </div>
            <div class="modal-footer">
                <a id="receiptOpenLink" href="" target="_blank" class="btn btn-sm btn-outline-primary">
                    🔗 فتح في تاب جديد
                </a>
                <a id="receiptDownloadLink" href="" download class="btn btn-sm btn-outline-success">
                    ⬇️ تحميل
                </a>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ✅ لما يفتح الـ Modal، نعرض الصورة المناسبة
        var receiptModal = document.getElementById('receiptModal');
        receiptModal.addEventListener('show.bs.modal', function(event) {
            var button = event.relatedTarget;
            var url = button.getAttribute('data-receipt-url');
            var name = button.getAttribute('data-receipt-name');

            document.getElementById('receiptModalTitle').innerText = '📎 إيصال ' + name;
            document.getElementById('receiptImage').src = url;
            document.getElementById('receiptOpenLink').href = url;
            document.getElementById('receiptDownloadLink').href = url;
        });

        // ✅ لما يقفل الـ Modal، نفرّغ الصورة (عشان الذاكرة)
        receiptModal.addEventListener('hidden.bs.modal', function() {
            document.getElementById('receiptImage').src = '';
        });
    </script>
}