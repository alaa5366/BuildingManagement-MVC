@model List<Building>
@{ ViewData["Title"] = "لوحة Super Admin"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>🏢 كل العمارات</h3>
    <a asp-controller="Buildings" asp-action="Create" class="btn btn-brand">+ عمارة جديدة</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">لا توجد عمارات بعد.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover bg-white">
            <thead><tr><th>الرقم</th><th>الاسم</th><th>الأدوار</th><th>الشقق</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.BuildingNumber</td>
                    <td>@b.Name</td>
                    <td>@b.Floors.Count</td>
                    <td>@b.Apartments.Count</td>
                    <td><a asp-controller="Buildings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">تفاصيل</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
