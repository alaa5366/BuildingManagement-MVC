@model BuildingManagementMvc.Models.PagedResult<BuildingManagementMvc.Models.Poll>
@{
    ViewData["Title"] = Loc.T("Polls_3");
    var building = (Building)ViewBag.Building;
    var openApts = building.Apartments.Count(a => !a.Closed);
    var routeValuesStr = ViewBag.RouteValues as Dictionary<string, string> ?? new();
}

<h3 class="mb-3">@Loc.T("Polls_Of_N_N", building.Name, Model.TotalItems)</h3>

<div class="bg-white rounded shadow-sm p-3 mb-3">
    <h5>@Loc.T("New_Poll")</h5>
    <form method="post" asp-action="Create">
        <div class="mb-2">
            <label class="form-label small">@Loc.T("Question")</label>
            <input name="question" class="form-control" required />
        </div>
        <div class="mb-2">
            <label class="form-label small">@Loc.T("Description_Optional")</label>
            <input name="description" class="form-control" />
        </div>
        <div class="mb-2">
            <label class="form-label small">@Loc.T("Options_At_Least_Two")</label>
            <input name="options" class="form-control mb-1" placeholder="@Loc.T("Option_1")" />
            <input name="options" class="form-control mb-1" placeholder="@Loc.T("Option_2")" />
            <input name="options" class="form-control mb-1" placeholder="@Loc.T("Option_3_Optional")" />
            <input name="options" class="form-control" placeholder="@Loc.T("Option_4_Optional")" />
        </div>
        <div class="mb-2">
            <label class="form-label small">@Loc.T("Deadline_Optional")</label>
            <input name="deadline" type="date" class="form-control" />
        </div>
        <button class="btn btn-brand">@Loc.T("Publish_Poll")</button>
    </form>
</div>

@* ✅ Pagination (فوق) *@
@{
    ViewData["CurrentPage"] = Model.CurrentPage;
    ViewData["PageSize"] = Model.PageSize;
    ViewData["TotalItems"] = Model.TotalItems;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["HasPrevious"] = Model.HasPrevious;
    ViewData["HasNext"] = Model.HasNext;
    ViewData["FirstItemIndex"] = Model.FirstItemIndex;
    ViewData["LastItemIndex"] = Model.LastItemIndex;
    ViewData["ActionName"] = "Index";
    ViewData["ControllerName"] = "Polls";
    ViewData["RouteValues"] = routeValuesStr;
    ViewData["PageSizeOptions"] = new[] { 10, 25, 50, 100 };
}
@await Html.PartialAsync("_Pagination")

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">@Loc.T("No_Polls_Yet")</div>
}
else
{
    foreach (var poll in Model.Items)
    {
        var total = poll.Votes.Count;
        var active = !poll.Closed;
        <div class="bg-white rounded shadow-sm p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5>@poll.Question</h5>
                    @if (!string.IsNullOrEmpty(poll.Description))
                    {
                        <div class="text-muted small mb-2">@poll.Description</div>
                    }
                    <span class="badge @(active ? "bg-success" : "bg-secondary")">@(active ? Loc.T("Active") : Loc.T("Closed_3"))</span>
                    <span class="text-muted small ms-2">@Loc.T("By_N", poll.CreatedBy)</span>
                    @if (!string.IsNullOrEmpty(poll.Deadline))
                    {
                        <span class="text-muted small ms-2">@Loc.T("Until_N", poll.Deadline)</span>
                    }
                </div>
                <div class="d-flex gap-1">
                    @if (poll.Closed)
                    {
                        <form method="post" asp-action="Reopen"><input type="hidden" name="id" value="@poll.Id" /><button class="btn btn-sm btn-outline-secondary">@Loc.T("Reopen")</button></form>
                    }
                    else
                    {
                        <form method="post" asp-action="Close"><input type="hidden" name="id" value="@poll.Id" /><button class="btn btn-sm btn-outline-secondary">@Loc.T("Close")</button></form>
                    }
                    <form method="post" asp-action="Delete" onsubmit="return confirm('@Loc.Js("Delete_The_Poll")');"><input type="hidden" name="id" value="@poll.Id" /><button class="btn btn-sm btn-outline-danger">@Loc.T("Delete_2")</button></form>
                </div>
            </div>
            <div class="mt-2">
                @foreach (var opt in poll.Options)
                {
                    var cnt = poll.Votes.Values.Count(v => v == opt.Id);
                    var pct = total > 0 ? (100.0 * cnt / total) : 0;
                    <div class="mb-1">
                        <div class="d-flex justify-content-between small"><span>@opt.Text</span><span>@cnt (@pct.ToString("0"))%</span></div>
                        <div class="progress" style="height:8px;"><div class="progress-bar bg-brand" style="width:@pct.ToString("0")%; background-color: var(--teal) !important;"></div></div>
                    </div>
                }
            </div>
            <div class="text-muted small mt-2">@Loc.T("Total_Votes_N_N", total, openApts)</div>
        </div>
    }
}

@* ✅ Pagination (تحت) *@
@await Html.PartialAsync("_Pagination")