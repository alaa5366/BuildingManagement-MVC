@model BuildingManagementMvc.Models.PagedResult<BuildingManagementMvc.Models.Poll>
@{
    ViewData["Title"] = "التصويتات";
    var building = (Building)ViewBag.Building;
    var openApts = building.Apartments.Count(a => !a.Closed);
    var routeValuesStr = ViewBag.RouteValues as Dictionary<string, string> ?? new();
}

<h3 class="mb-3">🗳️ تصويتات @building.Name (@Model.TotalItems)</h3>

<div class="bg-white rounded shadow-sm p-3 mb-3">
    <h5>➕ تصويت جديد</h5>
    <form method="post" asp-action="Create">
        <div class="mb-2">
            <label class="form-label small">السؤال</label>
            <input name="question" class="form-control" required />
        </div>
        <div class="mb-2">
            <label class="form-label small">وصف (اختياري)</label>
            <input name="description" class="form-control" />
        </div>
        <div class="mb-2">
            <label class="form-label small">الخيارات (خياران على الأقل)</label>
            <input name="options" class="form-control mb-1" placeholder="خيار 1" />
            <input name="options" class="form-control mb-1" placeholder="خيار 2" />
            <input name="options" class="form-control mb-1" placeholder="خيار 3 (اختياري)" />
            <input name="options" class="form-control" placeholder="خيار 4 (اختياري)" />
        </div>
        <div class="mb-2">
            <label class="form-label small">آخر موعد (اختياري)</label>
            <input name="deadline" type="date" class="form-control" />
        </div>
        <button class="btn btn-brand">نشر التصويت</button>
    </form>
</div>

@* ✅ Pagination (فوق) *@
@{
    ViewData["CurrentPage"] = Model.CurrentPage;
    ViewData["PageSize"] = Model.PageSize;
    ViewData["TotalItems"] = Model.TotalItems;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["HasPrevious"] = Model.HasPrevious;
    ViewData["HasNext"] = Model.HasNext;
    ViewData["FirstItemIndex"] = Model.FirstItemIndex;
    ViewData["LastItemIndex"] = Model.LastItemIndex;
    ViewData["ActionName"] = "Index";
    ViewData["ControllerName"] = "Polls";
    ViewData["RouteValues"] = routeValuesStr;
    ViewData["PageSizeOptions"] = new[] { 10, 25, 50, 100 };
}
@await Html.PartialAsync("_Pagination")

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">لا توجد تصويتات بعد.</div>
}
else
{
    foreach (var poll in Model.Items)
    {
        var total = poll.Votes.Count;
        var active = !poll.Closed;
        <div class="bg-white rounded shadow-sm p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5>@poll.Question</h5>
                    @if (!string.IsNullOrEmpty(poll.Description))
                    {
                        <div class="text-muted small mb-2">@poll.Description</div>
                    }
                    <span class="badge @(active ? "bg-success" : "bg-secondary")">@(active ? "نشط" : "مغلق")</span>
                    <span class="text-muted small ms-2">بواسطة @poll.CreatedBy</span>
                    @if (!string.IsNullOrEmpty(poll.Deadline))
                    {
                        <span class="text-muted small ms-2">⏰ حتى @poll.Deadline</span>
                    }
                </div>
                <div class="d-flex gap-1">
                    @if (poll.Closed)
                    {
                        <form method="post" asp-action="Reopen"><input type="hidden" name="id" value="@poll.Id" /><button class="btn btn-sm btn-outline-secondary">إعادة فتح</button></form>
                    }
                    else
                    {
                        <form method="post" asp-action="Close"><input type="hidden" name="id" value="@poll.Id" /><button class="btn btn-sm btn-outline-secondary">إغلاق</button></form>
                    }
                    <form method="post" asp-action="Delete" onsubmit="return confirm('حذف التصويت؟');"><input type="hidden" name="id" value="@poll.Id" /><button class="btn btn-sm btn-outline-danger">حذف</button></form>
                </div>
            </div>
            <div class="mt-2">
                @foreach (var opt in poll.Options)
                {
                    var cnt = poll.Votes.Values.Count(v => v == opt.Id);
                    var pct = total > 0 ? (100.0 * cnt / total) : 0;
                    <div class="mb-1">
                        <div class="d-flex justify-content-between small"><span>@opt.Text</span><span>@cnt (@pct.ToString("0"))%</span></div>
                        <div class="progress" style="height:8px;"><div class="progress-bar bg-brand" style="width:@pct.ToString("0")%; background-color: var(--teal) !important;"></div></div>
                    </div>
                }
            </div>
            <div class="text-muted small mt-2">إجمالي الأصوات: @total / @openApts</div>
        </div>
    }
}

@* ✅ Pagination (تحت) *@
@await Html.PartialAsync("_Pagination")