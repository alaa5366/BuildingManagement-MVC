@model Building
@inject BuildingManagementMvc.Services.QrSecurityService QrSecurity
@{
    ViewData["Title"] = "QR Codes";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3>📱 QR Codes — @Model.Name (@Model.BuildingNumber)</h3>
    <div class="d-flex gap-2">
        <a asp-action="QrCodesPdf" asp-route-id="@Model.Id" class="btn btn-success btn-sm">
            📄 تحميل PDF
        </a>
        <button onclick="window.print()" class="btn btn-outline-primary btn-sm">🖨️ طباعة</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">← رجوع</a>
    </div>
</div>

<!-- ============================================================ -->
<!-- صفحة 1: QR الأدمن (مشفّر) -->
<!-- ============================================================ -->
@{
    var adminPath = "/Account/LoginAdmin";
    var adminQuery = $"bld={Model.Id}";
    var adminSig = QrSecurity.SignStableQr(adminPath, adminQuery);
    var adminQrUrl = $"{baseUrl}{adminPath}?{adminQuery}&sig={adminSig}";
}
<div class="print-page">
    <div class="page-header">
        <h4>👑 أدمن العمارة</h4>
        <p class="text-muted small">امسح الـ QR ده لدخول الأدمن مباشرة على العمارة دي</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-4 col-sm-6 text-center">
            <div class="border rounded p-4 qr-card">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=@Uri.EscapeDataString(adminQrUrl)"
                     alt="Admin QR" class="img-fluid mb-3 qr-image" />
                <div class="small">
                    <strong style="font-size: 14px;">👑 أدمن</strong>
                    <div>@Model.BuildingNumber</div>
                    <div>@Model.Name</div>
                </div>

                <div class="mt-3 no-print">
                    <a href="@adminQrUrl" target="_blank" class="btn btn-sm btn-outline-primary w-100">
                        🔗 افتح الرابط
                    </a>
                    <div class="text-muted mt-2 qr-link">@adminQrUrl</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- صفحات الشقق (مشفّرة) -->
<!-- ============================================================ -->
@foreach (var floor in Model.Floors.OrderBy(f => f.Order))
{
    var apts = Model.Apartments
        .Where(a => a.FloorId == floor.Id)
        .OrderBy(a => a.Number)
        .ToList();

    if (apts.Count == 0) continue;

    <div class="print-page">
        <div class="page-header">
            <h4>🏢 @floor.Label</h4>
            <p class="text-muted small">@apts.Count شقة — كل QR للساكن يمسحه فيملّي البيانات تلقائياً</p>
        </div>

        <div class="row g-3">
            @foreach (var apt in apts)
            {
                var aptPath = "/Account/LoginResident";
                var aptQuery = $"apt={Model.Id}_{apt.Id}";
                var aptSig = QrSecurity.SignStableQr(aptPath, aptQuery);
                var qrUrl = $"{baseUrl}{aptPath}?{aptQuery}&sig={aptSig}";

                <div class="col-md-4 col-sm-6">
                    <div class="border rounded p-3 text-center h-100 qr-card">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Uri.EscapeDataString(qrUrl)"
                             alt="Apt QR" class="img-fluid mb-2 qr-image" />
                        <div class="small">
                            <strong>🏠 شقة @apt.Number</strong>
                            @if (!string.IsNullOrEmpty(apt.Label))
                            {
                                <div class="text-muted" style="font-size: 11px;">@apt.Label</div>
                            }
                            @if (!string.IsNullOrEmpty(apt.Owner))
                            {
                                <div class="text-muted" style="font-size: 11px;">@apt.Owner</div>
                            }
                            @if (apt.Closed)
                            {
                                <div class="badge bg-secondary mt-1">🔒 مغلقة</div>
                            }
                        </div>

                        <div class="mt-2 no-print">
                            <a href="@qrUrl" target="_blank" class="btn btn-sm btn-outline-primary w-100">
                                🔗 افتح الرابط
                            </a>
                            <div class="text-muted mt-1 qr-link">@qrUrl</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .qr-link {
        font-size: 10px;
        word-break: break-all;
        max-height: 30px;
        overflow: hidden;
    }

    .page-header {
        border-bottom: 2px solid #12433C;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

        .page-header h4 {
            color: #12433C;
            font-weight: 700;
            margin-bottom: 4px;
        }

    @@media print {
        .no-print {
            display: none !important;
        }

        .btn {
            display: none !important;
        }

        body {
            background: white !important;
            margin: 0;
            padding: 0;
        }

        .bg-white {
            box-shadow: none !important;
        }

        .print-page {
            page-break-after: always;
            page-break-inside: avoid;
            padding: 15px;
        }

            .print-page:last-child {
                page-break-after: auto;
            }

        .qr-card {
            page-break-inside: avoid;
            border: 1px solid #ddd !important;
        }

        .qr-image {
            max-width: 140px !important;
            margin: 0 auto;
        }
    }
</style>