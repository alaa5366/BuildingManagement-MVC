@model Building
@{
    ViewData["Title"] = Loc.T("Building_Details");
    var currentMonth = BuildingManagementMvc.Services.WalletService.CurrentMonthKey();
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3>@Model.BuildingNumber — @Model.Name</h3>
    <div class="d-flex gap-2 flex-wrap">
        @if (User.IsInRole("superadmin"))
        {
            <form asp-controller="Impersonation" asp-action="EnterBuildingAdmin"
                  method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <button type="submit" class="btn btn-warning btn-sm">
                    <i class="bi bi-person-badge"></i>
                    @Loc.T("Log_In_As_Resident") (Admin)
                </button>
            </form>
        }
        <a asp-action="QrCodes" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            📱 QR Codes
        </a>
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id"
              onsubmit="return confirm('@Loc.Js("Permanently_Delete_The_Building")');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger btn-sm">@Loc.T("Delete_Building")</button>
        </form>
        <form method="post" asp-action="FixFirebaseAccounts" asp-route-id="@Model.Id"
              onsubmit="return confirm('@Loc.Js("Fix_Firebase_Auth_Accounts_For_All")');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-warning btn-sm" type="submit">
                @Loc.T("Fix_Firebase_Accounts")
            </button>
        </form>
        <form method="post" asp-action="RecreateFirebaseAccounts" asp-route-id="@Model.Id"
              onsubmit="return confirm('@Loc.Js("Recreate_Firebase_Accounts_For_All_Apartments")');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-warning btn-sm" type="submit">
                @Loc.T("Recreate_Firebase_Accounts")
            </button>
        </form>
        <form method="post" asp-action="SyncFirebasePasswords" asp-route-id="@Model.Id"
              onsubmit="return confirm('@Loc.Js("Sync_Firebase_Passwords_For_All_Apartments")');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-success btn-sm" type="submit">
                @Loc.T("Sync_Firebase_Passwords")
            </button>
        </form>
    </div>
</div>

<div class="row mb-4">
    @foreach (var floor in Model.Floors.OrderBy(f => f.Order))
    {
        var apts = Model.Apartments.Where(a => a.FloorId == floor.Id).OrderBy(a => a.Number).ToList();
        <div class="col-lg-6 mb-3">
            <div class="bg-white rounded shadow-sm p-3">
                <h5 class="mb-3">@floor.Label <span class="text-muted small">@Loc.T("Floor_No_N", floor.Order)</span></h5>

                <div class="apt-list">
                    @foreach (var apt in apts)
                    {
                        <div class="apt-card-row">
                            <div class="apt-info">
                                <div class="apt-title">
                                    <i class="bi bi-house-door-fill text-primary"></i>
                                    @Loc.T("Apartment_N", apt.Number)
                                    @if (!string.IsNullOrEmpty(apt.Label))
                                    {
                                        <span class="text-muted small">— @apt.Label</span>
                                    }
                                    @if (apt.Closed)
                                    {
                                        <span class="badge bg-secondary ms-1">🔒 @Loc.T("Closed")</span>
                                    }
                                </div>
                                <div class="apt-owner">@apt.Owner</div>
                                <div class="apt-phone" dir="ltr">@apt.Phone</div>
                            </div>

                            <div class="apt-actions">
                                <button type="button" class="apt-action-btn btn-qr"
                                        onclick="openQuickQrModal('@apt.Id', '@apt.Number', '@floor.Label')">
                                    <span class="icon">⚡</span>
                                    <span class="label">@Loc.T("Quick_QR_2")</span>
                                </button>

                                <a asp-controller="Invoice" asp-action="Download"
                                   asp-route-aptId="@apt.Id"
                                   asp-route-month="@currentMonth"
                                   target="_blank"
                                   class="apt-action-btn btn-invoice">
                                    <span class="icon">🧾</span>
                                    <span class="label">@Loc.T("PDF_Invoice")</span>
                                </a>

                                <form method="post" asp-controller="Impersonation"
                                      asp-action="EnterResidentWallet" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="aptId" value="@apt.Id" />
                                    <input type="hidden" name="buildingId" value="@Model.Id" />  @* ✅ جديد *@
                                    <button type="submit" class="apt-action-btn btn-wallet">
                                        <span class="icon">💼</span>
                                        <span class="label">@Loc.T("Wallet_2")</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <form method="post" asp-action="AddApartment" class="d-flex gap-2 mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@Model.Id" />
                    <input type="hidden" name="floorId" value="@floor.Id" />
                    <input name="phone" class="form-control form-control-sm" placeholder="@Loc.T("New_Apartment_WhatsApp")" required />
                    <input name="pin" class="form-control form-control-sm" placeholder="PIN" required />
                    <button class="btn btn-sm btn-brand text-nowrap">@Loc.T("Apartment_2")</button>
                </form>
            </div>
        </div>
    }
</div>

<div class="bg-white rounded shadow-sm p-3">
    <h5>@Loc.T("Add_A_New_Floor")</h5>
    <form method="post" asp-action="AddFloor">
        @Html.AntiForgeryToken()
        <input type="hidden" name="buildingId" value="@Model.Id" />
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">@Loc.T("Floor_Name")</label>
                <input name="label" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label small">@Loc.T("Apartment_WhatsApp_Numbers_Comma_Separated")</label>
                <input name="aptPhones" class="form-control" placeholder="+2010..., +2011..." required />
            </div>
            <div class="col-md-3">
                <label class="form-label small">@Loc.T("PIN_For_Each_Apartment_In_The")</label>
                <input name="aptPins" class="form-control" placeholder="1234, 5678" required />
            </div>
            <div class="col-md-2">
                <button class="btn btn-brand w-100">@Loc.T("Add")</button>
            </div>
        </div>
    </form>
</div>

<!-- Modal QR سريع (نفس AdminApts) -->
<div class="modal fade" id="quickQrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning bg-opacity-25">
                <h5 class="modal-title">@Html.Raw(Loc.T("Quick_QR_5"))</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="quickQrForm">
                    <div class="alert alert-info small">@Loc.T("The_Quick_QR_Lets_The_Resident")</div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Loc.T("Validity_Period")</label>
                        <select id="validitySelect" class="form-select">
                            <option value="5">@Loc.T("5_Minutes")</option>
                            <option value="15">@Loc.T("15_Minutes")</option>
                            <option value="60" selected>@Loc.T("1_Hour")</option>
                            <option value="360">@Loc.T("6_Hours")</option>
                            <option value="1440">@Loc.T("1_Day")</option>
                            <option value="10080">@Loc.T("1_Week")</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Loc.T("Usage_Type")</label>
                        <div class="form-check">
                            <input type="radio" name="usageType" value="once" class="form-check-input" id="usageOnce2" checked />
                            <label class="form-check-label" for="usageOnce2">
                                <strong>@Loc.T("One_Time_Only")</strong>
                            </label>
                        </div>
                        <div class="form-check mt-2">
                            <input type="radio" name="usageType" value="multiple" class="form-check-input" id="usageMultiple2" />
                            <label class="form-check-label" for="usageMultiple2">
                                <strong>@Loc.T("Multiple_Until_Expiry")</strong>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3" id="maxUsesField" style="display:none">
                        <label class="form-label">@Loc.T("Maximum_Uses")</label>
                        <input type="number" id="maxUsesInput" class="form-control" value="5" min="1" max="100" />
                    </div>
                </div>

                <div id="quickQrResult" style="display:none">
                    <div class="alert alert-success text-center">@Loc.T("Quick_QR_Generated_Successfully")</div>
                    <div class="text-center mb-3">
                        <img id="quickQrImage" src="" alt="QR" class="img-fluid border rounded p-2" style="max-width:280px" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">@Loc.T("Quick_Link")</label>
                        <div class="input-group">
                            <input type="text" id="quickQrUrl" class="form-control form-control-sm" readonly />
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyQuickUrl()">@Loc.T("Copy")</button>
                            <a id="quickQrOpenLink" href="" target="_blank" class="btn btn-sm btn-outline-success">@Loc.T("Open")</a>
                        </div>
                    </div>
                    <div class="text-muted small" id="quickQrInfo"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="generateBtn" class="btn btn-warning" onclick="generateQuickQr()">@Loc.T("Generate_QR")</button>
                <button type="button" id="newQrBtn" class="btn btn-outline-warning" style="display:none" onclick="resetQuickQrForm()">@Loc.T("Generate_New")</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc.T("Close")</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentAptId = '';
        let currentBuildingId = '@Model.Id';

        function openQuickQrModal(aptId, aptNum, floorLabel) {
            currentAptId = aptId;
            resetQuickQrForm();
            new bootstrap.Modal(document.getElementById('quickQrModal')).show();
        }

        function resetQuickQrForm() {
            document.getElementById('quickQrForm').style.display = 'block';
            document.getElementById('quickQrResult').style.display = 'none';
            document.getElementById('generateBtn').style.display = 'inline-block';
            document.getElementById('newQrBtn').style.display = 'none';
            document.getElementById('validitySelect').value = '60';
            document.getElementById('usageOnce2').checked = true;
            document.getElementById('maxUsesField').style.display = 'none';
        }

        document.querySelectorAll('input[name="usageType"]').forEach(r => {
            r.addEventListener('change', () => {
                document.getElementById('maxUsesField').style.display =
                    (r.value === 'multiple' && r.checked) ? 'block' : 'none';
            });
        });

        async function generateQuickQr() {
            const validity = parseInt(document.getElementById('validitySelect').value);
            const usageType = document.querySelector('input[name="usageType"]:checked').value;
            const maxUses = usageType === 'once' ? 1 : parseInt(document.getElementById('maxUsesInput').value);

            const btn = document.getElementById('generateBtn');
            btn.disabled = true;
            btn.textContent = '⏳ @Html.Raw(Loc.Js("Generating"))';

            try {
                const formData = new FormData();
                formData.append('buildingId', currentBuildingId);
                formData.append('aptId', currentAptId);
                formData.append('validityMinutes', validity);
                formData.append('oneTime', usageType === 'once' ? 'true' : 'false');
                formData.append('maxUses', maxUses);
                formData.append('__RequestVerificationToken',
                    document.querySelector('input[name="__RequestVerificationToken"]').value);

                const res = await fetch('@Url.Action("GenerateQuickQr", "Buildings")', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();
                if (!data.success) {
                    alert('❌ ' + (data.error || 'Error'));
                    return;
                }

                document.getElementById('quickQrForm').style.display = 'none';
                document.getElementById('quickQrResult').style.display = 'block';
                document.getElementById('generateBtn').style.display = 'none';
                document.getElementById('newQrBtn').style.display = 'inline-block';

                document.getElementById('quickQrImage').src =
                    `https://api.qrserver.com/v1/create-qr-code/?size=280x280&data=${encodeURIComponent(data.url)}`;
                document.getElementById('quickQrUrl').value = data.url;
                document.getElementById('quickQrOpenLink').href = data.url;
            } finally {
                btn.disabled = false;
                btn.textContent = '⚡ @Html.Raw(Loc.Js("Generate_QR_2"))';
            }
        }

        function copyQuickUrl() {
            const input = document.getElementById('quickQrUrl');
            input.select();
            document.execCommand('copy');
            alert('✅ @Html.Raw(Loc.Js("Link_Copied"))');
        }
    </script>
}