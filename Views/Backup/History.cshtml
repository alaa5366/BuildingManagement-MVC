@model List<BuildingManagementMvc.Models.BackupHistoryEntry>
@{
    ViewData["Title"] = "سجل النسخ";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📜 سجل النسخ الاحتياطية</h2>
        <a asp-action="Scheduled" class="btn btn-outline-secondary">← النسخ المجدولة</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">لا يوجد سجل بعد.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead class="table-dark">
                <tr>
                    <th>التاريخ</th>
                    <th>الحالة</th>
                    <th>المصدر</th>
                    <th>الملف</th>
                    <th>Collections</th>
                    <th>المستندات</th>
                    <th>الحجم</th>
                    <th>المدة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    var date = h.CreatedAt?.ToDateTime().ToLocalTime() ?? DateTime.MinValue;
                    <tr>
                        <td><small>@date.ToString("yyyy-MM-dd HH:mm")</small></td>
                        <td>
                            @if (h.Status == "success")
                            {
                                <span class="badge bg-success">✅ نجح</span>
                            }
                            else
                            {
                                <span class="badge bg-danger" title="@h.ErrorMessage">❌ فشل</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary">@h.Source</span>
                        </td>
                        <td><code class="small">@h.FileName</code></td>
                        <td><small>@string.Join(", ", h.Collections ?? new List<string>())</small></td>
                        <td>@h.TotalDocuments</td>
                        <td>@(h.FileSize / 1024) KB</td>
                        <td>@h.DurationSeconds.ToString("0.0")s</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>