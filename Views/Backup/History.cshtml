@model List<BuildingManagementMvc.Models.BackupHistoryEntry>
@{
    ViewData["Title"] = Loc.T("Backup_History");
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@Loc.T("Backup_History_2")</h2>
        <a asp-action="Scheduled" class="btn btn-outline-secondary">@Loc.T("Scheduled_Backups")</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">@Loc.T("No_History_Yet")</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Loc.T("Date")</th>
                    <th>@Loc.T("Status")</th>
                    <th>@Loc.T("Source")</th>
                    <th>@Loc.T("File")</th>
                    <th>Collections</th>
                    <th>@Loc.T("Documents")</th>
                    <th>@Loc.T("Size")</th>
                    <th>@Loc.T("Duration")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    var date = h.CreatedAt?.ToDateTime().ToLocalTime() ?? DateTime.MinValue;
                    <tr>
                        <td><small>@date.ToString("yyyy-MM-dd HH:mm")</small></td>
                        <td>
                            @if (h.Status == "success")
                            {
                                <span class="badge bg-success">@Loc.T("Succeeded")</span>
                            }
                            else
                            {
                                <span class="badge bg-danger" title="@h.ErrorMessage">@Loc.T("Failed")</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary">@h.Source</span>
                        </td>
                        <td><code class="small">@h.FileName</code></td>
                        <td><small>@string.Join(", ", h.Collections ?? new List<string>())</small></td>
                        <td>@h.TotalDocuments</td>
                        <td>@(h.FileSize / 1024) KB</td>
                        <td>@h.DurationSeconds.ToString("0.0")s</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>