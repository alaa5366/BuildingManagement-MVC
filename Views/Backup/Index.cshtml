@{
    ViewData["Title"] = Loc.T("Backup");
    var buildings = (List<Building>)ViewBag.Buildings;
    var stats = ViewBag.Stats as List<BuildingManagementMvc.Models.BackupStats> ?? new();
    var backupFiles = ViewBag.BackupFiles as List<(string FileName, long FileSize, DateTime CreatedAt)> ?? new();
    var settings = ViewBag.Settings as BuildingManagementMvc.Models.ScheduledBackupSettings ?? new();
    var history = ViewBag.History as List<BuildingManagementMvc.Models.BackupHistoryEntry> ?? new();
    var activeTab = ViewBag.ActiveTab as string ?? "overview";
    var availableCollections = ViewBag.AvailableCollections as IReadOnlyDictionary<string, string> ?? new Dictionary<string, string>();
    var totalDocs = (int)(ViewBag.TotalDocuments ?? 0);
    var totalCollections = (int)(ViewBag.TotalCollections ?? 0);
    var totalBuildings = (int)(ViewBag.TotalBuildings ?? 0);
    var totalBackups = (int)(ViewBag.TotalBackups ?? 0);
    var lastScheduledRun = ViewBag.LastScheduledRun as string;
    var lastScheduledStatus = ViewBag.LastScheduledStatus as string;

    Func<string, string> tabClass = (tabName) =>
        tabName == activeTab ? "bm-tab-link active" : "bm-tab-link";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@Loc.T("Backup_And_Import")</h3>
    <a asp-controller="SuperAdminHome" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        @Loc.T("Back")
    </a>
</div>

@* ============================================================ *@
@* Tabs Navigation                                              *@
@* ============================================================ *@
<ul class="bm-tabs" role="tablist">
    <li class="nav-item">
        <a class="@tabClass("overview")" asp-action="Index" asp-route-tab="overview">
            @Loc.T("Overview")
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("backup")" asp-action="Index" asp-route-tab="backup">
            @Loc.T("Full_Backup")
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("import")" asp-action="Index" asp-route-tab="import">
            @Loc.T("Excel_Import")
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("export")" asp-action="Index" asp-route-tab="export">
            @Loc.T("Export")
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("scheduled")" asp-action="Index" asp-route-tab="scheduled">
            @Loc.T("Scheduled")
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("history")" asp-action="Index" asp-route-tab="history">
            @Loc.T("Log_2")
        </a>
    </li>
</ul>

@* ============================================================ *@
@* Tab 1: نظرة عامة                                             *@
@* ============================================================ *@
@if (activeTab == "overview")
{
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">Collections</div>
                <div class="fw-bold fs-3 text-primary">@totalCollections</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">@Loc.T("Total_Documents")</div>
                <div class="fw-bold fs-3 text-success">@totalDocs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">@Loc.T("Number_Of_Buildings")</div>
                <div class="fw-bold fs-3 text-info">@totalBuildings</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">@Loc.T("Saved_Backups")</div>
                <div class="fw-bold fs-3 text-warning">@totalBackups</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(lastScheduledRun))
    {
        <div class="alert alert-info">
            <strong>@Loc.T("Last_Scheduled_Backup")</strong>
            @DateTime.Parse(lastScheduledRun).ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            <span class="badge @(lastScheduledStatus == "success" ? "bg-success" : "bg-danger") ms-2">
                @(lastScheduledStatus == "success" ? Loc.T("Succeeded_2") : Loc.T("Failed_2"))
            </span>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <strong>@Loc.T("Collections_Statistics")</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Collection</th>
                        <th>@Loc.T("Description")</th>
                        <th>@Loc.T("Document_Count")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in stats)
                    {
                        <tr>
                            <td><code>@s.Collection</code></td>
                            <td>@s.LabelAr</td>
                            <td><span class="badge bg-secondary">@s.DocCount</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="2" class="text-end"><strong>@Loc.T("Total")</strong></td>
                        <td><strong>@totalDocs</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 2: Backup كامل                                          *@
@* ============================================================ *@
@if (activeTab == "backup")
{
    <div class="card">
        <div class="card-header bg-success text-white">
            <strong>@Loc.T("Full_Backup_ZIP")</strong>
        </div>
        <div class="card-body">
            <p class="text-muted">
                @Loc.T("Choose_The_Collections_You_Want_To")
            </p>

            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(true)">@Loc.T("Select_All")</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(false)">@Loc.T("Clear_All")</button>
                </div>

                <div class="row g-2 mb-3">
                    @foreach (var s in stats)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" name="collections" value="@s.Collection"
                                       class="form-check-input col-check" id="col-@s.Collection" checked />
                                <label class="form-check-label" for="col-@s.Collection">
                                    <code>@s.Collection</code> — @s.LabelAr
                                    <span class="badge bg-secondary">@s.DocCount</span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <button class="btn btn-success">
                    @Loc.T("Create_Backup_Now")
                </button>
            </form>
        </div>
    </div>

    @* Restore *@
    <div class="card mt-4">
        <div class="card-header bg-warning">
            <strong>@Loc.T("Restore_From_Backup")</strong>
        </div>
        <div class="card-body">
            <div class="alert alert-warning py-2">
                <small>@Html.Raw(Loc.T("Warning_Restoring_Writes_Data_To_Firestore"))</small>
            </div>

            <form method="post" asp-action="PreviewRestore" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label small">@Loc.T("ZIP_File")</label>
                        <input type="file" name="backupFile" accept=".zip" class="form-control" required />
                        <div class="form-text">@Loc.T("Maximum_100_MB")</div>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-warning w-100">@Loc.T("Preview_Contents")</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 3: استيراد Excel                                         *@
@* ============================================================ *@
@if (activeTab == "import")
{
    <div class="card">
        <div class="card-header bg-primary text-white">
            <strong>@Loc.T("Import_A_New_Building_From_Excel")</strong>
        </div>
        <div class="card-body">
            <p class="text-muted small">
                @Loc.T("Download_The_Template_Fill_It_In")
            </p>

            <a asp-action="DownloadTemplate" class="btn btn-outline-success mb-3">
                @Loc.T("Download_Empty_Template")
            </a>

            <form method="post" asp-action="UploadExcel" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label small">@Loc.T("Excel_File_Xlsx")</label>
                        <input type="file" name="excelFile" accept=".xlsx" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-brand w-100">@Loc.T("Validate_And_Import_File")</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 4: تصدير                                                 *@
@* ============================================================ *@
@if (activeTab == "export")
{
    <div class="card mb-3">
        <div class="card-header bg-info text-dark">
            <strong>@Loc.T("Export_All_Data")</strong>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                @Loc.T("Download_A_Full_Backup_Of_All")
            </p>
            <a asp-action="ExportAllJson" class="btn btn-outline-primary">
                @Loc.T("Export_All_Buildings_JSON")
            </a>
        </div>
    </div>

    @if (buildings.Count > 0)
    {
        <div class="card">
            <div class="card-header">
                <strong>@Loc.T("Export_A_Specific_Building")</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Loc.T("Building_Number")</th>
                            <th>@Loc.T("Name")</th>
                            <th>@Loc.T("Apartments")</th>
                            <th>@Loc.T("Floors")</th>
                            <th>@Loc.T("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in buildings)
                        {
                            <tr>
                                <td><code>@b.BuildingNumber</code></td>
                                <td>@b.Name</td>
                                <td>@b.Apartments.Count</td>
                                <td>@b.Floors.Count</td>
                                <td class="d-flex gap-1">
                                    <a asp-action="ExportJson" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">📄 JSON</a>
                                    <a asp-action="ExportExcel" asp-route-id="@b.Id" class="btn btn-sm btn-outline-success">📊 Excel</a>
                                    <a asp-controller="Buildings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">@Loc.T("View_2")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@* ============================================================ *@
@* Tab 5: مجدول                                                 *@
@* ============================================================ *@
@if (activeTab == "scheduled")
{
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <strong>@Loc.T("Scheduled_Backup_Settings")</strong>
        </div>
        <div class="card-body">
            <form method="post" asp-action="SaveScheduledSettings">
                @Html.AntiForgeryToken()

                <div class="form-check form-switch mb-3">
                    <input type="checkbox" name="Enabled" value="true" class="form-check-input"
                           id="enabled" @(settings.Enabled ? "checked" : "") />
                    <label class="form-check-label" for="enabled">
                        <strong>@Loc.T("Enable_Automatic_Backups")</strong>
                    </label>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">@Loc.T("Frequency")</label>
                        <select name="Frequency" class="form-select" id="frequency">
                            <option value="daily" selected="@(settings.Frequency == "daily")">@Loc.T("Daily")</option>
                            <option value="weekly" selected="@(settings.Frequency == "weekly")">@Loc.T("Weekly")</option>
                            <option value="monthly" selected="@(settings.Frequency == "monthly")">@Loc.T("Monthly")</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Loc.T("Hour_UTC")</label>
                        <input type="number" name="Hour" min="0" max="23" value="@settings.Hour" class="form-control" />
                    </div>
                    <div class="col-md-4" id="dowGroup" style="display:none;">
                        <label class="form-label">@Loc.T("Day_For_Weekly")</label>
                        <select name="DayOfWeek" class="form-select">
                            <option value="">@Loc.T("Select_2")</option>
                            <option value="0" selected="@(settings.DayOfWeek == 0)">@Loc.T("Sunday")</option>
                            <option value="1" selected="@(settings.DayOfWeek == 1)">@Loc.T("Monday")</option>
                            <option value="2" selected="@(settings.DayOfWeek == 2)">@Loc.T("Tuesday")</option>
                            <option value="3" selected="@(settings.DayOfWeek == 3)">@Loc.T("Wednesday")</option>
                            <option value="4" selected="@(settings.DayOfWeek == 4)">@Loc.T("Thursday")</option>
                            <option value="5" selected="@(settings.DayOfWeek == 5)">@Loc.T("Friday")</option>
                            <option value="6" selected="@(settings.DayOfWeek == 6)">@Loc.T("Saturday")</option>
                        </select>
                    </div>
                    <div class="col-md-4" id="domGroup" style="display:none;">
                        <label class="form-label">@Loc.T("Day_Of_Month_For_Monthly")</label>
                        <input type="number" name="DayOfMonth" min="1" max="28"
                               value="@(settings.DayOfMonth ?? 1)" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Loc.T("Number_Of_Backups_To_Keep")</label>
                        <input type="number" name="MaxBackupsToKeep" min="1" max="30"
                               value="@settings.MaxBackupsToKeep" class="form-control" />
                        <div class="form-text">@Loc.T("The_Oldest_Is_Deleted_Automatically")</div>
                    </div>
                </div>

                <hr />

                <div class="mb-2">
                    <strong>@Loc.T("Included_Collections")</strong>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="selectAllCols(true)">@Loc.T("All_2")</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" onclick="selectAllCols(false)">@Loc.T("None")</button>
                </div>

                <div class="row g-2">
                    @foreach (var col in availableCollections)
                    {
                        var isSelected = settings.Collections != null && settings.Collections.Contains(col.Key);
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" name="Collections" value="@col.Key"
                                       class="form-check-input col-check-scheduled"
                                       id="scol-@col.Key" @(isSelected || (settings.Collections == null || settings.Collections.Count == 0) ? "checked" : "") />
                                <label class="form-check-label" for="scol-@col.Key">
                                    <code>@col.Key</code> — @col.Value
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <hr />

                <button type="submit" class="btn btn-primary">@Loc.T("Save_Settings")</button>

                @if (settings.Enabled && !string.IsNullOrEmpty(settings.LastRunAt))
                {
                    <span class="text-muted ms-3">
                        @Loc.T("Last_Run_N", DateTime.Parse(settings.LastRunAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                    </span>
                }
            </form>
        </div>
    </div>

    <form method="post" asp-action="RunNow" class="mb-3"
          onsubmit="return confirm('@Loc.Js("Run_A_Backup_Now_Manually")');">
        @Html.AntiForgeryToken()
        <button class="btn btn-warning">@Loc.T("Run_Backup_Now_Manual")</button>
    </form>

    <div class="card">
        <div class="card-header">
            <strong>@Loc.T("Saved_Backups_N", backupFiles.Count)</strong>
        </div>
        <div class="card-body">
            @if (backupFiles.Count == 0)
            {
                <div class="alert alert-info mb-0">@Loc.T("No_Saved_Backups_Yet")</div>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>@Loc.T("File")</th>
                            <th>@Loc.T("Size")</th>
                            <th>@Loc.T("Date")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in backupFiles)
                        {
                            <tr>
                                <td><code>@f.FileName</code></td>
                                <td>@(f.FileSize / 1024) KB</td>
                                <td>@f.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-action="DownloadBackup" asp-route-fileName="@f.FileName" class="btn btn-sm btn-outline-primary">@Loc.T("Download")</a>
                                    <form method="post" asp-action="DeleteBackup" class="d-inline" onsubmit="return confirm('@Loc.Js("Delete_The_File")');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fileName" value="@f.FileName" />
                                        <button class="btn btn-sm btn-outline-danger">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 6: السجل                                                 *@
@* ============================================================ *@
@if (activeTab == "history")
{
    <div class="card">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <strong>@Loc.T("Backup_History_N", history.Count)</strong>
            @if (history.Any(h => h.Source == "scheduled" && h.Status == "success"))
            {
                <small class="text-white-50">@Loc.T("You_Can_Download_Delete_Scheduled_Backups")</small>
            }
        </div>
        <div class="card-body p-0">
            @if (history.Count == 0)
            {
                <div class="alert alert-info mb-0 m-3">@Loc.T("No_History_Yet")</div>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Loc.T("Date")</th>
                            <th>@Loc.T("Status")</th>
                            <th>@Loc.T("Source")</th>
                            <th>@Loc.T("File")</th>
                            <th>Collections</th>
                            <th>@Loc.T("Documents")</th>
                            <th>@Loc.T("Size")</th>
                            <th>@Loc.T("Duration")</th>
                            <th>@Loc.T("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in history)
                        {
                            var date = h.CreatedAt?.ToDateTime().ToLocalTime() ?? DateTime.MinValue;
                            var fileExists = !string.IsNullOrEmpty(h.FileName)
                                             && h.FileName.EndsWith(".zip")
                                             && h.Status == "success";

                            <tr>
                                <td><small>@date.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td>
                                    @if (h.Status == "success")
                                    {
                                        <span class="badge bg-success">@Loc.T("Succeeded")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="@h.ErrorMessage">@Loc.T("Failed")</span>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@h.Source</span></td>
                                <td><code class="small">@h.FileName</code></td>
                                <td><small>@string.Join(", ", h.Collections ?? new List<string>())</small></td>
                                <td>@h.TotalDocuments</td>
                                <td>@(h.FileSize / 1024) KB</td>
                                <td>@h.DurationSeconds.ToString("0.0")s</td>
                                <td class="text-nowrap">
                                    @if (h.FileExists)
                                    {
                                        <a asp-action="DownloadBackup" asp-route-fileName="@h.FileName"
                                           class="btn btn-sm btn-outline-primary" title="@Loc.T("Download_2")">
                                            ⬇️
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small" title="@Loc.T("File_Deleted")">
                                            <i>📁❌</i>
                                        </span>
                                    }

                                    <form method="post" asp-action="DeleteBackup" class="d-inline"
                                          onsubmit="return confirm('@Loc.Js("Permanently_Delete_The_File_And_Its")');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fileName" value="@h.FileName" />
                                        <button class="btn btn-sm btn-outline-danger" title="@Loc.T("Delete_2")">
                                            🗑️
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@section Styles {
    <style>
        /* ✅ حل مشكلة التابس — نصوص واضحة */
        .bm-tabs {
            display: flex !important;
            flex-wrap: wrap !important;
            gap: 6px !important;
            padding: 0 !important;
            margin: 0 0 1.5rem 0 !important;
            list-style: none !important;
            border-bottom: 3px solid #12433C !important;
        }

            .bm-tabs .nav-item {
                margin-bottom: -3px !important;
            }

            .bm-tabs .bm-tab-link {
                display: block !important;
                padding: 12px 20px !important;
                color: #12433C !important;
                background-color: #E8F0EE !important;
                border: 2px solid #12433C !important;
                border-bottom: none !important;
                border-radius: 10px 10px 0 0 !important;
                text-decoration: none !important;
                font-weight: 700 !important;
                font-size: 15px !important;
                transition: all 0.2s ease !important;
                white-space: nowrap !important;
            }

                .bm-tabs .bm-tab-link:hover {
                    background-color: #C8DCD7 !important;
                    color: #0A2A26 !important;
                    transform: translateY(-1px);
                }

                .bm-tabs .bm-tab-link.active {
                    color: #FFFFFF !important;
                    background-color: #12433C !important;
                    border-color: #12433C !important;
                    box-shadow: 0 -2px 6px rgba(18, 67, 60, 0.3);
                }

        /* Dark mode */
        [data-bs-theme="dark"] .bm-tabs .bm-tab-link {
            color: #E8F0EE !important;
            background-color: #2c2c2c !important;
            border-color: #12433C !important;
        }

            [data-bs-theme="dark"] .bm-tabs .bm-tab-link.active {
                color: #FFFFFF !important;
                background-color: #12433C !important;
            }
    </style>
}

@section Scripts {
    <script>
        const freq = document.getElementById('frequency');
        if (freq) {
            function updateGroups() {
                document.getElementById('dowGroup').style.display = freq.value === 'weekly' ? '' : 'none';
                document.getElementById('domGroup').style.display = freq.value === 'monthly' ? '' : 'none';
                    }
            freq.addEventListener('change', updateGroups);
            updateGroups();
                }

                function selectAll(checked) {
            document.querySelectorAll('.col-check').forEach(cb => cb.checked = checked);
        }

        function selectAllCols(checked) {
                    document.querySelectorAll('.col-check-scheduled').forEach(cb => cb.checked = checked);
        }
    </script>
}