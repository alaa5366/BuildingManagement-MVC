@{
    ViewData["Title"] = "النسخ الاحتياطي";
    var buildings = (List<Building>)ViewBag.Buildings;
    var stats = ViewBag.Stats as List<BuildingManagementMvc.Models.BackupStats> ?? new();
    var backupFiles = ViewBag.BackupFiles as List<(string FileName, long FileSize, DateTime CreatedAt)> ?? new();
    var settings = ViewBag.Settings as BuildingManagementMvc.Models.ScheduledBackupSettings ?? new();
    var history = ViewBag.History as List<BuildingManagementMvc.Models.BackupHistoryEntry> ?? new();
    var activeTab = ViewBag.ActiveTab as string ?? "overview";
    var availableCollections = ViewBag.AvailableCollections as IReadOnlyDictionary<string, string> ?? new Dictionary<string, string>();
    var totalDocs = (int)(ViewBag.TotalDocuments ?? 0);
    var totalCollections = (int)(ViewBag.TotalCollections ?? 0);
    var totalBuildings = (int)(ViewBag.TotalBuildings ?? 0);
    var totalBackups = (int)(ViewBag.TotalBackups ?? 0);
    var lastScheduledRun = ViewBag.LastScheduledRun as string;
    var lastScheduledStatus = ViewBag.LastScheduledStatus as string;

    Func<string, string> tabClass = (tabName) =>
        tabName == activeTab ? "nav-link active" : "nav-link";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>💾 النسخ الاحتياطي والاستيراد</h3>
    <a asp-controller="SuperAdminHome" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        ← رجوع
    </a>
</div>

@* ============================================================ *@
@* Tabs Navigation                                              *@
@* ============================================================ *@
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <a class="@tabClass("overview")" asp-action="Index" asp-route-tab="overview">
            📊 نظرة عامة
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("backup")" asp-action="Index" asp-route-tab="backup">
            📦 Backup كامل
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("import")" asp-action="Index" asp-route-tab="import">
            📥 استيراد Excel
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("export")" asp-action="Index" asp-route-tab="export">
            📤 تصدير
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("scheduled")" asp-action="Index" asp-route-tab="scheduled">
            ⏰ مجدول
        </a>
    </li>
    <li class="nav-item">
        <a class="@tabClass("history")" asp-action="Index" asp-route-tab="history">
            📜 السجل
        </a>
    </li>
</ul>

@* ============================================================ *@
@* Tab 1: نظرة عامة                                             *@
@* ============================================================ *@
@if (activeTab == "overview")
{
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">Collections</div>
                <div class="fw-bold fs-3 text-primary">@totalCollections</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">إجمالي المستندات</div>
                <div class="fw-bold fs-3 text-success">@totalDocs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">عدد العمارات</div>
                <div class="fw-bold fs-3 text-info">@totalBuildings</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white rounded shadow-sm p-3">
                <div class="text-muted small">النسخ المحفوظة</div>
                <div class="fw-bold fs-3 text-warning">@totalBackups</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(lastScheduledRun))
    {
        <div class="alert alert-info">
            <strong>⏰ آخر نسخة مجدولة:</strong>
            @DateTime.Parse(lastScheduledRun).ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            <span class="badge @(lastScheduledStatus == "success" ? "bg-success" : "bg-danger") ms-2">
                @(lastScheduledStatus == "success" ? "نجح" : "فشل")
            </span>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <strong>📊 إحصائيات Collections</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Collection</th>
                        <th>الوصف</th>
                        <th>عدد المستندات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in stats)
                    {
                        <tr>
                            <td><code>@s.Collection</code></td>
                            <td>@s.LabelAr</td>
                            <td><span class="badge bg-secondary">@s.DocCount</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="2" class="text-end"><strong>الإجمالي:</strong></td>
                        <td><strong>@totalDocs</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 2: Backup كامل                                          *@
@* ============================================================ *@
@if (activeTab == "backup")
{
    <div class="card">
        <div class="card-header bg-success text-white">
            <strong>📦 Backup كامل (ZIP)</strong>
        </div>
        <div class="card-body">
            <p class="text-muted">
                اختر الـ Collections اللي عايز تصدّرها. هيتولّد ملف ZIP فيه ملف JSON لكل Collection.
            </p>

            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(true)">تحديد الكل</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(false)">إلغاء الكل</button>
                </div>

                <div class="row g-2 mb-3">
                    @foreach (var s in stats)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" name="collections" value="@s.Collection"
                                       class="form-check-input col-check" id="col-@s.Collection" checked />
                                <label class="form-check-label" for="col-@s.Collection">
                                    <code>@s.Collection</code> — @s.LabelAr
                                    <span class="badge bg-secondary">@s.DocCount</span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <button class="btn btn-success">
                    💾 إنشاء نسخة احتياطية الآن
                </button>
            </form>
        </div>
    </div>

    @* Restore *@
    <div class="card mt-4">
        <div class="card-header bg-warning">
            <strong>📥 استعادة من نسخة احتياطية</strong>
        </div>
        <div class="card-body">
            <div class="alert alert-warning py-2">
                <small>⚠️ <strong>تحذير:</strong> الاستعادة بتكتب بيانات في Firestore. استخدم Preview الأول.</small>
            </div>

            <form method="post" asp-action="PreviewRestore" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label small">ملف ZIP</label>
                        <input type="file" name="backupFile" accept=".zip" class="form-control" required />
                        <div class="form-text">الحد الأقصى: 100 MB</div>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-warning w-100">🔍 معاينة المحتوى</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 3: استيراد Excel                                         *@
@* ============================================================ *@
@if (activeTab == "import")
{
    <div class="card">
        <div class="card-header bg-primary text-white">
            <strong>📥 استيراد عمارة جديدة من Excel</strong>
        </div>
        <div class="card-body">
            <p class="text-muted small">
                حمّل القالب، املأه بالبيانات، ثم ارفعه هنا. النظام هيتحقق من صحة الملف قبل الاستيراد.
            </p>

            <a asp-action="DownloadTemplate" class="btn btn-outline-success mb-3">
                ⬇️ تحميل القالب الفاضي
            </a>

            <form method="post" asp-action="UploadExcel" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label small">ملف Excel (.xlsx)</label>
                        <input type="file" name="excelFile" accept=".xlsx" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-brand w-100">🔍 فحص الملف واستيراده</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 4: تصدير                                                 *@
@* ============================================================ *@
@if (activeTab == "export")
{
    <div class="card mb-3">
        <div class="card-header bg-info text-dark">
            <strong>📤 تصدير كل البيانات</strong>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                حمّل نسخة احتياطية كاملة من كل العمارات بصيغة JSON.
            </p>
            <a asp-action="ExportAllJson" class="btn btn-outline-primary">
                ⬇️ تصدير كل العمارات (JSON)
            </a>
        </div>
    </div>

    @if (buildings.Count > 0)
    {
        <div class="card">
            <div class="card-header">
                <strong>🏢 تصدير عمارة محددة</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم العمارة</th>
                            <th>الاسم</th>
                            <th>الشقق</th>
                            <th>الأدوار</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in buildings)
                        {
                            <tr>
                                <td><code>@b.BuildingNumber</code></td>
                                <td>@b.Name</td>
                                <td>@b.Apartments.Count</td>
                                <td>@b.Floors.Count</td>
                                <td class="d-flex gap-1">
                                    <a asp-action="ExportJson" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">📄 JSON</a>
                                    <a asp-action="ExportExcel" asp-route-id="@b.Id" class="btn btn-sm btn-outline-success">📊 Excel</a>
                                    <a asp-controller="Buildings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">👁️ عرض</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@* ============================================================ *@
@* Tab 5: مجدول                                                 *@
@* ============================================================ *@
@if (activeTab == "scheduled")
{
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <strong>⏰ إعدادات النسخ المجدولة</strong>
        </div>
        <div class="card-body">
            <form method="post" asp-action="SaveScheduledSettings">
                @Html.AntiForgeryToken()

                <div class="form-check form-switch mb-3">
                    <input type="checkbox" name="Enabled" value="true" class="form-check-input"
                           id="enabled" @(settings.Enabled ? "checked" : "") />
                    <label class="form-check-label" for="enabled">
                        <strong>تشغيل النسخ التلقائي</strong>
                    </label>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">التكرار</label>
                        <select name="Frequency" class="form-select" id="frequency">
                            <option value="daily" selected="@(settings.Frequency == "daily")">📅 يومي</option>
                            <option value="weekly" selected="@(settings.Frequency == "weekly")">📆 أسبوعي</option>
                            <option value="monthly" selected="@(settings.Frequency == "monthly")">🗓️ شهري</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">الساعة (UTC)</label>
                        <input type="number" name="Hour" min="0" max="23" value="@settings.Hour" class="form-control" />
                    </div>
                    <div class="col-md-4" id="dowGroup" style="display:none;">
                        <label class="form-label">اليوم (للأسبوعي)</label>
                        <select name="DayOfWeek" class="form-select">
                            <option value="">— اختر —</option>
                            <option value="0" selected="@(settings.DayOfWeek == 0)">الأحد</option>
                            <option value="1" selected="@(settings.DayOfWeek == 1)">الاثنين</option>
                            <option value="2" selected="@(settings.DayOfWeek == 2)">الثلاثاء</option>
                            <option value="3" selected="@(settings.DayOfWeek == 3)">الأربعاء</option>
                            <option value="4" selected="@(settings.DayOfWeek == 4)">الخميس</option>
                            <option value="5" selected="@(settings.DayOfWeek == 5)">الجمعة</option>
                            <option value="6" selected="@(settings.DayOfWeek == 6)">السبت</option>
                        </select>
                    </div>
                    <div class="col-md-4" id="domGroup" style="display:none;">
                        <label class="form-label">اليوم من الشهر (للشهري)</label>
                        <input type="number" name="DayOfMonth" min="1" max="28"
                               value="@(settings.DayOfMonth ?? 1)" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">عدد النسخ المحفوظة</label>
                        <input type="number" name="MaxBackupsToKeep" min="1" max="30"
                               value="@settings.MaxBackupsToKeep" class="form-control" />
                        <div class="form-text">الأقدم بيتمسح تلقائيًا</div>
                    </div>
                </div>

                <hr />

                <div class="mb-2">
                    <strong>📦 Collections المشمولة:</strong>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="selectAllCols(true)">الكل</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" onclick="selectAllCols(false)">لا شيء</button>
                </div>

                <div class="row g-2">
                    @foreach (var col in availableCollections)
                    {
                        var isSelected = settings.Collections != null && settings.Collections.Contains(col.Key);
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" name="Collections" value="@col.Key"
                                       class="form-check-input col-check-scheduled"
                                       id="scol-@col.Key" @(isSelected || (settings.Collections == null || settings.Collections.Count == 0) ? "checked" : "") />
                                <label class="form-check-label" for="scol-@col.Key">
                                    <code>@col.Key</code> — @col.Value
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <hr />

                <button type="submit" class="btn btn-primary">💾 حفظ الإعدادات</button>

                @if (settings.Enabled && !string.IsNullOrEmpty(settings.LastRunAt))
                {
                    <span class="text-muted ms-3">
                        آخر تشغيل: @DateTime.Parse(settings.LastRunAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </span>
                }
            </form>
        </div>
    </div>

    <form method="post" asp-action="RunNow" class="mb-3"
          onsubmit="return confirm('تشغيل نسخة الآن يدويًا؟');">
        @Html.AntiForgeryToken()
        <button class="btn btn-warning">⚡ تشغيل نسخة الآن (يدويًا)</button>
    </form>

    <div class="card">
        <div class="card-header">
            <strong>📁 النسخ المحفوظة (@backupFiles.Count)</strong>
        </div>
        <div class="card-body">
            @if (backupFiles.Count == 0)
            {
                <div class="alert alert-info mb-0">لا توجد نسخ محفوظة بعد.</div>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>الملف</th>
                            <th>الحجم</th>
                            <th>التاريخ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in backupFiles)
                        {
                            <tr>
                                <td><code>@f.FileName</code></td>
                                <td>@(f.FileSize / 1024) KB</td>
                                <td>@f.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-action="DownloadBackup" asp-route-fileName="@f.FileName" class="btn btn-sm btn-outline-primary">⬇️ تحميل</a>
                                    <form method="post" asp-action="DeleteBackup" class="d-inline" onsubmit="return confirm('حذف الملف؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fileName" value="@f.FileName" />
                                        <button class="btn btn-sm btn-outline-danger">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@* ============================================================ *@
@* Tab 6: السجل                                                 *@
@* ============================================================ *@
@if (activeTab == "history")
{
    <div class="card">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <strong>📜 سجل النسخ الاحتياطية (@history.Count)</strong>
            @if (history.Any(h => h.Source == "scheduled" && h.Status == "success"))
            {
                <small class="text-white-50">💾 يمكنك تحميل/حذف النسخ المجدولة</small>
            }
        </div>
        <div class="card-body p-0">
            @if (history.Count == 0)
            {
                <div class="alert alert-info mb-0 m-3">لا يوجد سجل بعد.</div>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>التاريخ</th>
                            <th>الحالة</th>
                            <th>المصدر</th>
                            <th>الملف</th>
                            <th>Collections</th>
                            <th>المستندات</th>
                            <th>الحجم</th>
                            <th>المدة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in history)
                        {
                            var date = h.CreatedAt?.ToDateTime().ToLocalTime() ?? DateTime.MinValue;
                            var fileExists = !string.IsNullOrEmpty(h.FileName)
                                             && h.FileName.EndsWith(".zip")
                                             && h.Status == "success";

                            <tr>
                                <td><small>@date.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td>
                                    @if (h.Status == "success")
                                    {
                                        <span class="badge bg-success">✅ نجح</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="@h.ErrorMessage">❌ فشل</span>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@h.Source</span></td>
                                <td><code class="small">@h.FileName</code></td>
                                <td><small>@string.Join(", ", h.Collections ?? new List<string>())</small></td>
                                <td>@h.TotalDocuments</td>
                                <td>@(h.FileSize / 1024) KB</td>
                                <td>@h.DurationSeconds.ToString("0.0")s</td>
                                <td class="text-nowrap">
                                 @if (h.FileExists)
                                    {
                                       <a asp-action="DownloadBackup" asp-route-fileName="@h.FileName"
                                        class="btn btn-sm btn-outline-primary" title="تحميل">
                                         ⬇️
                                        </a>
                                         }
                                            else
    {
        <span class="text-muted small" title="الملف محذوف">
            <i>📁❌</i>
        </span>
    }

    <form method="post" asp-action="DeleteBackup" class="d-inline"
          onsubmit="return confirm('حذف الملف والسجل نهائيًا؟');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="fileName" value="@h.FileName" />
        <button class="btn btn-sm btn-outline-danger" title="حذف">
            🗑️
        </button>
    </form>
</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
@section Scripts {
    <script>
        // Toggle DayOfWeek/DayOfMonth based on Frequency
        const freq = document.getElementById('frequency');
        if (freq) {
            function updateGroups() {
                document.getElementById('dowGroup').style.display = freq.value === 'weekly' ? '' : 'none';
                document.getElementById('domGroup').style.display = freq.value === 'monthly' ? '' : 'none';
            }
            freq.addEventListener('change', updateGroups);
            updateGroups();
        }

        // Select all checkboxes (Backup tab)
        function selectAll(checked) {
            document.querySelectorAll('.col-check').forEach(cb => cb.checked = checked);
        }

        // Select all checkboxes (Scheduled tab)
        function selectAllCols(checked) {
            document.querySelectorAll('.col-check-scheduled').forEach(cb => cb.checked = checked);
        }
    </script>
}