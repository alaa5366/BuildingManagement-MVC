@{
    ViewData["Title"] = "النسخ الاحتياطي";
    var buildings = (List<Building>)ViewBag.Buildings;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>💾 النسخ الاحتياطي والاستيراد</h3>
    <a asp-controller="SuperAdminHome" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        ← رجوع
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================================================ -->
<!-- 1. استيراد عمارة جديدة من Excel                               -->
<!-- ============================================================ -->
<div class="bg-white rounded shadow-sm p-4 mb-3">
    <h5>📥 استيراد عمارة جديدة من Excel</h5>
    <p class="text-muted small mb-3">
        حمّل القالب، املأه بالبيانات، ثم ارفعه هنا. النظام هيتحقق من صحة الملف قبل الاستيراد.
    </p>

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <a asp-action="DownloadTemplate" class="btn btn-outline-success w-100">
                ⬇️ تحميل القالب الفاضي
            </a>
        </div>
    </div>

    <form method="post" asp-action="UploadExcel" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label small">ملف Excel (.xlsx)</label>
                <input type="file" name="excelFile" accept=".xlsx" class="form-control" required />
            </div>
            <div class="col-md-4">
                <button class="btn btn-brand w-100">🔍 فحص الملف واستيراده</button>
            </div>
        </div>
    </form>
</div>

<!-- ============================================================ -->
<!-- 2. تصدير كل العمارات                                          -->
<!-- ============================================================ -->
<div class="bg-white rounded shadow-sm p-4 mb-3">
    <h5>📤 تصدير كل البيانات</h5>
    <p class="text-muted small mb-3">
        حمّل نسخة احتياطية كاملة من كل العمارات بصيغة JSON.
    </p>
    <a asp-action="ExportAllJson" class="btn btn-outline-primary">
        ⬇️ تصدير كل العمارات (JSON)
    </a>
</div>

<!-- ============================================================ -->
<!-- 3. تصدير عمارة محددة                                          -->
<!-- ============================================================ -->
@if (buildings.Count > 0)
{
    <div class="bg-white rounded shadow-sm p-4">
        <h5>🏢 تصدير عمارة محددة</h5>
        <p class="text-muted small mb-3">
            اختر عمارة لتصديرها بصيغة JSON أو Excel.
        </p>

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>رقم العمارة</th>
                    <th>الاسم</th>
                    <th>الشقق</th>
                    <th>الأدوار</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in buildings)
                {
                    <tr>
                        <td><code>@b.BuildingNumber</code></td>
                        <td>@b.Name</td>
                        <td>@b.Apartments.Count</td>
                        <td>@b.Floors.Count</td>
                        <td class="d-flex gap-1">
                            <a asp-action="ExportJson" asp-route-id="@b.Id"
                               class="btn btn-sm btn-outline-primary">
                                📄 JSON
                            </a>
                            <a asp-action="ExportExcel" asp-route-id="@b.Id"
                               class="btn btn-sm btn-outline-success">
                                📊 Excel
                            </a>
                            <a asp-controller="Buildings" asp-action="Details" asp-route-id="@b.Id"
                               class="btn btn-sm btn-outline-secondary">
                                👁️ عرض
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        مفيش عمارات مسجلة لحد دلوقتي. استورد أول عمارة من Excel.
    </div>
}