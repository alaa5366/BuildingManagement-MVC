@model BuildingManagementMvc.Models.RestorePreview
@{
    ViewData["Title"] = Loc.T("Restore_Preview");
    var totalDocs = Model.Collections.Sum(c => c.DocCount);
}

<div class="container">
    <h2>@Loc.T("Restore_Preview_2")</h2>

    <div class="card mb-3">
        <div class="card-header bg-info">
            <strong>@Loc.T("File_Information")</strong>
        </div>
        <div class="card-body">
            <div><strong>@Loc.T("File_2")</strong> @Model.FileName</div>
            <div><strong>@Loc.T("Size_2")</strong> @(Model.FileSize / 1024) KB</div>
            <div><strong>Collections:</strong> @Model.Collections.Count</div>
            <div><strong>@Loc.T("Total_Documents_2")</strong> @totalDocs</div>
        </div>
    </div>

    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>@Loc.T("Warnings")</strong>
            <ul>@foreach (var err in Model.Errors) {
                <li>@err</li>
            }
        </ul>
    </div>
}

<form method="post" asp-action="ExecuteRestore">
    @Html.AntiForgeryToken()
    <input type="hidden" name="tempFilePath" value="@Model.TempFilePath" />

    <div class="card mb-3">
        <div class="card-header">
            <strong>@Loc.T("Choose_Collections_To_Restore")</strong>
            <div class="float-end">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(true)">@Loc.T("Select_All")</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(false)">@Loc.T("Clear_All")</button>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th style="width: 40px;"></th>
                        <th>Collection</th>
                        <th>@Loc.T("Description")</th>
                        <th>@Loc.T("Document_Count")</th>
                        <th>@Loc.T("Size")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Collections)
                    {
                        <tr>
                            <td><input type="checkbox" name="collections" value="@c.Collection" class="form-check-input col-check" checked /></td>
                            <td><code>@c.Collection</code></td>
                            <td>@c.LabelAr</td>
                            <td><span class="badge bg-secondary">@c.DocCount</span></td>
                            <td><small>@(c.SizeBytes / 1024) KB</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-check mb-3">
        <input type="checkbox" name="overwrite" value="true" class="form-check-input" id="overwrite" />
        <label class="form-check-label text-danger" for="overwrite">@Html.Raw(Loc.T("Replace_Existing_Documents_Overwrite"))</label>
    </div>

    <button type="submit" class="btn btn-danger btn-lg"
            onclick="return confirm('@Loc.Js("Confirm_The_Restore")');">
        @Loc.T("Run_Restore")
    </button>
    <a asp-action="Restore" class="btn btn-secondary">@Loc.T("Cancel_2")</a>
</form>
</div>

@section Scripts {
    <script>
        function selectAll(checked) {
            document.querySelectorAll('.col-check').forEach(cb => cb.checked = checked);
        }
    </script>
}