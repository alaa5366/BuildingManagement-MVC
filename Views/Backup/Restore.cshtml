@{
    ViewData["Title"] = Loc.T("Restore_Backup");
}

<div class="container">
    <h2>@Loc.T("Restore_From_Backup")</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="alert alert-warning">@Html.Raw(Loc.T("Warning_Restoring_Writes_Data_To_Firestore_2"))</div>

    <form method="post" asp-action="PreviewRestore" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">@Loc.T("Backup_File_Zip")</label>
                    <input type="file" name="backupFile" accept=".zip" class="form-control" required />
                    <div class="form-text">@Loc.T("Maximum_100_MB")</div>
                </div>

                <button type="submit" class="btn btn-primary">
                    @Loc.T("Preview_Contents")
                </button>
                <a asp-action="Index" class="btn btn-secondary">@Loc.T("Back")</a>
            </div>
        </div>
    </form>
</div>