@using BuildingManagementMvc.Services
@model BuildingImportData
@{
    ViewData["Title"] = Loc.T("Confirm_Import");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@Loc.T("Confirm_Building_Import")</h3>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Loc.T("Back")</a>
</div>

<div class="alert alert-success">
    @Loc.T("The_File_Is_Valid_Review_The")
</div>

<div class="bg-white rounded shadow-sm p-4 mb-3">
    <h5>@Loc.T("Building_Data")</h5>
    <dl class="row mb-0">
        <dt class="col-sm-3">@Loc.T("Name")</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">@Loc.T("Building_Number")</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrEmpty(Model.BuildingNumber) ? Loc.T("Automatic_BLD_XXX") : Model.BuildingNumber)
        </dd>

        <dt class="col-sm-3">@Loc.T("Admin_PIN")</dt>
        <dd class="col-sm-9">@Model.AdminPin</dd>

        <dt class="col-sm-3">@Loc.T("Admin_WhatsApp")</dt>
        <dd class="col-sm-9">@Model.AdminWhatsapp</dd>
    </dl>
</div>

<div class="bg-white rounded shadow-sm p-4 mb-3">
    <h5>@Loc.T("Apartments_N", Model.Apartments.Count)</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>#</th>
                <th>@Loc.T("Role")</th>
                <th>@Loc.T("Apartment_Number")</th>
                <th>@Loc.T("Owner")</th>
                <th>@Loc.T("WhatsApp")</th>
                <th>PIN</th>
                <th>@Loc.T("Fee")</th>
                <th>@Loc.T("Status")</th>
            </tr>
        </thead>
        <tbody>
            @{
                int index = 1;
                var grouped = Model.Apartments
                    .GroupBy(a => new { a.FloorLabel, a.FloorOrder })
                    .OrderBy(g => g.Key.FloorOrder);
            }
            @foreach (var group in grouped)
            {
                foreach (var apt in group.OrderBy(a => a.AptNumber))
                {
                    <tr>
                        <td>@index</td>
                        <td>@group.Key.FloorLabel</td>
                        <td>@apt.AptNumber</td>
                        <td>@apt.Owner</td>
                        <td>@apt.WhatsApp</td>
                        <td><code>@apt.Pin</code></td>
                        <td>@apt.MonthlyFee.ToString("0.##")</td>
                        <td>
                            @if (apt.Status == "closed")
                            {
                                <span class="badge bg-secondary">@Loc.T("Closed")</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Loc.T("Open_2")</span>
                            }
                        </td>
                    </tr>
                    index++;
                }
            }
        </tbody>
    </table>
</div>

<div class="bg-white rounded shadow-sm p-4">
    <h5>@Loc.T("Final_Confirmation")</h5>
    <p class="text-muted small">
        @Loc.T("Once_You_Click_Confirm_Import_A")
    </p>

    <form method="post" asp-action="ConfirmImport">
        @Html.AntiForgeryToken()

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                @Loc.T("Confirm_Import_2")
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                @Loc.T("Cancel")
            </a>
        </div>
    </form>
</div>