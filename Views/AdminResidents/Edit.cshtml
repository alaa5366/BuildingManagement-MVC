@model BuildingManagementMvc.Data.Entities.ResidentEntity
@{
    ViewData["Title"] = Loc.T("Edit_Resident");
    var building = ViewBag.Building as Building;
    var apt = ViewBag.Apartment as Apartment;
}

<div class="container" style="max-width: 900px;">

    @* ═══════════════════════════════════════════════════════════ *@
    @* Header                                                        *@
    @* ═══════════════════════════════════════════════════════════ *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">✏️ @Loc.T("Edit_Resident")</h2>
            <p class="text-muted mb-0">
                @building?.Name
                @if (apt != null)
                {
                    <span> — @Loc.T("Apartment_N", apt.Number)</span>
                }
            </p>
        </div>
        <a asp-action="Index" asp-route-buildingId="@Model.BuildingId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right"></i> @Loc.T("Back")
        </a>
    </div>

    @* ═══════════════════════════════════════════════════════════ *@
    @* Status Alert                                                  *@
    @* ═══════════════════════════════════════════════════════════ *@
    @if (Model.IsDisabled)
    {
        <div class="alert alert-danger">
            <i class="bi bi-x-circle-fill"></i>
            <strong>@Loc.T("Disabled")</strong>
            @if (!string.IsNullOrWhiteSpace(Model.DisabledReason))
            {
                <span> — @Loc.T("Reason") @Model.DisabledReason</span>
            }
        </div>
    }

    @* ═══════════════════════════════════════════════════════════ *@
    @* Main Form                                                     *@
    @* ═══════════════════════════════════════════════════════════ *@
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white">
                <strong><i class="bi bi-person-fill"></i> @Loc.T("Personal_Info")</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@Loc.T("Name")</label>
                        <input type="text" name="name" value="@Model.Name"
                               class="form-control form-control-lg" required maxlength="200" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@Loc.T("Phone")</label>
                        <input type="tel" name="phone" value="@Model.Phone"
                               class="form-control form-control-lg" dir="ltr" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@Loc.T("WhatsApp")</label>
                        <input type="tel" name="whatsapp" value="@Model.Whatsapp"
                               class="form-control form-control-lg" dir="ltr" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@Loc.T("Email_Optional")</label>
                        <input type="email" name="email" value="@Model.Email"
                               class="form-control form-control-lg" dir="ltr" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-info text-white">
                <strong><i class="bi bi-shield-check"></i> @Loc.T("Role_Status")</strong>
            </div>
            <div class="card-body">
                <div class="form-check form-switch mb-2">
                    <input type="checkbox" name="isPrimary" value="true"
                           class="form-check-input" id="isPrimary"
                    @(Model.IsPrimary ? "checked" : "") />
                    <label class="form-check-label" for="isPrimary">
                        <strong>@Loc.T("Primary_Resident")</strong>
                        <div class="form-text">@Loc.T("Primary_Resident_Hint")</div>
                    </label>
                </div>

                <div class="form-check form-switch">
                    <input type="checkbox" name="isOwner" value="true"
                           class="form-check-input" id="isOwner"
                    @(Model.IsOwner ? "checked" : "") />
                    <label class="form-check-label" for="isOwner">
                        <strong>@Loc.T("Owner_Not_Tenant")</strong>
                        <div class="form-text">@Loc.T("Owner_Hint")</div>
                    </label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end mb-5">
            <a asp-action="Index" asp-route-buildingId="@Model.BuildingId"
               class="btn btn-outline-secondary btn-lg">
                @Loc.T("Cancel")
            </a>
            <button type="submit" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-check-circle"></i> @Loc.T("Save_Changes")
            </button>
        </div>
    </form>

    @* ═══════════════════════════════════════════════════════════ *@
    @* Change PIN                                                    *@
    @* ═══════════════════════════════════════════════════════════ *@
    <div class="card shadow-sm mb-3 border-warning">
        <div class="card-header bg-warning">
            <strong><i class="bi bi-key-fill"></i> @Loc.T("Change_PIN")</strong>
        </div>
        <div class="card-body">
            <form asp-action="ChangePin" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-6">
                    <label class="form-label">@Loc.T("New_PIN")</label>
                    <input type="text" name="newPin" class="form-control form-control-lg"
                           maxlength="4" inputmode="numeric" pattern="\d{4}" required
                           placeholder="0000" />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button type="submit" class="btn btn-warning btn-lg w-100">
                        <i class="bi bi-key"></i> @Loc.T("Change_PIN")
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>