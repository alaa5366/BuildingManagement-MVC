@{
    ViewData["Title"] = Loc.T("Welcome_Message");
    var building = (Building)ViewBag.Building;
    var apt = (Apartment)ViewBag.Apt;
    var floor = (Floor?)ViewBag.Floor;
    var quickUrl = (string)ViewBag.QuickUrl;
    var messageText = (string)ViewBag.MessageText;
    var waLink = (string)ViewBag.WhatsAppLink;
    var qrBase64 = (string)ViewBag.QrBase64;
    var validityHours = (int)ViewBag.ValidityHours;

    // ✅ نبني اسم الملف هنا كـ C# string — أنضف من الـ JS
    var fileName = $"QR-Apt-{apt.Number}-{building.BuildingNumber}.png";
}

<div class="container" style="max-width: 800px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Loc.T("Welcome_Message_Apartment_N", apt.Number)</h2>
        <span class="badge bg-secondary">@building.Name</span>
    </div>

    @* ===== الخطوات ===== *@
    <div class="alert alert-info">
        <strong>@Loc.T("Steps_To_Send")</strong>
        <ol class="mb-0 mt-2">
            <li>@Html.Raw(Loc.T("Download_The_QR_Image_Button_Download"))</li>
            <li>@Html.Raw(Loc.T("Tap_Send_Via_WhatsApp_The_Message"))</li>
            <li>@Loc.T("Send_The_Image_After_The_Message")</li>
        </ol>
    </div>

    @* ===== QR + Info ===== *@
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <strong>@Loc.T("Quick_Login_QR")</strong>
            <span class="badge bg-info">@Loc.T("Valid_For_N_Hours", validityHours)</span>
        </div>
        <div class="card-body text-center">
            <img src="data:image/png;base64,@qrBase64"
                 alt="QR Code"
                 id="qrImage"
                 style="width: 300px; height: 300px; border: 4px solid #12433C; border-radius: 12px; padding: 8px; background: white;" />

            <div class="mt-3">
                <small class="text-muted d-block mb-1">@Loc.T("Quick_Login_Link")</small>
                <code class="small d-block" style="word-break: break-all;">@quickUrl</code>
            </div>

            @* ✅ أزرار التحميل والنسخ للـ QR *@
            <div class="d-flex gap-2 justify-content-center mt-3 flex-wrap">
                <button type="button" onclick="downloadQr()" class="btn btn-primary">
                    @Loc.T("Download_QR_As_Image")
                </button>
                <button type="button" onclick="copyImageToClipboard()" class="btn btn-outline-primary">
                    @Loc.T("Copy_Image_To_Clipboard")
                </button>
                <button type="button" onclick="copyText('@quickUrl', this)" class="btn btn-outline-secondary">
                    @Loc.T("Copy_Link")
                </button>
            </div>
        </div>
    </div>

    @* ===== WhatsApp Send ===== *@
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body text-center">
            <h5 class="mb-3">@Loc.T("Send_Message")</h5>
            <p class="text-muted small mb-3">
                @Loc.T("Tap_The_Button_To_Open_WhatsApp")
            </p>
            <a href="@waLink" target="_blank" class="btn btn-success btn-lg">
                @Loc.T("Send_Via_WhatsApp_N", apt.Phone)
            </a>
            <div class="mt-2 text-muted small">
                @Loc.T("WhatsApp_Will_Open_On_Your_Device")
            </div>
        </div>
    </div>

    @* ===== Message Preview ===== *@
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <strong>@Loc.T("Message_Preview")</strong>
            <button type="button" onclick="copyMsg(this)" class="btn btn-sm btn-outline-light">
                @Loc.T("Copy")
            </button>
        </div>
        <div class="card-body">
            <div id="msgText" style="white-space: pre-wrap; font-family: 'Segoe UI', Tahoma, sans-serif; line-height: 1.8; direction: rtl; text-align: right;">@messageText</div>
        </div>
    </div>

    @* ===== Actions ===== *@
    <div class="d-flex gap-2 justify-content-end mb-5 flex-wrap">
        <a asp-action="Index" class="btn btn-secondary">
            @Loc.T("Back_2")
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // ✅ اسم الملف جاي من C# — مفيش parsing في JS
        const qrFileName = '@fileName';

        // ============================================================
        // 📥 تحميل صورة QR
        // ============================================================
        function downloadQr() {
            const qrImg = document.getElementById('qrImage');
            const link = document.createElement('a');
            link.href = qrImg.src;
            link.download = qrFileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ============================================================
        // 📋 نسخ صورة QR للحافظة
        // ============================================================
        async function copyImageToClipboard() {
            try {
                const qrImg = document.getElementById('qrImage');
                const response = await fetch(qrImg.src);
                const blob = await response.blob();

                await navigator.clipboard.write([
                    new ClipboardItem({ 'image/png': blob })
                ]);

                alert('✅ @Html.Raw(Loc.Js("Image_Copied_You_Can_Paste_It"))');
            } catch (err) {
                alert('❌ @Html.Raw(Loc.Js("Your_Browser_Doesn_T_Support_Copying")) "@Html.Raw(Loc.Js("Download_QR_As_Image_2"))" @Html.Raw(Loc.Js("Instead"))');
                console.error(err);
            }
        }

        // ============================================================
        // 📋 نسخ نص
        // ============================================================
        function copyText(text, btn) {
            navigator.clipboard.writeText(text).then(() => {
                const original = btn.innerText;
                btn.innerText = '✅ @Html.Raw(Loc.Js("Copied"))';
                setTimeout(() => btn.innerText = original, 1500);
            });
        }

        function copyMsg(btn) {
            const text = document.getElementById('msgText').innerText;
            navigator.clipboard.writeText(text).then(() => {
                const original = btn.innerText;
                btn.innerText = '✅ @Html.Raw(Loc.Js("Copied"))';
                setTimeout(() => btn.innerText = original, 1500);
            });
        }
    </script>
}