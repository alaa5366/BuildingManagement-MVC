@model Building
@{
    ViewData["Title"] = "إدارة الشقق";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>🏠 شقق @Model.Name (@Model.BuildingNumber)</h3>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-controller="AdminHome" class="btn btn-outline-secondary btn-sm">← رجوع</a>
    </div>
</div>

<div class="alert alert-info">
    💡 اضغط <strong>"⚡ QR سريع"</strong> جنب أي شقة عشان تولّد رابط دخول مؤقت وآمن للساكن.
</div>

<div class="row">
    @foreach (var floor in Model.Floors.OrderBy(f => f.Order))
    {
        var apts = Model.Apartments.Where(a => a.FloorId == floor.Id).OrderBy(a => a.Number).ToList();
        <div class="col-md-6 mb-3">
            <div class="bg-white rounded shadow-sm p-3">
                <h5>@floor.Label <span class="text-muted small">(دور رقم @floor.Order)</span></h5>
                <ul class="list-group list-group-flush">
                    @foreach (var apt in apts)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span>🏠 شقة @apt.Number @(string.IsNullOrEmpty(apt.Label) ? "" : "— " + apt.Label)</span>
                                <div class="text-muted small">@apt.Owner</div>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <span class="text-muted small">@apt.Phone @(apt.Closed ? "🔒" : "")</span>
                                <button type="button" class="btn btn-sm btn-outline-warning"
                                        onclick="openQuickQrModal('@apt.Id', '@apt.Number', '@floor.Label')">
                                    ⚡ QR سريع
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

<!-- ============================================================ -->
<!-- Modal QR سريع (نفس بتاع Super Admin) -->
<!-- ============================================================ -->
<div class="modal fade" id="quickQrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning bg-opacity-25">
                <h5 class="modal-title">⚡ QR سريع — <span id="quickAptInfo"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="quickQrForm">
                    <div class="alert alert-info small">
                        💡 الـ QR السريع بيسمح للساكن يدخل مباشرة بدون إدخال أي بيانات. آمن ومشفّر.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">⏱️ مدة الصلاحية</label>
                        <select id="validitySelect" class="form-select">
                            <option value="5">5 دقائق</option>
                            <option value="15">15 دقيقة</option>
                            <option value="60" selected>ساعة واحدة</option>
                            <option value="360">6 ساعات</option>
                            <option value="1440">يوم واحد</option>
                            <option value="10080">أسبوع</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">🔢 نوع الاستخدام</label>
                        <div class="form-check">
                            <input type="radio" name="usageType" value="once" class="form-check-input" id="usageOnce" checked />
                            <label class="form-check-label" for="usageOnce">
                                <strong>مرة واحدة فقط</strong>
                                <div class="text-muted small">الأكثر أمانًا — الرابط يبطل بعد أول استخدام</div>
                            </label>
                        </div>
                        <div class="form-check mt-2">
                            <input type="radio" name="usageType" value="multiple" class="form-check-input" id="usageMultiple" />
                            <label class="form-check-label" for="usageMultiple">
                                <strong>متعدد حتى انتهاء الصلاحية</strong>
                                <div class="text-muted small">مناسب لو الساكن هيدخل من أكتر من جهاز</div>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3" id="maxUsesField" style="display:none">
                        <label class="form-label">الحد الأقصى للاستخدام</label>
                        <input type="number" id="maxUsesInput" class="form-control" value="5" min="1" max="100" />
                    </div>
                </div>

                <div id="quickQrResult" style="display:none">
                    <div class="alert alert-success text-center">✅ تم توليد QR السريع بنجاح</div>

                    <div class="text-center mb-3">
                        <img id="quickQrImage" src="" alt="QR" class="img-fluid border rounded p-2" style="max-width:280px" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">🔗 الرابط السريع</label>
                        <div class="input-group">
                            <input type="text" id="quickQrUrl" class="form-control form-control-sm" readonly />
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyQuickUrl()">📋 نسخ</button>
                            <a id="quickQrOpenLink" href="" target="_blank" class="btn btn-sm btn-outline-success">🔗 فتح</a>
                        </div>
                    </div>

                    <div class="text-muted small" id="quickQrInfo"></div>

                    <div class="alert alert-warning small mt-3">
                        ⚠️ ابعت الرابط ده للساكن عن طريق واتساب. بعد انتهاء الصلاحية أو استخدامه، مش هيعمل تاني.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="generateBtn" class="btn btn-warning" onclick="generateQuickQr()">⚡ توليد QR</button>
                <button type="button" id="newQrBtn" class="btn btn-outline-warning" style="display:none" onclick="resetQuickQrForm()">🔄 توليد جديد</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentAptId = '';

        function openQuickQrModal(aptId, aptNum, floorLabel) {
            currentAptId = aptId;
            document.getElementById('quickAptInfo').textContent = `${floorLabel} — شقة ${aptNum}`;
            resetQuickQrForm();
            new bootstrap.Modal(document.getElementById('quickQrModal')).show();
        }

        function resetQuickQrForm() {
            document.getElementById('quickQrForm').style.display = 'block';
            document.getElementById('quickQrResult').style.display = 'none';
            document.getElementById('generateBtn').style.display = 'inline-block';
            document.getElementById('newQrBtn').style.display = 'none';
            document.getElementById('validitySelect').value = '60';
            document.getElementById('usageOnce').checked = true;
            document.getElementById('maxUsesField').style.display = 'none';
            document.getElementById('maxUsesInput').value = '5';
        }

        document.querySelectorAll('input[name="usageType"]').forEach(r => {
            r.addEventListener('change', () => {
                document.getElementById('maxUsesField').style.display =
                    (r.value === 'multiple' && r.checked) ? 'block' : 'none';
            });
        });

        async function generateQuickQr() {
            const validity = parseInt(document.getElementById('validitySelect').value);
            const usageType = document.querySelector('input[name="usageType"]:checked').value;
            const maxUses = usageType === 'once' ? 1 : parseInt(document.getElementById('maxUsesInput').value);

            const btn = document.getElementById('generateBtn');
            btn.disabled = true;
            btn.textContent = '⏳ جاري التوليد...';

            try {
                const formData = new FormData();
                formData.append('aptId', currentAptId);
                formData.append('validityMinutes', validity);
                formData.append('oneTime', usageType === 'once' ? 'true' : 'false');
                formData.append('maxUses', maxUses);
                formData.append('__RequestVerificationToken',
                    document.querySelector('input[name="__RequestVerificationToken"]').value);

                const res = await fetch('@Url.Action("GenerateQuickQr", "AdminApts")', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();
                if (!data.success) {
                    alert('❌ فشل توليد QR: ' + (data.error || 'خطأ غير معروف'));
                    return;
                }

                document.getElementById('quickQrForm').style.display = 'none';
                document.getElementById('quickQrResult').style.display = 'block';
                document.getElementById('generateBtn').style.display = 'none';
                document.getElementById('newQrBtn').style.display = 'inline-block';

                document.getElementById('quickQrImage').src =
                    `https://api.qrserver.com/v1/create-qr-code/?size=280x280&data=${encodeURIComponent(data.url)}`;
                document.getElementById('quickQrUrl').value = data.url;
                document.getElementById('quickQrOpenLink').href = data.url;

                const usageText = data.oneTime ? 'مرة واحدة فقط' : `حتى ${data.maxUses} استخدام`;
                document.getElementById('quickQrInfo').innerHTML =
                    `⏱️ صالح لمدة <strong>${data.expiresIn}</strong> دقيقة &nbsp;|&nbsp; 🔢 ${usageText}`;
            } catch (err) {
                alert('❌ خطأ: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.textContent = '⚡ توليد QR';
            }
        }

        function copyQuickUrl() {
            const input = document.getElementById('quickQrUrl');
            input.select();
            input.setSelectionRange(0, 99999);
            document.execCommand('copy');
            alert('✅ تم نسخ الرابط');
        }
    </script>
}
