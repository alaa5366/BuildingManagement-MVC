@model BuildingManagementMvc.Models.PagedResult<BuildingManagementMvc.Services.AuditEntryDoc>
@{
    ViewData["Title"] = Loc.T("Log");
    var role = ViewBag.CurrentRole as string ?? "admin";
    var buildings = ViewBag.Buildings as List<BuildingManagementMvc.Models.Building> ?? new();
    var knownActions = ViewBag.KnownActions as List<string> ?? new();
    var canFilterBuilding = ViewBag.CanFilterByBuilding as bool? ?? false;
    var canFilterApartment = ViewBag.CanFilterByApartment as bool? ?? false;
    var routeValues = ViewBag.RouteValues as Dictionary<string, string?> ?? new();

    // ✅ تجهيز RouteValues للـ Partial (بدون القيم الفاضية)
    var routeValuesStr = new Dictionary<string, string>();
    foreach (var kv in routeValues)
    {
        if (!string.IsNullOrWhiteSpace(kv.Value))
            routeValuesStr[kv.Key] = kv.Value!;
    }
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            @Loc.T("Log_2")
            @if (role == "superadmin")
            {
                <small class="text-muted">@Loc.T("All_Records")</small>
            }
            else if (role == "admin")
            {

                <small class="text-muted">@Loc.T("My_Building_S_Log")</small>
            }
            else
            {

                <small class="text-muted">@Loc.T("My_Apartment_S_Log")</small>
            }
        </h2>
        <div>
            <span class="badge bg-secondary">@Loc.T("N_Operations", Model.TotalItems)</span>
            <a asp-action="ExportCsv"
               asp-route-buildingId="@ViewBag.SelectedBuildingId"
               asp-route-apartmentId="@ViewBag.SelectedApartmentId"
               asp-route-userId="@ViewBag.SelectedUserId"
               asp-route-actionFilter="@ViewBag.SelectedAction"
               asp-route-severity="@ViewBag.SelectedSeverity"
               asp-route-from="@ViewBag.From"
               asp-route-to="@ViewBag.To"
               class="btn btn-outline-success">@Loc.T("Export_CSV")</a>
        </div>
    </div>

    @* ============ الفلاتر ============ *@
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                @if (canFilterBuilding && buildings.Count > 0)
                {
                    <div class="col-md-3">
                        <label class="form-label small">@Loc.T("Building")</label>
                        <select name="buildingId" class="form-select form-select-sm">
                            <option value="">@Loc.T("All_Buildings")</option>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id" selected="@(ViewBag.SelectedBuildingId == b.Id)">@b.Name (@b.BuildingNumber)</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-md-3">
                    <label class="form-label small">@Loc.T("Action")</label>
                    <select name="actionFilter" class="form-select form-select-sm">
                        <option value="">@Loc.T("All")</option>
                        @foreach (var a in knownActions)
                        {
                            <option value="@a" selected="@(ViewBag.SelectedAction == a)">
                                @BuildingManagementMvc.Services.AuditLogQueryService.LabelAr(a)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small">@Loc.T("Severity")</label>
                    <select name="severity" class="form-select form-select-sm">
                        <option value="">@Loc.T("All")</option>
                        <option value="info" selected="@(ViewBag.SelectedSeverity == "info")">@Loc.T("Info")</option>
                        <option value="warning" selected="@(ViewBag.SelectedSeverity == "warning")">@Loc.T("Warning")</option>
                        <option value="critical" selected="@(ViewBag.SelectedSeverity == "critical")">@Loc.T("Critical")</option>
                    </select>
                </div>

                @if (canFilterApartment)
                {
                    <div class="col-md-2">
                        <label class="form-label small">Apartment ID</label>
                        <input name="apartmentId" value="@ViewBag.SelectedApartmentId" class="form-control form-control-sm" placeholder="@Loc.T("Optional")" />
                    </div>
                }

                <div class="col-md-2">
                    <label class="form-label small">@Loc.T("From_Date")</label>
                    <input name="from" type="date" value="@ViewBag.From" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small">@Loc.T("To_Date")</label>
                    <input name="to" type="date" value="@ViewBag.To" class="form-control form-control-sm" />
                </div>

                @* ✅ بنحفظ حجم الصفحة الحالي *@
                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <div class="col-md-2">
                    <button class="btn btn-primary btn-sm w-100">@Loc.T("Filter")</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">@Loc.T("Reset")</a>
                </div>
            </form>
        </div>
    </div>

    @* ============ Pagination (فوق) ============ *@
    @{
        ViewData["CurrentPage"] = Model.CurrentPage;
        ViewData["PageSize"] = Model.PageSize;
        ViewData["TotalItems"] = Model.TotalItems;
        ViewData["TotalPages"] = Model.TotalPages;
        ViewData["HasPrevious"] = Model.HasPrevious;
        ViewData["HasNext"] = Model.HasNext;
        ViewData["FirstItemIndex"] = Model.FirstItemIndex;
        ViewData["LastItemIndex"] = Model.LastItemIndex;
        ViewData["ActionName"] = "Index";
        ViewData["ControllerName"] = "AuditLog";
        ViewData["RouteValues"] = routeValuesStr;
        ViewData["PageSizeOptions"] = new[] { 10, 25, 50, 100 };
    }
    @await Html.PartialAsync("_Pagination", new
    {
        CurrentPage = Model.CurrentPage,
        PageSize = Model.PageSize,
        TotalItems = Model.TotalItems,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        FirstItemIndex = Model.FirstItemIndex,
        LastItemIndex = Model.LastItemIndex,
        ActionName = "Index",
        ControllerName = "AuditLog",
        RouteValues = routeValuesStr,
        PageSizeOptions = new[] { 10, 25, 50, 100 }
    })

    @* ============ الجدول ============ *@
    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">@Loc.T("No_Records_Match_The_Filters")</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>@Loc.T("Date")</th>
                        <th>@Loc.T("Action")</th>
                        <th>@Loc.T("Severity")</th>
                        <th>@Loc.T("User")</th>
                        <th>@Loc.T("Role")</th>
                        <th>@Loc.T("Building")</th>
                        <th>@Loc.T("Apartment")</th>
                        <th>@Loc.T("Details")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <small>@e.EffectiveDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small>
                            </td>
                            <td>
                                <strong>@BuildingManagementMvc.Services.AuditLogQueryService.LabelAr(e.Action)</strong>
                                <br /><small class="text-muted"><code>@e.Action</code></small>
                            </td>
                            <td>
                                <span class="badge @BuildingManagementMvc.Services.AuditLogQueryService.SeverityBadgeClass(e.Severity)">
                                    @BuildingManagementMvc.Services.AuditLogQueryService.SeverityLabelAr(e.Severity)
                                </span>
                            </td>
                            <td><small>@(e.UserId ?? "—")</small></td>
                            <td>
                                @if (!string.IsNullOrEmpty(e.UserRole))
                                {
                                    <span class="badge bg-secondary">@e.UserRole</span>
                                }
                            </td>
                            <td><small>@(e.BuildingId ?? "—")</small></td>
                            <td><small>@(e.ApartmentId ?? "—")</small></td>
                            <td>
                                @if (e.Metadata != null && e.Metadata.Count > 0)
                                {
                                    <button class="btn btn-sm btn-outline-info" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#meta-@e.Id">
                                        @Loc.T("View")
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (e.Metadata != null && e.Metadata.Count > 0)
                        {
                            <tr class="collapse" id="meta-@e.Id">
                                <td colspan="8">
                                    <pre class="bg-light p-2 mb-0" style="font-size:11px;max-height:200px;overflow:auto;">@System.Text.Json.JsonSerializer.Serialize(e.Metadata, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping })</pre>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @* ============ Pagination (تحت) ============ *@
    @{
        ViewData["CurrentPage"] = Model.CurrentPage;
        ViewData["PageSize"] = Model.PageSize;
        ViewData["TotalItems"] = Model.TotalItems;
        ViewData["TotalPages"] = Model.TotalPages;
        ViewData["HasPrevious"] = Model.HasPrevious;
        ViewData["HasNext"] = Model.HasNext;
        ViewData["FirstItemIndex"] = Model.FirstItemIndex;
        ViewData["LastItemIndex"] = Model.LastItemIndex;
        ViewData["ActionName"] = "Index";
        ViewData["ControllerName"] = "AuditLog";
        ViewData["RouteValues"] = routeValuesStr;
        ViewData["PageSizeOptions"] = new[] { 10, 25, 50, 100 };
    }
    @await Html.PartialAsync("_Pagination", new
    {
        CurrentPage = Model.CurrentPage,
        PageSize = Model.PageSize,
        TotalItems = Model.TotalItems,
        TotalPages = Model.TotalPages,
        HasPrevious = Model.HasPrevious,
        HasNext = Model.HasNext,
        FirstItemIndex = Model.FirstItemIndex,
        LastItemIndex = Model.LastItemIndex,
        ActionName = "Index",
        ControllerName = "AuditLog",
        RouteValues = routeValuesStr,
        PageSizeOptions = new[] { 10, 25, 50, 100 }
    })
</div>