@model List<BuildingManagementMvc.Models.Building>
@{
    ViewData["Title"] = "اختر العمارة";
}

<div class="container">
    <h2>🏢 اختر العمارة لإدارة فئاتها المالية</h2>
    <div class="list-group mt-3">
        @foreach (var b in Model)
        {
            <a asp-action="Manage" asp-route-id="@b.Id" class="list-group-item list-group-item-action">
                <strong>@b.Name</strong>
                <small class="text-muted">— @b.BuildingNumber</small>
            </a>
        }
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">لا توجد عمارات.</div>
        }
    </div>
</div>