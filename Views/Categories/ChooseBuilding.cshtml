@model List<BuildingManagementMvc.Models.Building>
@{
    ViewData["Title"] = Loc.T("Select_Building");
}

<div class="container">
    <h2>@Loc.T("Select_The_Building_To_Manage_Its")</h2>
    <div class="list-group mt-3">
        @foreach (var b in Model)
        {
            <a asp-action="Manage" asp-route-id="@b.Id" class="list-group-item list-group-item-action">
                <strong>@b.Name</strong>
                <small class="text-muted">— @b.BuildingNumber</small>
            </a>
        }
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">@Loc.T("No_Buildings_Found")</div>
        }
    </div>
</div>