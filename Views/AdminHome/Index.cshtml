@model Building
@{ ViewData["Title"] = "لوحة الأدمن"; }

@if (Model == null)
{
    <div class="alert alert-warning">لا يمكن تحديد العمارة الخاصة بحسابك.</div>
}
else
{
    <h3>مرحبًا بك في إدارة عمارة @Model.Name (@Model.BuildingNumber)</h3>
    <p class="text-muted">
        عدد الأدوار: @Model.Floors.Count — عدد الشقق: @Model.Apartments.Count
    </p>
    <div class="d-flex gap-2 mb-3">
        <a asp-controller="Wallet" asp-action="Index" class="btn btn-brand">💼 المحفظة</a>
        <a asp-controller="Expenses" asp-action="Index" class="btn btn-brand">💰 المصروفات</a>
        <a asp-controller="Revenues" asp-action="Index" class="btn btn-brand">📈 الإيرادات</a>
    </div>
    <div class="alert alert-info">
        باقي شاشات الأدمن (التقارير، الفواتير، التصويتات، الصيانة...) هتتضاف في المراحل الجاية.
    </div>
}
