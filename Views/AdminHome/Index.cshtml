@{
    ViewData["Title"] = "لوحة الأدمن";
    var buildingName = User.FindFirst("buildingName")?.Value ?? User.Identity?.Name ?? "عمارتي";
}

<div class="text-center mb-4">
    <h2>مرحبًا بك في إدارة عمارة @buildingName</h2>
    <p class="text-muted">@ViewBag.FloorsCount دور — @ViewBag.AptsCount شقة</p>
</div>

<div class="row justify-content-center g-3">
    <div class="col-md-3">
        <a asp-controller="Wallet" asp-action="Index" class="btn btn-brand w-100 py-3">
            💼 المحفظة
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Expenses" asp-action="Index" class="btn btn-brand w-100 py-3">
            💸 المصروفات
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Revenues" asp-action="Index" class="btn btn-brand w-100 py-3">
            💰 الإيرادات
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Reports" asp-action="Index" class="btn btn-brand w-100 py-3">
            📊 التقارير
        </a>
    </div>
</div>

<div class="row justify-content-center g-3 mt-3">
    <div class="col-md-4">
        <a asp-controller="AdminApts" asp-action="Index" class="btn btn-outline-warning w-100 py-3">
            🏠 إدارة الشقق + QR سريع
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary w-100 py-3">
            🏷️ الفئات المالية
        </a>
    </div>
    <div class="row justify-content-center g-3 mt-3">
        <div class="col-md-3">
            <a asp-controller="Polls" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
                🗳️ التصويتات
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Maintenance" asp-action="Index" class="btn btn-outline-info w-100 py-3">
                🔧 الصيانة
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-success w-100 py-3">
                🔔 الإشعارات
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="WhatsApp" asp-action="Index" class="btn btn-outline-success w-100 py-3">
                💬 واتساب
            </a>
        </div>
    </div>
    <div class="row justify-content-center g-3 mt-3">
        <div class="col-md-6">
            <a asp-controller="AuditLog" asp-action="Index" class="btn btn-dark w-100 py-3">
                📜 السجل
            </a>
        </div>
    </div>
</div>