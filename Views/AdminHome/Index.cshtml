@model BuildingManagementMvc.ViewModels.BuildingMapViewModels
@{
    ViewData["Title"] = Loc.T("Admin_Dashboard");
    var stats = Model.Stats;
}

<link rel="stylesheet" href="~/css/building-map.css" asp-append-version="true" />

<div class="container-fluid">

    @* ===== Header ===== *@
    <div class="text-center mb-4">
        <h2>🏢 @Model.Building.Name — @Model.Building.BuildingNumber</h2>
        <p class="text-muted mb-1">
            @Loc.T("N_Floors_N_Apartments_N_Open", stats.FloorsCount, stats.AptsCount, stats.OpenAptsCount)
            @if (stats.ClosedAptsCount > 0)
            {
                <text> @Loc.T("N_Closed", stats.ClosedAptsCount)</text>
            }
            )
        </p>
    </div>

    @* ===== Stats Cards ===== *@
    <div class="row g-2 mb-4 justify-content-center">
        <div class="col-md-2 col-6">
            <div class="stat-card stat-online">
                <div class="stat-icon">🟢</div>
                <div class="stat-value">@stats.OnlineCount</div>
                <div class="stat-label">@Loc.T("Online")</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-balance">
                <div class="stat-icon">💰</div>
                <div class="stat-value">@stats.TotalBalance.ToString("N0")</div>
                <div class="stat-label">@Loc.T("Total_Balance")</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-debtors">
                <div class="stat-icon">🔴</div>
                <div class="stat-value">@stats.DebtorsCount</div>
                <div class="stat-label">@Loc.T("Debtors")</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-pending">
                <div class="stat-icon">⏳</div>
                <div class="stat-value">@stats.PendingDepositsCount</div>
                <div class="stat-label">@Loc.T("Pending_Payments")</div>
            </div>
        </div>
    </div>

    @* ===== Building Map ===== *@
    @foreach (var floor in Model.Floors)
    {
        <div class="floor-section">
            <div class="floor-header">
                <h5 class="mb-0">
                    🏢 @floor.Label
                    <span class="text-muted small">@Loc.T("Floor_N", floor.Order)</span>
                    <span class="badge bg-secondary ms-2">@Loc.T("N_Apartments", floor.Apartments.Count)</span>

                    @if (floor.OnlineCount > 0)
                    {
                        <span class="badge bg-success ms-1">🟢 @floor.OnlineCount</span>
                    }
                    @if (floor.DebtorsCount > 0)
                    {
                        <span class="badge bg-danger ms-1">🔴 @floor.DebtorsCount</span>
                    }
                </h5>
            </div>
            <div class="apartments-grid">
                @foreach (var card in floor.Apartments)
                {
                    @await Html.PartialAsync("_ApartmentCard", card)
                }
            </div>
        </div>
    }

    @* ===== Legend ===== *@
    <div class="legend-bar mt-4">
        <strong>@Loc.T("Legend")</strong>
        <span class="legend-item"><span class="legend-dot" style="background:#2E7D5B;"></span> @Loc.T("Online")</span>
        <span class="legend-item"><span class="legend-dot" style="background:#D9B34A;"></span> @Loc.T("Seen_Recently")</span>
        <span class="legend-item"><span class="legend-dot" style="background:#999;"></span> @Loc.T("Offline")</span>
        <span class="legend-item"><span class="legend-dot" style="background:#A0432A;"></span> @Loc.T("Negative_Balance")</span>
        <span class="legend-item"><span class="legend-dot" style="background:#5B9BD5;"></span> @Loc.T("Closed")</span>
        <span class="legend-item"><span class="legend-dot" style="background:#8E6BB2;"></span> @Loc.T("Disabled_3")</span>
    </div>

    @* ===== Quick Actions ===== *@
    <div class="row justify-content-center g-3 mt-4 mb-5">

        @* المحفظة *@
        <div class="col-md-3 col-6">
            <a asp-controller="Wallet" asp-action="Index"
               class="btn btn-outline-brand w-100 py-3">
                <i class="bi bi-wallet2"></i>
                @Loc.T("Wallet")
            </a>
        </div>

        @* إدارة الشقق *@
        <div class="col-md-3 col-6">
            <a asp-controller="AdminApts" asp-action="Index"
               class="btn btn-outline-warning w-100 py-3">
                <i class="bi bi-door-closed"></i>
                @Loc.T("Manage_Apartments_2")
            </a>
        </div>

        @* التقارير *@
        <div class="col-md-3 col-6">
            <a asp-controller="Reports" asp-action="Index"
               class="btn btn-outline-success w-100 py-3">
                <i class="bi bi-graph-up"></i>
                @Loc.T("Reports")
            </a>
        </div>

        @* الكاميرات — للأدمنز اللي عندهم الصلاحية *@
        @if (User.HasClaim("perm", "cameras.view") || User.HasClaim("perm", "dvrs.manage"))
        {
            <div class="col-md-3 col-6">
                <a asp-controller="Cameras" asp-action="Live"
                   asp-route-buildingId="@Model.Building.Id"
                   class="btn btn-outline-danger w-100 py-3">
                    <i class="bi bi-camera-video"></i>
                    @Loc.T("Nav_Cameras")
                </a>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        window.I18N = Object.assign(window.I18N || {}, @Html.Raw(Loc.JsonDict(
                            "Js_AptDetails_Title",
                            "Js_Loading",
                            "Js_Close",
                            "Js_LoadFailed",
                            "Js_ConfirmImpersonate",
                            "Js_ConfirmOpenApt",
                            "Js_PromptCloseApt",
                            "Js_ConfirmCloseApt",
                            "Js_PromptDisableApt",
                            "Js_ConfirmDisableApt",
                            "Js_PromptEnableApt",
                            "Js_ConfirmEnableApt"
                    )));
    </script>
    <script src="~/js/apartment-details.js" asp-append-version="true"></script>
}