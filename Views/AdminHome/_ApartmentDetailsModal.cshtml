@model BuildingManagementMvc.ViewModels.ApartmentDetailsVm
@{
    var balanceClass = Model.Balance < 0 ? "text-danger" : "text-success";
}

<div class="apartment-details-modal">

    @* ===== Header ===== *@
    <div class="apt-details-header" style="border-right-color: @Model.StatusColor;">
        <div class="d-flex align-items-center gap-3">
            <div class="apt-details-avatar" style="background: @Model.StatusColor;">
                @Model.OwnerInitial
            </div>
            <div class="flex-grow-1">
                <h4 class="mb-1">
                    @Loc.T("Apartment_N_2", Model.AptNumber)
                    @if (!string.IsNullOrWhiteSpace(Model.AptLabel))
                    {
                        <small class="text-muted">— @Model.AptLabel</small>
                    }
                </h4>
                <div class="text-muted small">
                    @Loc.T("N_Floor_N", Model.FloorLabel, Model.FloorOrder)
                    <span class="ms-2 badge" style="background: @Model.StatusColor;">
                        @Model.StatusIcon @Model.StatusLabel
                    </span>
                </div>
            </div>
        </div>
    </div>

    @* ===== Content ===== *@
    <div class="apt-details-body">

        @* ===== Owner Info ===== *@
        <div class="details-section">
            <h6 class="details-section-title">@Loc.T("Resident")</h6>
            <div class="details-grid">
                <div class="detail-item">
                    <label>@Loc.T("Name")</label>
                    <span>@(string.IsNullOrWhiteSpace(Model.Owner) ? "—" : Model.Owner)</span>
                </div>
                <div class="detail-item">
                    <label>@Loc.T("Mobile")</label>
                    <span dir="ltr">@Model.Phone</span>
                </div>
                <div class="detail-item">
                    <label>🔒 PIN</label>
                    <span class="pin-value">@Model.Pin</span>
                </div>
                <div class="detail-item">
                    <label>@Loc.T("Last_Seen")</label>
                    <span>@Model.LastSeenText</span>
                </div>
            </div>
        </div>

        @* ===== Financial ===== *@
        <div class="details-section">
            <h6 class="details-section-title">@Loc.T("Finance")</h6>
            <div class="financial-cards">
                <div class="fin-card fin-balance">
                    <div class="fin-label">@Loc.T("Current_Balance")</div>
                    <div class="fin-value @balanceClass">
                        @Loc.T("N_EGP", Model.Balance.ToString("N0"))
                    </div>
                </div>
                <div class="fin-card fin-collected">
                    <div class="fin-label">@Loc.T("Collected_This_Month")</div>
                    <div class="fin-value">@Loc.T("N_EGP", Model.TotalCollectedThisMonth.ToString("N0"))</div>
                </div>
                <div class="fin-card fin-pending">
                    <div class="fin-label">@Loc.T("Pending_Payments")</div>
                    <div class="fin-value">@Model.PendingDepositsCount</div>
                </div>
                <div class="fin-card fin-confirmed">
                    <div class="fin-label">@Loc.T("Confirmed_Payments")</div>
                    <div class="fin-value">@Model.ConfirmedDepositsCount</div>
                </div>
            </div>
        </div>

        @* ===== Recent Deposits ===== *@
        @if (Model.RecentDeposits.Any())
        {
            <div class="details-section">
                <h6 class="details-section-title">@Loc.T("Latest_Payments")</h6>
                <table class="table table-sm details-table">
                    <thead>
                        <tr>
                            <th>@Loc.T("No")</th>
                            <th>@Loc.T("Amount")</th>
                            <th>@Loc.T("Status")</th>
                            <th>@Loc.T("Date")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dep in Model.RecentDeposits)
                        {
                            <tr>
                                <td>@dep.Number</td>
                                <td>@Loc.T("N_EGP", dep.Amount.ToString("N0"))</td>
                                <td>@dep.StatusLabel</td>
                                <td class="text-muted small">@dep.DateText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @* ===== Quick Actions ===== *@
        <div class="details-section">
            <h6 class="details-section-title">@Loc.T("Quick_Actions")</h6>
            <div class="quick-actions-grid">

                <a asp-controller="Invoice" asp-action="Download"
                   asp-route-aptId="@Model.AptId"
                   asp-route-month="@Model.CurrentMonth"
                   target="_blank"
                   class="qa-btn qa-invoice">
                    <span class="qa-icon">🧾</span>
                    <span>@Loc.T("PDF_Invoice")</span>
                </a>

                <a asp-controller="AdminApts" asp-action="Edit" asp-route-aptId="@Model.AptId"
                   class="qa-btn qa-edit">
                    <span class="qa-icon">✏️</span>
                    <span>@Loc.T("Edit_Apartment")</span>
                </a>

               <button type="button" class="qa-btn qa-wallet"
                onclick="enterResidentWallet('@Model.AptId')">
                <span class="qa-icon">💼</span>
                <span>@Loc.T("Wallet_2")</span>
                </button>

                <button type="button" class="qa-btn qa-welcome"
                        onclick="sendWelcomeFromDetails('@Model.AptId')">
                    <span class="qa-icon">💌</span>
                    <span>@Loc.T("Welcome_Message")</span>
                </button>

                <button type="button" class="qa-btn qa-qr"
                        onclick="quickQrFromDetails('@Model.AptId')">
                    <span class="qa-icon">⚡</span>
                    <span>@Loc.T("Quick_QR_4")</span>
                </button>

                <button type="button" class="qa-btn qa-impersonate"
                        onclick="impersonateResident('@Model.AptId')">
                    <span class="qa-icon">🚪</span>
                    <span>@Loc.T("Log_In_As_Resident")</span>
                </button>

            </div>
        </div>

    </div>
    @* ===== Status Actions ===== *@

    @* ✅ Disabled ======= *@
    @if (Model.IsDisabled)
    {
        <div class="details-section">
            <h6 class="details-section-title">🚫 @Loc.T("Disabled_3")</h6>
            <div class="alert alert-warning small mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.DisabledReason))
                {
                    <strong>@Loc.T("Reason")</strong> 
                    @Model.DisabledReason
                    <br />
                }
                @Loc.T("Disable_Apartment_Means_It_Will")
            </div>
            <button type="button" class="btn btn-success btn-lg w-100"
                    onclick="enableApartment('@Model.AptId', '@Model.AptNumber')">
                ✅ @Loc.T("Enable_Apartment")
            </button>
        </div>
    }
    else
    {
        @* ✅ Closed ======= *@
        if (Model.IsClosed)
        {
            <div class="details-section">
                <h6 class="details-section-title">@Loc.T("Apartment_Is_Closed")</h6>
                <div class="alert alert-info small mb-3">
                    @Loc.T("Closing_Date")<strong>@Model.CloseDateText</strong>
                    <br />
                    @Loc.T("When_You_Open_The_Apartment_It")
                </div>
                <button type="button" class="btn btn-success btn-lg w-100"
                        onclick="openApartment('@Model.AptId', '@Model.AptNumber')">
                    @Loc.T("Open_Apartment")
                </button>
            </div>
        }
        else
        {
            <div class="details-section">
                <h6 class="details-section-title">@Loc.T("Close_Apartment")</h6>
                <div class="alert alert-warning small mb-3">
                    @Loc.T("Closing_The_Apartment_Means_It_Will")
                </div>
                <button type="button" class="btn btn-outline-danger w-100 mb-2"
                        onclick="closeApartment('@Model.AptId', '@Model.AptNumber')">
                    @Loc.T("Close_Apartment")
                </button>

                <button type="button" class="btn btn-outline-secondary w-100"
                        onclick="disableApartment('@Model.AptId', '@Model.AptNumber')">
                    🚫 @Loc.T("Disable_Apartment")
                </button>
            </div>
        }
    }