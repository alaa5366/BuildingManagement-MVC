@model BuildingManagementMvc.Models.QrBuildingPageModel
@{ ViewData["Title"] = Loc.T("QR_Codes"); }

<h3 class="mb-3">@Loc.T("Apartment_QR_Codes_N", Model.BuildingName)</h3>

<div class="row">
@foreach (var apt in Model.Apartments)
{
    <div class="col-md-4 col-lg-3 mb-3">
        <div class="bg-white rounded shadow-sm p-3 text-center">
            <div class="fw-bold mb-1">@Loc.T("Apartment_N", apt.ApartmentNumber)</div>
            <div class="text-muted small mb-2">@apt.FloorLabel</div>
            <a class="btn btn-sm btn-outline-secondary w-100 mb-2" asp-action="ApartmentBadge" asp-route-aptId="@apt.ApartmentId">
                @Loc.T("Download_Door_QR")
            </a>
            <form method="post" asp-action="GenerateAccessLink" class="d-flex gap-1">
                <input type="hidden" name="aptId" value="@apt.ApartmentId" />
                <select name="minutes" class="form-select form-select-sm">
                    <option value="15">@Loc.T("15_Minutes")</option>
                    <option value="60">@Loc.T("Hour")</option>
                </select>
                <button class="btn btn-sm btn-brand text-nowrap">@Loc.T("Login_Link")</button>
                <input type="hidden" name="oneTime" value="true" />
            </form>
        </div>
    </div>
}
</div>
