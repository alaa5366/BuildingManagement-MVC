@{
    ViewData["Title"] = Loc.T("Login_With_QR");
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div style="font-size: 60px;">🏠</div>
        <h2 class="mt-3">@ViewBag.BuildingName</h2>
        <p class="text-muted">@Loc.T("Apartment") @ViewBag.AptNumber</p>

        @* الدخول بيحصل بالضغط على الزرار (POST) — مش بمجرد فتح الرابط، عشان معاينة الرابط ماتحرقش الـ QR *@
        <form method="post" asp-action="QuickLoginConfirm">
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <button type="submit" class="btn btn-brand mt-3">@Loc.T("Log_In")</button>
        </form>
    </div>
</div>
