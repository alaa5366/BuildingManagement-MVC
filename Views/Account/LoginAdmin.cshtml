@model AdminLoginVm
@{
    ViewData["Title"] = Loc.T("Admin_Login");
    var buildings = ViewBag.Buildings as List<Building> ?? new();
}

<div class="auth-wrap">
    <div class="auth-card">
        <a asp-action="LoginChoice" class="link-btn back-link">@Loc.T("Back")</a>
        <h2>@Loc.T("Admin_Login")</h2>
        <p class="sub">@Loc.T("Choose_The_Building_And_Enter_Your")</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="LoginAdmin">
            @Html.AntiForgeryToken()

            <div class="field">
                <label>@Loc.T("Building")</label>
                <select name="BuildingId" class="form-select" required>
                    <option value="">@Loc.T("Select")</option>
                    @foreach (var b in buildings)
                    {
                        <option value="@b.Id">@b.BuildingNumber — @b.Name</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>@Loc.T("WhatsApp_Number")</label>
                <input name="Phone" type="tel" class="form-control"
                       placeholder="+201001234567" required dir="ltr" />
            </div>

            <div class="field">
                <label>PIN</label>
                <input name="Pin" type="password" class="form-control" required maxlength="4" />
            </div>

            <button type="submit" class="btn btn-brand w-100">@Loc.T("Log_In")</button>
        </form>
    </div>
</div>

<style>
    .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 40px 20px;
    }

    .auth-card {
        background: white;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 480px;
    }

        .auth-card h2 {
            margin-bottom: 8px;
            color: #12433C;
            font-weight: 700;
        }

        .auth-card .sub {
            color: #666;
            font-size: 13px;
            margin-bottom: 24px;
        }

    .field {
        margin-bottom: 18px;
    }

        .field label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 6px;
        }

    .back-link {
        display: inline-block;
        margin-bottom: 16px;
        color: #12433C;
        text-decoration: none;
        font-size: 13px;
    }

    .link-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }
</style>