@* Unified login with an in-page second-factor step. *@
@model UnifiedLoginVm
@{
    ViewData["Title"] = Loc.T("Log_In_2");
    var twoFactorStep = ViewBag.TwoFactorStep is bool step && step;
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-brand text-center">
            <div class="auth-brand-icon" aria-hidden="true">🏢</div>
            <h1>@Loc.T("Building_Management_System")</h1>
            <p>@(twoFactorStep ? "Verify your identity to complete sign-in" : Loc.T("Sign_In_To_Continue"))</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
        }

        @if (twoFactorStep)
        {
            <div class="auth-security-note">
                <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                <div>
                    <strong>Two-step verification</strong>
                    <span>Your password was accepted. Enter the code from your authenticator app, or use a recovery code.</span>
                </div>
            </div>

            <form method="post" asp-action="UnifiedLogin" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label asp-for="TwoFactorCode">Authenticator or recovery code</label>
                    <input asp-for="TwoFactorCode"
                           class="form-control form-control-lg auth-code-input"
                           autocomplete="one-time-code"
                           inputmode="numeric"
                           maxlength="64"
                           autofocus
                           placeholder="000000"
                           aria-describedby="twoFactorHelp" />
                    <span asp-validation-for="TwoFactorCode" class="text-danger small"></span>
                    <div id="twoFactorHelp" class="form-text">Enter your current six-digit code or one unused recovery code.</div>
                </div>
                <button type="submit" class="btn btn-brand w-100 btn-lg">
                    <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                    Verify and sign in
                </button>
            </form>

            <form method="post" asp-action="CancelTwoFactor" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link w-100 text-decoration-none">Back to sign in</button>
            </form>
        }
        else
        {
            <form method="post" asp-action="UnifiedLogin" autocomplete="on">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="field">
                    <label asp-for="Identifier">@Loc.T("Email_Phone_Number")</label>
                    <input asp-for="Identifier"
                           class="form-control form-control-lg"
                           placeholder="@Loc.T("You_Example_Com_Or_201001234567")"
                           autocomplete="username"
                           autofocus />
                    <span asp-validation-for="Identifier" class="text-danger small"></span>
                </div>

                <div class="field">
                    <label asp-for="Credential">@Loc.T("Password_PIN")</label>
                    <input asp-for="Credential"
                           type="password"
                           class="form-control form-control-lg"
                           placeholder="••••••••"
                           autocomplete="current-password" />
                    <span asp-validation-for="Credential" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-brand w-100 btn-lg">
                    @Loc.T("Log_In_3")
                </button>
            </form>

            <div class="auth-footnote text-center">
                <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                @Loc.T("The_System_Recognizes_Your_Role_Automatically")
            </div>
        }
    </div>
</div>

<style>
    .auth-wrap {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: min(78vh, 820px);
        padding: 28px 16px;
        background: radial-gradient(circle at top, rgba(18, 67, 60, .08), transparent 55%);
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        padding: clamp(24px, 5vw, 42px);
        border: 1px solid rgba(100, 116, 139, .16);
        border-radius: 22px;
        background: var(--bs-body-bg, #fff);
        box-shadow: 0 18px 55px rgba(15, 23, 42, .10);
    }

    .auth-brand { margin-bottom: 30px; }
    .auth-brand-icon { font-size: 42px; line-height: 1.3; }
    .auth-brand h1 { margin: 10px 0 6px; color: #12433C; font-size: 22px; font-weight: 800; }
    .auth-brand p { margin: 0; color: var(--bs-secondary-color, #6c757d); font-size: 14px; }
    .field { margin-bottom: 20px; }
    .field label { display: block; margin-bottom: 8px; font-size: 13px; font-weight: 700; }
    .field .form-control { min-height: 52px; border-radius: 12px; }
    .auth-code-input {
        text-align: center;
        direction: ltr;
        letter-spacing: .32em;
        font-size: 24px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }
    .auth-security-note {
        display: flex;
        gap: 13px;
        align-items: flex-start;
        margin-bottom: 24px;
        padding: 15px;
        border: 1px solid rgba(13, 110, 253, .16);
        border-radius: 14px;
        background: rgba(13, 110, 253, .055);
    }
    .auth-security-note > i { color: #0d6efd; font-size: 21px; }
    .auth-security-note strong, .auth-security-note span { display: block; }
    .auth-security-note strong { margin-bottom: 3px; font-size: 14px; }
    .auth-security-note span { color: var(--bs-secondary-color, #6c757d); font-size: 12px; line-height: 1.6; }
    .auth-card .btn-brand { min-height: 52px; border-radius: 12px; font-weight: 700; }
    .auth-footnote { margin-top: 26px; color: var(--bs-secondary-color, #6c757d); font-size: 12px; }
</style>
