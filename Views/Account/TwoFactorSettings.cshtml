@{ ViewData["Title"] = "Two-factor authentication"; var enabled = ViewBag.Enabled is bool value && value; }
<div class="container py-4" style="max-width:680px">
 <h2>Two-factor authentication</h2>
 <p>Protect administrator sign-ins with a time-based code from an authenticator app.</p>
 @if(enabled){
  <div class="alert alert-success">Two-factor authentication is enabled for this account.</div>
  <form asp-action="DisableTwoFactor" method="post" class="card card-body">
   @Html.AntiForgeryToken()
   <label class="form-label">Authenticator code or recovery code</label>
   <input name="Code" class="form-control" required autocomplete="one-time-code" />
   <button class="btn btn-outline-danger mt-3" type="submit">Disable two-factor authentication</button>
  </form>
 } else {
  <div class="alert alert-warning">Two-factor authentication is currently disabled.</div>
  <form asp-action="BeginTwoFactorSetup" method="post">
   @Html.AntiForgeryToken()
   <button class="btn btn-primary" type="submit">Set up authenticator app</button>
  </form>
 }
</div>