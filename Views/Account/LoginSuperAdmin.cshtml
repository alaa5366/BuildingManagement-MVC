@model SuperAdminLoginVm
@{ ViewData["Title"] = Loc.T("Super_Admin_Login"); }

<div class="auth-wrap">
    <div class="auth-card">
        <a asp-action="LoginChoice" class="small">@Loc.T("Back")</a>
        <h2>@Loc.T("Super_Admin_Login")</h2>
        <p class="sub">@Loc.T("With_Email_And_Password")</p>

        <form asp-action="LoginSuperAdmin" method="post">
            <div class="mb-3">
                <label class="form-label">@Loc.T("Email")</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label">@Loc.T("Password")</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }

            <button type="submit" class="btn btn-brand w-100">@Loc.T("Log_In")</button>
        </form>
    </div>
</div>
