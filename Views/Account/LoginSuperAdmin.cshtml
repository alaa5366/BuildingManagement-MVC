@model SuperAdminLoginVm
@{ ViewData["Title"] = "دخول Super Admin"; }

<div class="auth-wrap">
    <div class="auth-card">
        <a asp-action="LoginChoice" class="small">← رجوع</a>
        <h2>دخول Super Admin</h2>
        <p class="sub">بالبريد الإلكتروني وكلمة المرور</p>

        <form asp-action="LoginSuperAdmin" method="post">
            <div class="mb-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label">كلمة المرور</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }

            <button type="submit" class="btn btn-brand w-100">دخول</button>
        </form>
    </div>
</div>
