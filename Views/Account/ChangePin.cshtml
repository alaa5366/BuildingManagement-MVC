@model BuildingManagementMvc.Models.ResidentPinChangeVm
@{
    ViewData["Title"] = Loc.T("Resident_Change_PIN");
}
<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-brand text-center">
            <div class="auth-brand-icon" aria-hidden="true">🔐</div>
            <h1>@Loc.T("Resident_Change_PIN")</h1>
            <p>@Loc.T("Temporary_PIN_Replace_Notice")</p>
        </div>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
        }
        <form method="post" asp-action="ChangePin" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="field">
                <label asp-for="NewPin">@Loc.T("New_PIN")</label>
                <input asp-for="NewPin" class="form-control form-control-lg"
                       type="password" inputmode="numeric" pattern="[0-9]{4,12}"
                       minlength="4" maxlength="12" autocomplete="new-password" autofocus />
                <span asp-validation-for="NewPin" class="text-danger small"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmNewPin">@Loc.T("Confirm_New_PIN")</label>
                <input asp-for="ConfirmNewPin" class="form-control form-control-lg"
                       type="password" inputmode="numeric" pattern="[0-9]{4,12}"
                       minlength="4" maxlength="12" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPin" class="text-danger small"></span>
            </div>
            <p class="text-muted small">@Loc.T("PIN_4_12_Digits") @Loc.T("Temporary_PIN_1234_Not_Allowed")</p>
            <button type="submit" class="btn btn-brand w-100 btn-lg">@Loc.T("Save_New_PIN")</button>
        </form>
    </div>
</div>
<style>
    .auth-wrap{display:flex;justify-content:center;align-items:center;min-height:min(78vh,820px);padding:28px 16px}
    .auth-card{width:100%;max-width:460px;padding:clamp(24px,5vw,42px);border:1px solid rgba(100,116,139,.16);border-radius:22px;background:var(--bs-body-bg,#fff);box-shadow:0 18px 55px rgba(15,23,42,.10)}
    .auth-brand{margin-bottom:30px}.auth-brand-icon{font-size:42px;line-height:1.3}.auth-brand h1{margin:10px 0 6px;color:#12433C;font-size:22px;font-weight:800}.auth-brand p{margin:0;color:var(--bs-secondary-color,#6c757d);font-size:14px}
    .field{margin-bottom:20px}.field label{display:block;margin-bottom:8px;font-size:13px;font-weight:700}.field .form-control{min-height:52px;border-radius:12px;letter-spacing:.2em;text-align:center}
    .auth-card .btn-brand{min-height:52px;border-radius:12px;font-weight:700}
</style>
