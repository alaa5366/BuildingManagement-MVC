@{
    ViewData["Title"] = Loc.T("Set_Pin_Title");
    var done = ViewBag.Done == true;
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div style="font-size: 60px;">🔑</div>
        <h2 class="mt-3">@Loc.T("Set_Pin_Title")</h2>

        @if (done)
        {
            <p class="mt-3">@Loc.T("Set_Pin_Done")</p>
            <a class="btn btn-brand mt-3" asp-action="UnifiedLogin">@Loc.T("Log_In")</a>
        }
        else
        {
            <p class="text-muted">@ViewBag.BuildingName — @Loc.T("Apartment") @ViewBag.AptNumber</p>
            <p class="text-muted">@Loc.T("Set_Pin_Intro")</p>

            @if (ViewBag.FormError != null)
            {
                <div class="alert alert-danger">@ViewBag.FormError</div>
            }

            <form method="post" asp-action="SetPin" autocomplete="off">
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div class="mb-3 text-start">
                    <label class="form-label">@Loc.T("New_PIN")</label>
                    <input name="newPin" type="password" maxlength="4" inputmode="numeric"
                           pattern="\d{4}" required class="form-control form-control-lg" autocomplete="new-password" />
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label">@Loc.T("Confirm_New_PIN")</label>
                    <input name="confirmPin" type="password" maxlength="4" inputmode="numeric"
                           pattern="\d{4}" required class="form-control form-control-lg" autocomplete="new-password" />
                </div>

                <button type="submit" class="btn btn-brand mt-2">@Loc.T("Save")</button>
            </form>
        }
    </div>
</div>
