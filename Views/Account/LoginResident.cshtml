@model ResidentLoginVm
@{
    ViewData["Title"] = Loc.T("Resident_Login");
    var buildings = ViewBag.Buildings as List<Building> ?? new();
}

<div class="auth-wrap">
    <div class="auth-card">
        <a asp-action="LoginChoice" class="link-btn back-link">@Loc.T("Back")</a>
        <h2>@Loc.T("Resident_Login")</h2>
        <p class="sub">@Loc.T("Choose_The_Building_And_Enter_Your")</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="LoginResident">
            @Html.AntiForgeryToken()

            @* ═══════════════════════════════════════════════════════ *@
            @* Building                                                    *@
            @* ═══════════════════════════════════════════════════════ *@
            <div class="field">
                <label>@Loc.T("Building")</label>
                <select name="BuildingId" id="bldSelect" class="form-select" required>
                    <option value="">— @Loc.T("Select") —</option>
                    @foreach (var b in buildings)
                    {
                        <option value="@b.Id">@b.BuildingNumber — @b.Name</option>
                    }
                </select>
            </div>

            @* ═══════════════════════════════════════════════════════ *@
            @* Floor (AJAX)                                                *@
            @* ═══════════════════════════════════════════════════════ *@
            <div class="field">
                <label>@Loc.T("Floor_Number")</label>
                <select name="FloorId" id="floorSelect" class="form-select" required disabled>
                    <option value="">— @Loc.T("Choose_Building_First") —</option>
                </select>
            </div>

            @* ═══════════════════════════════════════════════════════ *@
            @* Apartment (AJAX)                                            *@
            @* ═══════════════════════════════════════════════════════ *@
            <div class="field">
                <label>@Loc.T("Apartment_Number")</label>
                <select name="AptId" id="aptSelect" class="form-select" required disabled>
                    <option value="">— @Loc.T("Choose_Floor_First") —</option>
                </select>
            </div>

            @* ═══════════════════════════════════════════════════════ *@
            @* WhatsApp                                                    *@
            @* ═══════════════════════════════════════════════════════ *@
            <div class="field">
                <label>@Loc.T("WhatsApp_Number")</label>
                <input name="Whatsapp" type="tel" class="form-control"
                       placeholder="+201001234567" required dir="ltr" />
            </div>

            @* ═══════════════════════════════════════════════════════ *@
            @* PIN                                                         *@
            @* ═══════════════════════════════════════════════════════ *@
            <div class="field">
                <label>PIN</label>
                <input name="Pin" type="password" class="form-control"
                       required maxlength="4" inputmode="numeric" />
            </div>

            <button type="submit" class="btn btn-brand w-100">@Loc.T("Log_In")</button>
        </form>
    </div>
</div>

<style>
    .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 40px 20px;
    }

    .auth-card {
        background: white;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 480px;
    }

        .auth-card h2 {
            margin-bottom: 8px;
            color: #12433C;
            font-weight: 700;
        }

        .auth-card .sub {
            color: #666;
            font-size: 13px;
            margin-bottom: 24px;
        }

    .field {
        margin-bottom: 18px;
    }

        .field label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 6px;
        }

    .back-link {
        display: inline-block;
        margin-bottom: 16px;
        color: #12433C;
        text-decoration: none;
        font-size: 13px;
    }

    .link-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const bldSelect = document.getElementById('bldSelect');
            const floorSelect = document.getElementById('floorSelect');
            const aptSelect = document.getElementById('aptSelect');

            // ═══════════════════════════════════════════════════════
            // Building change → جيب الأدوار
            // ═══════════════════════════════════════════════════════
            bldSelect.addEventListener('change', async function() {
                const bldId = this.value;

                // Reset
                floorSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("Choose_Floor_First")) —</option>';
                aptSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("Choose_Floor_First")) —</option>';
                floorSelect.disabled = true;
                aptSelect.disabled = true;

                if (!bldId) {
                    floorSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("Choose_Building_First")) —</option>';
                    return;
                }

                floorSelect.innerHTML = '<option value="">@Html.Raw(Loc.Js("Loading"))</option>';

                try {
                    const res = await fetch(`/Account/GetFloors?buildingId=${encodeURIComponent(bldId)}`);
                    const floors = await res.json();

                    if (floors.length === 0) {
                        floorSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("No_Floors")) —</option>';
                        return;
                    }

                    floorSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("Select")) —</option>';
                    floors.forEach(f => {
                        const opt = document.createElement('option');
                        opt.value = f.id;
                        opt.textContent = f.label;
                        floorSelect.appendChild(opt);
                    });

                    floorSelect.disabled = false;
                } catch (err) {
                    console.error(err);
                    floorSelect.innerHTML = '<option value="">— Error —</option>';
                }
            });

            // ═══════════════════════════════════════════════════════
            // Floor change → جيب الشقق
            // ═══════════════════════════════════════════════════════
            floorSelect.addEventListener('change', async function() {
                const bldId = bldSelect.value;
                const floorId = this.value;

                aptSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("Choose_Floor_First")) —</option>';
                aptSelect.disabled = true;

                if (!bldId || !floorId) return;

                aptSelect.innerHTML = '<option value="">@Html.Raw(Loc.Js("Loading"))</option>';

                try {
                    const res = await fetch(`/Account/GetApartments?buildingId=${encodeURIComponent(bldId)}&floorId=${encodeURIComponent(floorId)}`);
                    const apts = await res.json();

                    if (apts.length === 0) {
                        aptSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("No_Apartments")) —</option>';
                        return;
                    }

                    aptSelect.innerHTML = '<option value="">— @Html.Raw(Loc.Js("Select")) —</option>';
                    apts.forEach(a => {
                        const opt = document.createElement('option');
                        opt.value = a.id;
                        opt.textContent = a.label;
                        aptSelect.appendChild(opt);
                    });

                    aptSelect.disabled = false;
                } catch (err) {
                    console.error(err);
                    aptSelect.innerHTML = '<option value="">— Error —</option>';
                }
            });
        });
    </script>
}