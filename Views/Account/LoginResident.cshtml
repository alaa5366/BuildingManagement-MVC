@model ResidentLoginVm
@{
    ViewData["Title"] = Loc.T("Resident_Login");
    var buildings = (List<Building>)ViewBag.Buildings;

    // ✅ QR data
    var qrBuildingId = ViewBag.QrBuildingId as string;
    var qrBuildingName = ViewBag.QrBuildingName as string;
    var qrFloorOrder = ViewBag.QrFloorOrder as int?;
    var qrFloorLabel = ViewBag.QrFloorLabel as string;
    var qrAptNumber = ViewBag.QrAptNumber as int?;
    var qrAptLabel = ViewBag.QrAptLabel as string;
    var hasQr = !string.IsNullOrEmpty(qrBuildingId);
}

<div class="auth-wrap">
    <div class="auth-card">
        <a asp-action="LoginChoice" class="link-btn back-link">@Loc.T("Back")</a>
        <h2>@Loc.T("Resident_Login")</h2>
        <p class="sub">@Loc.T("Choose_The_Building_Floor_And_Apartment")</p>

        @if (hasQr)
        {
            <div class="alert alert-success">
                <strong>@Loc.T("Your_Apartment_Was_Detected_Automatically")</strong>
                <div class="small mt-2">
                    <div>🏢 <strong>@qrBuildingName</strong></div>
                    <div>🏠 <strong>@Loc.T("N_Apartment_N", qrFloorLabel, qrAptNumber)</strong></div>
                    @if (!string.IsNullOrEmpty(qrAptLabel))
                    {
                        <div class="text-muted">@qrAptLabel</div>
                    }
                </div>
                <div class="small mt-2 text-muted">
                    @Loc.T("Just_Enter_Your_WhatsApp_Number_And")
                </div>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="LoginResident">
            @Html.AntiForgeryToken()

            <div class="field">
                <label>@Loc.T("Building")</label>
                <select name="BuildingId" id="bldSelect" class="form-select" required>
                    <option value="">@Loc.T("Select")</option>
                    @foreach (var b in buildings)
                    {
                        <option value="@b.Id"
                                data-qr="@(hasQr && b.Id == qrBuildingId ? "true" : "false")"
                                selected="@(hasQr && b.Id == qrBuildingId)">
                            @b.BuildingNumber — @b.Name
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label>@Loc.T("Floor_Number")</label>
                <input name="FloorOrder" id="floorInput" type="number" class="form-control"
                       value="@(hasQr ? qrFloorOrder : null)"
                       readonly="@(hasQr)" required />
                @if (hasQr)
                {
                    <div class="form-text">✅ @qrFloorLabel</div>
                }
            </div>

            <div class="field">
                <label>@Loc.T("Apartment_Number")</label>
                <input name="AptNumber" id="aptInput" type="number" class="form-control"
                       value="@(hasQr ? qrAptNumber : null)"
                       readonly="@(hasQr)" required />
                @if (hasQr && !string.IsNullOrEmpty(qrAptLabel))
                {
                    <div class="form-text">✅ @qrAptLabel</div>
                }
            </div>

            <div class="field">
                <label>@Loc.T("WhatsApp_Number")</label>
                <input name="Whatsapp" id="waInput" type="tel" class="form-control"
                       placeholder="+201001234567" required autofocus="@hasQr" />
            </div>

            <div class="field">
                <label>PIN</label>
                <input name="Pin" type="password" class="form-control" required maxlength="4" />
            </div>

            <button type="submit" class="btn btn-brand w-100">@Loc.T("Log_In")</button>
        </form>
    </div>
</div>

<style>
    .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 40px 20px;
    }

    .auth-card {
        background: white;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 480px;
    }

        .auth-card h2 {
            margin-bottom: 8px;
            color: #12433C;
            font-weight: 700;
        }

        .auth-card .sub {
            color: #666;
            font-size: 13px;
            margin-bottom: 24px;
        }

    .field {
        margin-bottom: 18px;
    }

        .field label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 6px;
            color: #333;
        }

    .back-link {
        display: inline-block;
        margin-bottom: 16px;
        color: #12433C;
        text-decoration: none;
        font-size: 13px;
    }

    .link-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }
</style>