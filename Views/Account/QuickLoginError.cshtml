@{
    ViewData["Title"] = Loc.T("Login_Error");
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div style="font-size: 60px;">❌</div>
        <h2 class="text-danger mt-3">@Loc.T("Could_Not_Log_In")</h2>
        <p class="text-muted">@ViewBag.Error</p>
        <a asp-action="UnifiedLogin" class="btn btn-brand mt-3">@Loc.T("Regular_Login")</a>
    </div>
</div>@*
