@using System.Security.Claims
@{
    var isImpersonating = User.HasClaim("impersonated", "true");
    var impersonatedBy = User.FindFirst("impersonatedBy")?.Value ?? "SuperAdmin";
}

@if (isImpersonating)
{
    <div class="impersonation-banner" style="background: linear-gradient(90deg, #A0432A 0%, #C5563A 100%); color: #fff; padding: 10px 0; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
        <div class="container-fluid d-flex justify-content-between align-items-center px-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge" style="font-size: 20px;"></i>
                <div>
                    <strong>🔴 @Loc.T("You_Are_In_Impersonation_Mode")</strong>
                    <div class="small" style="opacity: 0.9;">
                        @Loc.T("Impersonation_Browsing_As") <strong>@User.FindFirst(ClaimTypes.Name)?.Value</strong>
                        @Loc.T("Impersonation_Original_Admin") <strong>@impersonatedBy</strong>
                    </div>
                </div>
            </div>
            <form asp-controller="Impersonation" asp-action="Exit" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-light btn-sm fw-bold">
                    <i class="bi bi-box-arrow-left"></i>
                    @Loc.T("Back_To_My_Account")
                </button>
            </form>
        </div>
    </div>
}