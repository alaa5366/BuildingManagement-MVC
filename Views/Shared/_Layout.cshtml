@using Microsoft.Extensions.Localization
@inject IStringLocalizerFactory LocalizerFactory
@{
    var Localizer = LocalizerFactory.Create("Shared", "BuildingManagementMvc");
}
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture == "ar";
    var dir = isRtl ? "rtl" : "ltr";
    var htmlLang = isRtl ? "ar" : "en";
    var bootstrapCss = isRtl
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Localizer["App_Name"]</title>
    <link href="@bootstrapCss" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />

    @* ✅ PWA *@
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#12433C" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@Localizer["App_ShortName"]" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                🏢 @Localizer["App_Name"]
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @if (User.IsInRole("superadmin"))
                    {
                        <a class="nav-link text-white-50" asp-controller="SuperAdminHome" asp-action="Index">@Localizer["Nav_Buildings"]</a>
                        <a class="nav-link text-white-50" asp-controller="Admins" asp-action="Index">@Localizer["Nav_Admins"]</a>
                        <a class="nav-link text-white-50" asp-controller="Tools" asp-action="Index">@Localizer["Nav_Tools"]</a>
                        <a class="nav-link text-white-50" asp-controller="Sync" asp-action="Index">@Localizer["Nav_Sync"]</a>
                        <a class="nav-link text-white-50" asp-controller="Backup" asp-action="Index">@Localizer["Nav_Backup"]</a>
                        <a class="nav-link text-white-50" asp-controller="Permissions" asp-action="Index">@Localizer["Nav_Permissions"]</a>
                        <a class="nav-link text-white-50" asp-controller="Categories" asp-action="Index">@Localizer["Nav_Categories"]</a>
                        <a class="nav-link text-white-50" asp-controller="AuditLog" asp-action="Index">@Localizer["Nav_AuditLog"]</a>
                        <a class="nav-link text-white-50" asp-controller="Settings" asp-action="Index">⚙️ @Localizer["Nav_Settings"]</a>
                    }
                    @if (User.IsInRole("admin"))
                    {
                        <a class="nav-link text-white-50" asp-controller="AdminHome" asp-action="Index">@Localizer["Nav_Home"]</a>
                        <a class="nav-link text-white-50" asp-controller="Wallet" asp-action="Index">@Localizer["Nav_Wallet"]</a>
                        <a class="nav-link text-white-50" asp-controller="Expenses" asp-action="Index">@Localizer["Nav_Expenses"]</a>
                        <a class="nav-link text-white-50" asp-controller="Revenues" asp-action="Index">@Localizer["Nav_Revenues"]</a>
                        <a class="nav-link text-white-50" asp-controller="Categories" asp-action="Index">@Localizer["Nav_Categories"]</a>
                        <a class="nav-link text-white-50" asp-controller="Polls" asp-action="Index">@Localizer["Nav_Polls"]</a>
                        <a class="nav-link text-white-50" asp-controller="Maintenance" asp-action="Index">@Localizer["Nav_Maintenance"]</a>
                        <a class="nav-link text-white-50" asp-controller="Notifications" asp-action="Index">@Localizer["Nav_Notifications"]</a>
                        <a class="nav-link text-white-50" asp-controller="WhatsApp" asp-action="Index">@Localizer["Nav_WhatsApp"]</a>
                        <a class="nav-link text-white-50" asp-controller="AuditLog" asp-action="Index">@Localizer["Nav_AuditLog"]</a>
                        <a class="nav-link text-white-50" asp-controller="Settings" asp-action="Building">⚙️ @Localizer["Nav_Settings"]</a>
                        <a class="nav-link text-white-50" asp-controller="Settings" asp-action="Own">👤 @Localizer["Nav_MySettings"]</a>
                        <a class="nav-link text-white-50" asp-controller="Help" asp-action="Index">📖 @Localizer["Nav_Help"]</a>
                    }
                    @if (User.IsInRole("resident"))
                    {
                        <a class="nav-link text-white-50" asp-controller="ResidentHome" asp-action="Index">@Localizer["Nav_Home"]</a>
                        <a class="nav-link text-white-50" asp-controller="ResidentWallet" asp-action="Index">@Localizer["Nav_MyWallet"]</a>
                        <a class="nav-link text-white-50" asp-controller="ResidentPolls" asp-action="Index">@Localizer["Nav_Polls"]</a>
                        <a class="nav-link text-white-50" asp-controller="ResidentMaintenance" asp-action="Index">@Localizer["Nav_Maintenance"]</a>
                        <a class="nav-link text-white-50" asp-controller="Notifications" asp-action="Index">@Localizer["Nav_Notifications"]</a>
                        <a class="nav-link text-white-50" asp-controller="AuditLog" asp-action="Index">@Localizer["Nav_MyLog"]</a>
                        <a class="nav-link text-white-50" asp-controller="Settings" asp-action="Own">⚙️ @Localizer["Nav_Settings"]</a>
                        <a class="nav-link text-white-50" asp-controller="Help" asp-action="Index">📖 @Localizer["Nav_Help"]</a>
                    }

                    @* ✅ Language Switcher *@
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            🌐 @(isRtl ? "العربية" : "English")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/Language/Set?lang=ar&returnUrl=@Uri.EscapeDataString(returnUrl)">
                                    🇪🇬 العربية
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Language/Set?lang=en&returnUrl=@Uri.EscapeDataString(returnUrl)">
                                    🇬🇧 English
                                </a>
                            </li>
                        </ul>
                    </div>

                    <span class="text-white-50 small">
                        @User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                    </span>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">@Localizer["Nav_Logout"]</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-4">
        @Localizer["Footer_Copyright"]
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @* ✅ PWA *@
    <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js')
                        .then(reg => console.log('[PWA] Service Worker registered:', reg.scope))
                        .catch(err => console.warn('[PWA] Service Worker registration failed:', err));
                });
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>