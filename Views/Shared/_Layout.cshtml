<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - نظام إدارة العمارات</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏢 إدارة العمارات</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @if (User.IsInRole("superadmin"))
                    {
                        <a class="nav-link text-white-50" asp-controller="SuperAdminHome" asp-action="Index">العمارات</a>
                    }
                    @if (User.IsInRole("admin"))
                    {
                        <a class="nav-link text-white-50" asp-controller="AdminHome" asp-action="Index">الرئيسية</a>
                        <a class="nav-link text-white-50" asp-controller="Wallet" asp-action="Index">المحفظة</a>
                        <a class="nav-link text-white-50" asp-controller="Expenses" asp-action="Index">المصروفات</a>
                        <a class="nav-link text-white-50" asp-controller="Revenues" asp-action="Index">الإيرادات</a>
                    }
                    @if (User.IsInRole("resident"))
                    {
                        <a class="nav-link text-white-50" asp-controller="ResidentHome" asp-action="Index">الرئيسية</a>
                        <a class="nav-link text-white-50" asp-controller="ResidentWallet" asp-action="Index">محفظتي</a>
                    }
                    <span class="text-white-50 small">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">تسجيل الخروج</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-4">
        نظام إدارة العمارات — نسخة C# MVC (مرحلة 1: الهيكل الأساسي)
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
