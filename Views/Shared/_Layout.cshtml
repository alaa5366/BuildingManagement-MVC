@using Microsoft.AspNetCore.Localization
@{
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture?.UICulture?.Name ?? "ar";
    var isRtl = currentCulture == "ar";
    var dir = isRtl ? "rtl" : "ltr";

    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var isAuth = User.Identity?.IsAuthenticated == true;
    var showSidebar = isAuth && !string.IsNullOrEmpty(role);
    var isImpersonating = User.HasClaim("impersonated", "true");
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @Loc.T("App_Name")</title>

    @* ===== Fonts ===== *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">

    @* ===== Bootstrap ===== *@
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />

    @* ===== Bootstrap Icons (CDN مؤقت) ===== *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @* ===== App CSS ===== *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (showSidebar)
    {
        <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isRtl ? "rtl" : "ltr") @(showSidebar ? "has-sidebar" : "no-sidebar")">

    @if (showSidebar)
    {
        @* ===== Sidebar ===== *@
        <partial name="_Sidebar" />

        @* ===== Topbar (Mobile + User Menu) ===== *@
        <partial name="_Topbar" />

        @* ===== Main Content ===== *@
        <main class="main-content" id="mainContent">
            @if (isImpersonating)
            {
                <div class="impersonation-banner">
                    <div class="container-fluid d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-person-badge"></i>
                            <strong>@Loc.T("You_Are_In_Impersonation_Mode")</strong>
                            @Loc.T("Browsing_As") <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</strong>
                        </div>
                        <form asp-controller="Impersonation" asp-action="Exit" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-light btn-sm">
                                <i class="bi bi-box-arrow-left"></i>
                                @Loc.T("Back_To_My_Account_Admin")
                            </button>
                        </form>
                    </div>
                </div>
            }

            @* ===== Alerts ===== *@
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mx-3 mt-3" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* ===== Page Content ===== *@
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>
    }
    else
    {
        @* ===== No Sidebar (Login Pages) ===== *@
        <main class="auth-content">
            @RenderBody()
        </main>
    }

    @* ===== Scripts ===== *@
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (showSidebar)
    {
        <script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>