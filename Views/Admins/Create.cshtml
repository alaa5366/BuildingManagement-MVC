@{
    ViewData["Title"] = Loc.T("Add_Admin");
    var buildings = ViewBag.Buildings as List<BuildingManagementMvc.Models.Building> ?? new();
    var allPerms = ViewBag.AllPermissions as List<string> ?? new();
}

<div class="container">
    <h2>@Loc.T("Add_Admin_2")</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">@Loc.T("Name")</label>
            <input name="name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">@Loc.T("Mobile_Number")</label>
            <input name="phone" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">@Loc.T("Building")</label>
            <select name="buildingId" class="form-select" required>
                <option value="">@Loc.T("Select_2")</option>
                @foreach (var b in buildings)
                {
                    <option value="@b.Id">@b.Name (@b.BuildingNumber)</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">PIN</label>
            <input name="pin" type="password" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">@Loc.T("Permissions")</label>
            <div class="row">
                @foreach (var p in allPerms)
                {
                    <div class="col-md-4">
                        <label>
                            <input type="checkbox" name="permissions" value="@p" /> @BuildingManagementMvc.Models.AdminPermissions.LabelAr(p)
                        </label>
                    </div>
                }
            </div>
        </div>

        <button class="btn btn-primary">@Loc.T("Save")</button>
        <a asp-action="Index" class="btn btn-secondary">@Loc.T("Cancel")</a>
    </form>
</div>