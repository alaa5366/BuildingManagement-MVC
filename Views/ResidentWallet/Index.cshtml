@{
    ViewData["Title"] = Loc.T("My_Wallet_4");
    var building = (Building)ViewBag.Building;
    var apt = (Apartment)ViewBag.Apartment;
    string month = ViewBag.Month;
    double balance = ViewBag.Balance;
    var transactions = (BuildingManagementMvc.Models.PagedResult<BuildingManagementMvc.Models.WalletTransactionVm>)ViewBag.Transactions;
    var pendingDeposits = (BuildingManagementMvc.Models.PagedResult<BuildingManagementMvc.Models.Deposit>)ViewBag.PendingDeposits;
    var routeValues = ViewBag.RouteValues as Dictionary<string, string?> ?? new();
    var routeValuesStr = new Dictionary<string, string>();
    foreach (var kv in routeValues)
        if (!string.IsNullOrWhiteSpace(kv.Value))
            routeValuesStr[kv.Key] = kv.Value!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@Loc.T("My_Wallet_Apartment_N_N", apt.Number, building.Name)</h3>
    <form method="get" class="d-flex gap-2">
        <input type="hidden" name="pageSize" value="@transactions.PageSize" />
        <input type="month" name="month" value="@month" class="form-control" onchange="this.form.submit()" />
    </form>
</div>

<div class="bg-white rounded shadow-sm p-4 mb-3 text-center">
    <div class="text-muted small">@Loc.T("Your_Current_Balance")</div>
    <div class="display-6 fw-bold @(balance < 0 ? "text-danger" : "text-success")">@Loc.T("N_EGP", balance.ToString("0.##"))</div>
    @if (balance < 0)
    {
        <div class="text-danger small">@Loc.T("You_Have_An_Amount_Due")</div>
    }
    <a asp-controller="Invoice" asp-action="Download" asp-route-month="@month" class="btn btn-sm btn-outline-primary mt-2">@Loc.T("Download_PDF_Invoice")</a>
</div>

<div class="bg-white rounded shadow-sm p-3 mb-3">
    <h5>@Loc.T("Submit_A_New_Payment_2")</h5>
    <p class="text-muted small">@Loc.T("It_Will_Be_Set_To_Pending")</p>

    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <div>
            <strong>@Loc.T("Do_You_Have_The_Transfer_Image")</strong>
            <div class="small text-muted">@Loc.T("Upload_It_And_We_Ll_Read")</div>
        </div>
        <button type="button" class="btn btn-brand" onclick="document.getElementById('receiptFile').click()">
            @Loc.T("Read_From_Image")
        </button>
        <input type="file" id="receiptFile" accept="image/*" style="display:none" onchange="handleReceiptUpload(this)" />
    </div>

    <div id="ocrStatus" class="alert alert-secondary" style="display:none"></div>
    <div id="ocrResult" class="alert alert-success" style="display:none">
        <strong>@Loc.T("Image_Read_Successfully")</strong>
        <div id="ocrDetails" class="small mt-2"></div>
    </div>
    <div id="ocrError" class="alert alert-danger" style="display:none"></div>

    <form method="post" asp-action="CreateDeposit" enctype="multipart/form-data"
          class="row g-2 align-items-end" id="depositForm">
        <input type="hidden" name="month" value="@month" />

        <div class="col-md-4">
            <label class="form-label small">@Loc.T("Amount")</label>
            <input name="amount" id="amountInput" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="col-md-5">
            <label class="form-label small">@Loc.T("Note")</label>
            <input name="note" id="noteInput" class="form-control" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-brand w-100">@Loc.T("Submit")</button>
        </div>

        <input type="file" name="receiptImage" id="receiptFileInput" accept="image/*" style="display:none" />
    </form>
</div>

@if (pendingDeposits.TotalItems > 0)
{
    <div class="alert alert-warning">
        @Loc.T("You_Have_N_Payment_S_Awaiting", pendingDeposits.TotalItems)
    </div>
}

<div class="bg-white rounded shadow-sm p-3">
    <h5>@Loc.T("Account_Statement_N", transactions.TotalItems)</h5>

    @* ✅ Pagination (فوق) *@
    @{
        ViewData["CurrentPage"] = transactions.CurrentPage;
        ViewData["PageSize"] = transactions.PageSize;
        ViewData["TotalItems"] = transactions.TotalItems;
        ViewData["TotalPages"] = transactions.TotalPages;
        ViewData["HasPrevious"] = transactions.HasPrevious;
        ViewData["HasNext"] = transactions.HasNext;
        ViewData["FirstItemIndex"] = transactions.FirstItemIndex;
        ViewData["LastItemIndex"] = transactions.LastItemIndex;
        ViewData["ActionName"] = "Index";
        ViewData["ControllerName"] = "ResidentWallet";
        ViewData["RouteValues"] = routeValuesStr;
        ViewData["PageSizeOptions"] = new[] { 10, 25, 50, 100 };
    }
    @await Html.PartialAsync("_Pagination")

    @if (transactions.Items.Count == 0)
    {
        <div class="alert alert-info">@Loc.T("No_Transactions_For_This_Month")</div>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Loc.T("Date")</th>
                    <th>@Loc.T("Description_2")</th>
                    <th>@Loc.T("Amount")</th>
                    <th>@Loc.T("Status")</th>
                    <th>@Loc.T("Receipt")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in transactions.Items)
                {
                    var label = tx.Type switch
                    {
                        "deposit" => Loc.T("Payment") + tx.Number,
                        "expense" => Loc.T("Share_Of_Expenses"),
                        "revenue" => Loc.T("Share_Of_Revenues"),
                        "monthly_fee_due" => Loc.T("Monthly_Fee_Due"),
                        "monthly_fee_credit" => Loc.T("Increase_In_The_Monthly_Fee"),
                        "adjustment" => Loc.T("Adjustment") + tx.Note,
                        _ => tx.Note
                    };

                    <tr>
                        <td>@tx.CreatedAt.Substring(0, Math.Min(10, tx.CreatedAt.Length))</td>
                        <td>@label</td>
                        <td class="@(tx.Amount < 0 ? "text-danger" : "text-success")">@tx.Amount.ToString("0.##")</td>
                        <td>@(tx.Status == "pending" ? Loc.T("Pending") : tx.Status == "cancelled" ? Loc.T("Cancelled") : Loc.T("Confirmed"))</td>
                        <td>
                            @* ✅ هنا الإيصال مش متاح مباشرة لأننا في PagedResult — يقدر المستخدم يشوف في صفحة الدفعات *@
                            @if (tx.Type == "deposit")
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ✅ Pagination (تحت) *@
    @await Html.PartialAsync("_Pagination")
</div>

@section Scripts {
    <script>
        async function handleReceiptUpload(input) {
                    if (!input.files || input.files.length === 0) return;

                    const file = input.files[0];
                    const formData = new FormData();
                    formData.append('image', file);

                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) {
                        formData.append('__RequestVerificationToken', token.value);
                    }

                    document.getElementById('ocrStatus').style.display = 'block';
                    document.getElementById('ocrStatus').innerText = '⏳ @Html.Raw(Loc.Js("Reading_The_Image_May_Take_5"))';
                    document.getElementById('ocrResult').style.display = 'none';
                    document.getElementById('ocrError').style.display = 'none';

                    try {
                        const response = await fetch('@Url.Action("ParseReceiptImage", "ResidentWallet")', {
                            method: 'POST',
                            body: formData
                        });

                        document.getElementById('ocrStatus').style.display = 'none';
                        const text = await response.text();

                        if (!response.ok) {
                            console.error('Server error:', response.status, text);
                            throw new Error(`Server returned ${response.status}: ${text.substring(0, 200)}`);
                }

                        const data = JSON.parse(text);

                        if (data.success) {
                            document.getElementById('amountInput').value = data.amount;
                            document.getElementById('noteInput').value = data.note || '';

                            const fileInput = document.getElementById('receiptFileInput');
                            const dataTransfer = new DataTransfer();
                            dataTransfer.items.add(file);
                            fileInput.files = dataTransfer.files;

                            document.getElementById('ocrResult').style.display = 'block';
                            document.getElementById('ocrDetails').innerHTML = `
                                <div>💰 @Html.Raw(Loc.Js("Amount_2")) <strong>${data.amount}</strong> @Html.Raw(Loc.Js("EGP"))</div>
                                <div>🔢 @Html.Raw(Loc.Js("Reference")) ${data.reference || '—'}</div>
                                <div>📅 @Html.Raw(Loc.Js("Date_2")) ${data.date || '—'}</div>
                                <div>🏦 @Html.Raw(Loc.Js("Account")) ${data.recipientAccount || '—'}</div>
                                <div class="mt-2 text-success">✅ @Html.Raw(Loc.Js("The_Image_Will_Be_Uploaded_With"))</div>
                            `;
                        } else {
                            document.getElementById('ocrError').style.display = 'block';
                            document.getElementById('ocrError').innerText = '❌ ' + data.error;
                        }
                    } catch (err) {
                        document.getElementById('ocrStatus').style.display = 'none';
                        document.getElementById('ocrError').style.display = 'block';
                        document.getElementById('ocrError').innerText = '❌ @Html.Raw(Loc.Js("Error")) ' + err.message;
                    }

                    input.value = '';
                }
    </script>
}